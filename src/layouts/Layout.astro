---
import Header from "../components/Header.astro";
import "../styles/global.css";
import "../styles/tria-theme.css";
import { createT } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** For blog posts: ISO date string e.g. "2024-01-15" */
  pubDate?: string;
  /** For blog posts: ISO date string */
  modifiedDate?: string;
  /** Page-specific JSON-LD snippets to merge */
  structuredData?: Record<string, any>;
}

const locale = Astro.currentLocale || "en";
const t = createT(locale);

const {
  title = t("meta.title"),
  description = t("meta.description"),
  ogImage = "",
  pubDate = "",
  modifiedDate = "",
  structuredData,
} = Astro.props;

const siteUrl = "https://triacr.com";
const companyName = "Tria Software Solutions";
const twitterHandle = "@triacr";

const pathname = Astro.url.pathname;
const path = pathname.replace(/\/+$/, "") || "/";
const barePath = locale === "en" ? path : (path.replace(new RegExp(`^/${locale}`), "") || "/");
const enHref = barePath;
const esHref = `/es${barePath === "/" ? "" : barePath}`;

const ogLocales: Record<string, string> = { en: "en_US", es: "es_CR" };
const localePrefix = locale === "en" ? "" : `/${locale}`;
const canonicalUrl = `${siteUrl}${localePrefix}${barePath === "/" ? "" : barePath}`;
const metaTitle = title;
const ogImageUrl = ogImage ? (ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`) : "";

// ── Default OG image (1200×630) ──
const defaultOgImage = `${siteUrl}/assets/img/og/default.png`;
const resolvedOgImage = ogImageUrl || defaultOgImage;

// ── JSON-LD Structured Data ──
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: companyName,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: t("meta.description"),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Atenas",
    addressRegion: "Alajuela",
    addressCountry: "CR",
  },
  sameAs: [
    "https://linkedin.com/company/triacr",
    "https://github.com/Tria-Software-Solutions",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: companyName,
  url: canonicalUrl,
  description: t("meta.description"),
  inLanguage: locale,
};

const combinedStructured = structuredData
  ? [orgSchema, websiteSchema, structuredData]
  : [orgSchema, websiteSchema];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- Preconnect to Google Fonts origins (eliminates DNS/connection latency) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload the critical woff2 font file for the default weight (400) -->
    <link rel="preload" href="https://fonts.gstatic.com/s/outfit/v11/QGYvz_MVcBeNP4NJtEtqUYLknw.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0d17" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{metaTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang for multilingual -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enHref}`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/es${enHref === "/" ? "" : enHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${enHref}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:locale" content={ogLocales[locale] || "en_US"} />
    <meta property="og:site_name" content={companyName} />
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {pubDate && <meta property="article:author" content="Tria Software Solutions" />}
    {pubDate && <meta property="article:publisher" content="https://triacr.com" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(combinedStructured)}></script>

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Load critical grid CSS synchronously (needed for layout) -->
    <link rel="stylesheet" href="/assets/css/vendor/bootstrap-grid.css" />

    <!-- Defer non-critical CSS: swiper, tabler-icons, Google Fonts -->
    <link rel="preload" href="/assets/css/vendor/swiper.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="/assets/css/vendor/swiper.min.css" /></noscript>
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" /></noscript>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" /></noscript>

    <!-- Hide splash if already shown this session (runs before body renders) -->
    <script is:inline>
    (function() {
      if (sessionStorage.getItem('triaSplashShown')) {
        var s = document.createElement('style');
        s.textContent = '.tria-preloader { display: none !important; }';
        document.head.appendChild(s);
      }
    })();
    </script>
  </head>
  <body>
    <!-- Skip to main content -->
    <a href="#main-content" class="tria-skip-link" data-i18n="layout.skipToContent">
      {t("layout.skipToContent") || "Skip to main content"}
    </a>
    
    <!-- wrapper -->
    <div class="tria-wrapper" id="top">
      

      <Header />

      <!-- hidden source elements for JS cloning -->
      <div class="tria-hidden-elements">
        <span class="tria-arrow fa-arrow-right">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>

      <!-- preloader -->
      <div class="tria-preloader">
        <div class="tria-preloader-animation">
          <div class="tria-pos-abs tria-animation-1">
            <p class="tria-h3 tria-muted tria-thin" data-i18n="splash.design">{t("splash.design")}</p>
            <p class="tria-h3 tria-muted" data-i18n="splash.build">{t("splash.build")}</p>
            <p class="tria-h3 tria-muted tria-thin" data-i18n="splash.grow">{t("splash.grow")}</p>
          </div>
          <div class="tria-pos-abs tria-animation-2">
            <div class="tria-reveal-frame">
              <p class="tria-reveal-box"></p>
              <p class="tria-h3 tria-muted tria-thin">triacr.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- frame -->
      <div class="tria-frame">
        <div class="tria-frame-top">
          <a href="/" class="tria-logo"
            ><span data-i="0">t</span><span data-i="1">r</span><span data-i="2"
              >i</span
            ><span data-i="3">a</span><span data-i="4">.</span></a
          >
          <div class="tria-frame-top-right">
            <div class="tria-mobile-lang">
              <a href={enHref} data-lang="en" class:list={["tria-mobile-lang-btn", { "is-active": locale === "en" }]}>EN</a>
              <a href={esHref} data-lang="es" class:list={["tria-mobile-lang-btn", { "is-active": locale === "es" }]}>ES</a>
            </div>
            <div class="tria-menu-btn">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
        <div class="tria-frame-bottom">            <div class="tria-frame-bottom-left">
            <div class="tria-current-page"></div>
            <span class="tria-lang-divider"></span>
            <a href={enHref} data-lang="en" class:list={["tria-lang-btn", { "is-active": locale === "en" }]}>EN</a>
            <a href={esHref} data-lang="es" class:list={["tria-lang-btn", { "is-active": locale === "es" }]}>ES</a>
          </div>
          <div class="tria-back-to-top">
            <a href="#top" class="tria-link tria-dark">
              <span data-i18n="layout.backToTop">{t("layout.backToTop")}</span>
              <svg class="tria-btt-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <!-- frame end -->

      <!-- content -->
      <main class="tria-content" id="main-content">
        <div id="swup" class="transition-fade">
          <slot />
        </div>
      </main>
    </div>
    <!-- wrapper end -->

    <script is:inline>
      (function () {
        var frame = document.querySelector(".tria-frame");

        function getThemeAt(clientY) {
          var sections = document.querySelectorAll("[data-section-theme]");
          for (var i = 0; i < sections.length; i++) {
            var rect = sections[i].getBoundingClientRect();
            if (clientY >= rect.top && clientY < rect.bottom) {
              return sections[i].getAttribute("data-section-theme");
            }
          }
          return null;
        }

        function updateTextGradient(el, horizontal) {
          if (!el) return;
          var rect = el.getBoundingClientRect();
          var top = rect.top;
          var bottom = rect.bottom;
          var height = bottom - top;
          if (height <= 0) return;

          var sections = document.querySelectorAll(
            "[data-section-theme]",
          );
          var boundaryY;
          var aboveTheme;
          var belowTheme;

          for (var i = 0; i < sections.length - 1; i++) {
            var r = sections[i].getBoundingClientRect();
            var b = r.bottom;
            if (b > top && b < bottom) {
              var t1 = sections[i].getAttribute("data-section-theme");
              var t2 = sections[i + 1].getAttribute(
                "data-section-theme",
              );
              if (t1 !== t2) {
                boundaryY = b;
                aboveTheme = t1;
                belowTheme = t2;
                break;
              }
            }
          }

          var dir = horizontal ? "to bottom" : "to left";

          if (boundaryY !== undefined) {
            var pct =
              ((boundaryY - top) / height) * 100;
            var c1 = aboveTheme === "dark" ? "#fff" : "#000";
            var c2 = belowTheme === "dark" ? "#fff" : "#000";
            var spread = 20;
            var startPct = Math.max(0, pct - spread);
            var endPct = Math.min(100, pct + spread);

            el.style.backgroundImage =
              "linear-gradient(" +
              dir +
              ", " +
              c1 +
              " 0%, " +
              c1 +
              " " +
              startPct +
              "%, " +
              c2 +
              " " +
              endPct +
              "%, " +
              c2 +
              " 100%)";
            el.style.webkitBackgroundClip = "text";
            el.style.backgroundClip = "text";
            el.style.color = "transparent";
          } else {
            var mid = getThemeAt((top + bottom) / 2);
            var col = mid === "dark" ? "#fff" : "#000";
            el.style.backgroundImage = "";
            el.style.webkitBackgroundClip = "";
            el.style.backgroundClip = "";
            el.style.color = col;
          }
        }

        function updateFrameTheme() {
          if (!frame) return;

          // Logo (horizontal text): per-pixel gradient top→bottom
          updateTextGradient(
            document.querySelector(".tria-frame .tria-logo"),
            true,
          );

          // Logo dot: solid color based on section
          var logoDot = document.querySelector('.tria-frame .tria-logo [data-i="4"]');
          if (logoDot) {
            var rd = logoDot.getBoundingClientRect();
            var isDark = getThemeAt(rd.top + rd.height / 2) === "dark";
            logoDot.classList.toggle("tria-on-dark", isDark);
            logoDot.classList.remove("tria-on-accent");
          }

          // Hamburger: per-line (3 real spans)
          var menuBtn = document.querySelector(
            ".tria-frame .tria-menu-btn",
          );
          if (menuBtn) {
            var lines = menuBtn.querySelectorAll("span");
            for (var i = 0; i < lines.length; i++) {
              var r = lines[i].getBoundingClientRect();
              lines[i].classList.toggle(
                "tria-on-dark",
                getThemeAt(r.top + r.height / 2) === "dark",
              );
            }
          }

          // Language switcher (desktop bottom frame — rotated, so getBoundingClientRect is unreliable)
          // Use a fixed offset from viewport bottom instead
          var bottomY = window.innerHeight - 80;
          var isBottomDark = getThemeAt(bottomY) === "dark";
          var langBtns = document.querySelectorAll(
            ".tria-frame-bottom-left .tria-lang-btn",
          );
          for (var b = 0; b < langBtns.length; b++) {
            langBtns[b].classList.toggle(
              "tria-on-dark",
              isBottomDark,
            );
          }
          var langDivider = document.querySelector(
            ".tria-frame-bottom-left .tria-lang-divider",
          );
          if (langDivider) {
            langDivider.classList.toggle(
              "tria-on-dark",
              isBottomDark,
            );
          }

          // Mobile language switcher (top-right frame)
          var mobileLangBtns = document.querySelectorAll(
            ".tria-mobile-lang-btn",
          );
          for (var m = 0; m < mobileLangBtns.length; m++) {
            var r = mobileLangBtns[m].getBoundingClientRect();
            mobileLangBtns[m].classList.toggle(
              "tria-on-dark",
              getThemeAt(r.top + r.height / 2) === "dark",
            );
          }

          // Page name: simple on-dark class toggle (a added by tria-main.js later)
          var pageName = document.querySelector(
            ".tria-frame .tria-frame-bottom .tria-current-page",
          );
          if (pageName) {
            var r = pageName.getBoundingClientRect();
            pageName.classList.toggle(
              "tria-on-dark",
              getThemeAt(r.top + r.height / 2) === "dark",
            );
          }

          // Back-to-top text (rotated -90°): gradient right→left = visual bottom→top
          updateTextGradient(
            document.querySelector(
              ".tria-frame .tria-frame-bottom .tria-back-to-top .tria-link > span",
            ),
            false,
          );

          // Back-to-top arrow: solid theme color
          var bttArrow = document.querySelector(
            ".tria-frame .tria-frame-bottom .tria-back-to-top .tria-btt-arrow",
          );
          if (bttArrow) {
            var ra = bttArrow.getBoundingClientRect();
            bttArrow.classList.toggle(
              "tria-on-dark",
              getThemeAt(ra.top + ra.height / 2) === "dark",
            );
          }
        }

        function initFrameTheme() {
          updateFrameTheme();
          // Re-run after tria-main.js clones page name and arrow
          if (document.readyState === "complete") {
            updateFrameTheme();
          } else {
            window.addEventListener("load", function () {
              updateFrameTheme();
            });
          }
        }

        window.addEventListener("scroll", updateFrameTheme, {
          passive: true,
        });
        window.addEventListener("resize", updateFrameTheme);
        initFrameTheme();

        window.__heroCleanup = null;
        window.__reinitHeroBg = function () {
          var bg = document.querySelector(".tria-hero-bg");
          if (!bg) return;
          if (window.__heroCleanup) {
            try { window.__heroCleanup(); } catch(e) {}
            window.__heroCleanup = null;
          }
          if (bg.dataset.gradProps && window.__initHeroGradient) {
            try {
              window.__heroCleanup = window.__initHeroGradient(bg, JSON.parse(bg.dataset.gradProps));
            } catch (e) {
              console.error("Failed to init hero bg:", e);
            }
          }
        };
      })();
    </script>

    <!-- Global link handler: hides browser status bar preview for all links (converts href → data-href) -->
    <script is:inline>
    (function() {
      function navigate(href, target, el) {
        if (!href) return;
        // Handle download links (e.g. PDFs, images)
        if (el && el.hasAttribute('download')) {
          var tmp = document.createElement('a');
          tmp.href = href;
          tmp.download = el.getAttribute('download') || '';
          tmp.click();
          return;
        }
        if (target === '_blank') {
          window.open(href, '_blank', 'noopener,noreferrer');
        } else if (window.__swup && typeof window.__swup.navigate === 'function') {
          window.__swup.navigate(href);
        } else {
          window.location.href = href;
        }
      }

      function openMail(target) {
        var addr = target.getAttribute('data-mailto');
        if (addr) window.location.href = 'mailto:' + addr;
      }

      function hideLinkPreviews() {
        document.querySelectorAll('a[href]').forEach(function(a) {
          var href = a.getAttribute('href');
          // Skip hash-only, mailto:, tel:, javascript: — they don't show external URLs
          if (href === '#' || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) return;
          a.setAttribute('data-href', href);
          a.removeAttribute('href');
          if (!a.hasAttribute('tabindex')) a.setAttribute('tabindex', '0');
        });
      }
      window.hideLinkPreviews = hideLinkPreviews;
      window.triaNavigate = navigate;

      // Handle clicks: data-href (navigation) + data-mailto (mail)
      document.addEventListener('click', function(e) {
        var target = e.target.closest('[data-href]');
        if (target) {
          // Skip language switcher buttons — handled by tria-i18n.js (seamless Swup switching)
          if (target.closest('[data-lang]')) return;
          e.preventDefault();
          navigate(target.getAttribute('data-href'), target.getAttribute('target'), target);
          return;
        }
        target = e.target.closest('[data-mailto]');
        if (target) {
          e.preventDefault();
          openMail(target);
        }
      });

      // Handle keyboard: Enter/Space on data-href and data-mailto
      document.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        var target = e.target.closest('[data-href]');
        if (target) {
          e.preventDefault();
          navigate(target.getAttribute('data-href'), target.getAttribute('target'), target);
          return;
        }
        target = e.target.closest('[data-mailto]');
        if (target) {
          e.preventDefault();
          openMail(target);
        }
      });

      // Run conversion on load and after Swup page transitions
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', hideLinkPreviews);
      } else {
        hideLinkPreviews();
      }
      document.addEventListener('swup:contentReplaced', hideLinkPreviews);
    })();
    </script>
    <!-- Defer non-critical vendor JS (loaded after initial render) -->
    <script src="/assets/js/vendor/jquery.min.js" defer></script>
    <script src="/assets/js/vendor/swiper.min.js" defer></script>
    <script src="/assets/js/vendor/gsap.min.js" defer></script>
    <script src="/assets/js/vendor/ScrollTrigger.min.js" defer></script>
    <script src="/assets/js/vendor/ScrollTo.min.js" defer></script>
    <script src="/assets/js/vendor/swup.min.js" defer></script>
    <script src="https://unpkg.com/lenis@1.3.23/dist/lenis.min.js" defer></script>
    <script src="/assets/js/tria-main.js" defer></script>
    <script src="/assets/js/tria-i18n.js" defer></script>
    <script>
    import { initGradient } from "../scripts/hero-gradient";
    window.__initHeroGradient = initGradient;
    if (document.querySelector(".tria-hero-bg") && window.__reinitHeroBg) {
      window.__reinitHeroBg();
    }
    </script>

    <!-- Swup initialization for smooth page transitions -->
    <script is:inline>
    (function() {
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof Swup !== 'undefined' && !document.querySelector('html.swup-enabled')) {
          var swup = new Swup({
            containers: ['#swup'],
            animateHistoryBrowsing: true,
            cache: true,
          });
          window.__swup = swup;

          // Reinitialize components after each page transition
          swup.on('contentReplaced', function() {
            // Clean up previous hero gradient (always — handles pages w/o gradient too)
            if (window.__heroCleanup) {
              try { window.__heroCleanup(); } catch(e) {}
              window.__heroCleanup = null;
            }
            // Re-inject the data-href mechanism for new links
            if (window.hideLinkPreviews) {
              window.hideLinkPreviews();
            }
            // Re-apply i18n translations to new content
            if (window.triaI18n && window.triaI18n.apply) {
              window.triaI18n.apply();
            }
            // Initialize hero WebGL gradient on new page (if it has one)
            if (window.__reinitHeroBg) {
              window.__reinitHeroBg();
            }
          });
        }
      });
    })();
    </script>

    <!-- Set sessionStorage flag after splash animation completes -->
    <script is:inline>
    (function() {
      var preloader = document.querySelector('.tria-preloader');
      if (!preloader || sessionStorage.getItem('triaSplashShown')) return;
      var obs = new MutationObserver(function() {
        if (preloader.classList.contains('tria-hidden')) {
          try { sessionStorage.setItem('triaSplashShown', '1'); } catch(e) {}
          obs.disconnect();
        }
      });
      obs.observe(preloader, { attributes: true, attributeFilter: ['class'] });
    })();
    </script>
  </body>
</html>
