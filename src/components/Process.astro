---
import NumberedList, { type NumberedListItem } from "./NumberedList.astro";

interface Props {
  suptitle?: string;
  heading: string;
  intro?: string;
  steps: NumberedListItem[];
  padding?: string;
}

const {
  suptitle,
  heading,
  intro,
  steps = [],
  padding = 'tria-p-120-120'
} = Astro.props;
---

<!-- process -->
<section id="process" class="tria-process-section" data-section-theme="dark">
  <div class={`container ${padding}`}>
    <div class="row tria-mb-120">
      <div class="col-lg-6">
        {suptitle && <span class="tria-suptitle tria-suptitle-dark tria-up">{suptitle}</span>}
        <h2 class="tria-up tria-mt-30" set:html={heading} />
      </div>
      {intro && (
        <div class="col-lg-5 offset-lg-1 tria-process-intro-col">
          <p class="tria-up tria-process-intro">{intro}</p>
        </div>
      )}
    </div>

    <NumberedList items={steps} />
  </div>
</section>
<!-- process end -->

<style>
  .tria-process-section {
    background: #0b0d17;
  }

  .tria-process-section .tria-suptitle::before {
    background-color: rgba(255,255,255,0.15);
  }
  .tria-process-section .tria-suptitle {
    color: rgba(255,255,255,0.5);
  }
  .tria-process-section h2 {
    color: #fff;
  }
  .tria-process-section .tria-thin {
    color: rgba(255,255,255,0.4);
  }

  .tria-process-intro-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 8px;
  }

  .tria-process-intro {
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
    font-size: 1rem;
    margin: 0;
  }

  .tria-mt-30 {
    margin-top: 30px;
  }
</style>
