---
interface Props {
  sections: {
    title: string;
    paragraphs?: string[];
    list?: string[];
  }[];
  lastUpdated?: string;
}

const { sections, lastUpdated } = Astro.props;
---

<section class="tria-legal-section" data-section-theme="light">
  <div class="tria-ambient-temp">
    <div class="tria-at-glow-1"></div>
    <div class="tria-at-glow-3"></div>
  </div>
  <div class="container tria-p-120-90">
    <div class="tria-legal-wrap">
      {lastUpdated && (
        <p class="tria-legal-updated" data-i18n="legal.lastUpdated">{lastUpdated}</p>
      )}

      {sections.map((section, i) => (
        <div class="tria-legal-block tria-up">
          <div class="tria-legal-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
          <div class="tria-legal-body">
            <h2 class="tria-legal-h2">{section.title}</h2>
            {section.paragraphs?.map((p) => (
              <p class="tria-legal-p">{p}</p>
            ))}
            {section.list && section.list.length > 0 && (
              <ul class="tria-legal-list">
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tria-legal-section {
    background: #fff;
    position: relative;
    overflow: hidden;
  }

  .tria-legal-wrap {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .tria-legal-updated {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    margin-bottom: 56px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .tria-legal-block {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
    padding: 0 0 48px;
    margin-bottom: 48px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .tria-legal-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .tria-legal-num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(0, 0, 0, 0.2);
    padding-top: 8px;
    transition: color 0.35s ease;
  }

  .tria-legal-block:hover .tria-legal-num {
    color: var(--accent);
  }

  .tria-legal-body {
    min-width: 0;
  }

  .tria-legal-h2 {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #0b0d17;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .tria-legal-p {
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(0, 0, 0, 0.58);
    margin: 0 0 14px;
    font-weight: 400;
  }
  .tria-legal-p:last-child {
    margin-bottom: 0;
  }

  .tria-legal-list {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tria-legal-list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.58);
  }

  .tria-legal-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(6, 142, 140, 0.5);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .tria-legal-block {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-bottom: 36px;
      margin-bottom: 36px;
    }
    .tria-legal-num {
      padding-top: 0;
    }
    .tria-legal-updated {
      margin-bottom: 40px;
    }
  }

  @media (max-width: 576px) {
    .tria-legal-p,
    .tria-legal-list li {
      font-size: 0.84rem;
      line-height: 1.75;
    }
  }
</style>
