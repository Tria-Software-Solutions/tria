---
interface WorkItem {
  category: string;
  title: string;
  description: string;
  gradient: string;
  tags?: string[];
  stat?: string;
  statLabel?: string;
  previewImg?: string;
  liveUrl?: string;
  wikiUrl?: string;
}

interface Props {
  suptitle?: string;
  heading: string;
  viewAllText?: string;
  viewAllHref?: string;
  ctaText?: string;
  wikiText?: string;
  projects: WorkItem[];
  padding?: string;
}

const {
  suptitle,
  heading,
  viewAllText,
  viewAllHref = "",
  ctaText = "View project",
  wikiText = "View wiki",
  prevText = "Prev",
  nextText = "Next",
  projects = [],
  padding = 'tria-p-120-120'
} = Astro.props;
---

<section id="featured" class="tria-feat" data-section-theme="light">
  <div class="tria-ambient-temp">
    <div class="tria-at-glow-3"></div>
  </div>

  <div class={`container ${padding}`}>
    <div class="row align-items-end tria-mb-60">
      <div class="col-lg-8">
        {suptitle && <span class="tria-suptitle tria-suptitle-dark tria-up">{suptitle}</span>}
        <h2 class="tria-up tria-mt-30" set:html={heading} />
      </div>
      {viewAllText && viewAllHref && (
        <div class="col-lg-4 tria-feat-header-right">
          <a href={viewAllHref} class="tria-feat-view-link">
            <span>{viewAllText}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      )}
    </div>

    <div class="tria-feat-layout">
      <!-- Editorial list -->
      <div class="tria-feat-list" id="featList">
        {projects.map((card, i) => (
          <div
            class="tria-feat-row"
            data-live={card.liveUrl || ''}
            data-fallback={card.previewImg || ''}
            data-title={card.title}
            data-cat={card.category}
            data-wiki={card.wikiUrl || ''}
            data-index={i}
          >
            <span class="tria-feat-row-main">
              <span class="tria-feat-row-cat">{card.category}</span>
              <span class="tria-feat-row-head">
                <h3 class="tria-feat-row-title">{card.title}</h3>
              </span>
              {card.description && <p class="tria-feat-row-desc">{card.description}</p>}
              {(card.stat || card.statLabel) && (
                <span class="tria-feat-row-meta">
                  {card.stat}{card.stat && card.statLabel ? ' ' : ''}{card.statLabel}
                </span>
              )}
            </span>
            {card.tags && card.tags.length > 0 && (
              <span class="tria-feat-row-tools">
                {card.tags.map((tag, ti) => (
                  <span class="tria-feat-row-tool">{tag}{ti < card.tags.length - 1 && <span class="tria-feat-row-tool-sep">/</span>}</span>
                ))}
              </span>
            )}
          </div>
        ))}
        <!-- Wiki link for the active project (starts on the first project) -->
        <div class="tria-feat-wiki">
          <a class="tria-feat-wiki-link" id="featWiki" href={projects[0]?.wikiUrl || '#'} target="_blank" rel="noopener noreferrer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span>{wikiText}</span>
            <svg class="tria-feat-wiki-arrow" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3h7v7M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Laptop stage — live demo preview -->
      <div class="tria-feat-stage" id="featStage" aria-hidden="true">
        <div class="tria-feat-laptop" id="featLaptop">
          <div class="tria-feat-laptop-media">
            <img
              class="tria-feat-laptop-frame"
              src="/assets/img/featured/mockup/macbook-pro-13-1200.png"
              alt=""
              width="1200"
              height="706"
              loading="lazy"
              aria-hidden="true"
            />
            <div class="tria-feat-screen-viewport" id="featViewport">
              <div class="tria-feat-screen-loader" id="featLoader"></div>
              <!-- Trusted cross-origin demo app — a plain iframe (no sandbox) avoids
                   the Chrome "allow-scripts + allow-same-origin can escape sandboxing"
                   warning while keeping the embedded app fully functional -->
              <iframe
                id="featFrame"
                title="Project live preview"
                referrerpolicy="no-referrer"
                loading="lazy"
              ></iframe>
              <div class="tria-feat-screen-fallback" id="featFallback">
                <img src="" alt="" />
              </div>
            </div>
          </div>

          <!-- Expand hint + clickable overlay -->
          <button type="button" class="tria-feat-zoom" id="featZoom" aria-label="Expand preview" aria-expanded="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Expand</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Prev / Next — centered across the whole section -->
    <div class="tria-feat-nav" id="featNav">
      <button type="button" class="tria-feat-nav-btn" id="featPrev" aria-label={prevText}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{prevText}</span>
      </button>
      <button type="button" class="tria-feat-nav-btn" id="featNext" aria-label={nextText}>
        <span>{nextText}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Fullscreen lightbox: enlarged live preview — no card, just the laptop image -->
  <div class="tria-feat-lightbox" id="featLightbox" role="dialog" aria-modal="true" aria-label="Project preview (enlarged)" hidden>
    <div class="tria-feat-lightbox-backdrop"></div>
    <div class="tria-feat-lightbox-screen" id="featLightboxScreen">
      <div class="tria-feat-lightbox-screen-inner" id="featLightboxScreenInner">
        <div class="tria-feat-lightbox-laptop" id="featLightboxLaptop">
          <img
            class="tria-feat-lightbox-frame"
            src="/assets/img/featured/mockup/macbook-pro-13-1200.png"
            alt=""
            width="1200"
            height="706"
            loading="lazy"
            aria-hidden="true"
          />
          <div class="tria-feat-lightbox-cutout" id="featLightboxCutout">
            <div class="tria-feat-lightbox-loader" id="featLightboxLoader"></div>
            <!-- Same trusted cross-origin preview — no sandbox (see note above) -->
            <iframe id="featLightboxFrame" title="Project preview (enlarged)" referrerpolicy="no-referrer"></iframe>
            <div class="tria-feat-lightbox-fallback" id="featLightboxFallback">
              <img src="" alt="" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tria-feat {
    position: relative;
    background: #f5f7f9;
    overflow: hidden;
  }
  .tria-feat,
  .tria-feat * {
    font-family: var(--font-display, 'Outfit', sans-serif);
  }
  .tria-feat .container { position: relative; z-index: 1; }
  .tria-feat h2 { color: #0b0d17; }
  .tria-feat-header-right {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
  }

  /* ═══ View-all link — matches .tria-link look ═══ */
  .tria-feat-view-link {
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 0.4s var(--ease-spring), gap 0.4s var(--ease-spring);
  }
  .tria-feat-view-link svg {
    margin-left: 12px;
    transition: transform 0.4s var(--ease-spring);
  }
  .tria-feat-view-link:hover { color: var(--accent, #068e8c); }
  .tria-feat-view-link:hover svg { transform: translateX(4px); }

  /* ═══════ LAYOUT ═══════ */
  .tria-feat-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(460px, 1.1fr);
    gap: 64px;
    align-items: start;
  }

  /* ═══════ LIST — minimal editorial, single active row ═══════ */
  .tria-feat-list {
    position: relative;
  }

  .tria-feat-row {
    position: relative;
    display: none;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px 18px;
    padding: 34px 8px 38px 4px;
    text-decoration: none;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s var(--ease-spring), transform 0.6s var(--ease-spring);
  }
  .tria-feat-row.is-active {
    display: grid;
    opacity: 1;
    transform: none;
    animation: tria-row-in 0.7s var(--ease-spring) both;
  }
  .tria-feat-row.is-active.tria-dir-next { animation-name: tria-row-in-next; }
  .tria-feat-row.is-active.tria-dir-prev { animation-name: tria-row-in-prev; }
  @keyframes tria-row-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tria-row-in-next {
    from { opacity: 0; transform: translateX(42px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tria-row-in-prev {
    from { opacity: 0; transform: translateX(-42px); }
    to { opacity: 1; transform: none; }
  }

  .tria-feat-row-head {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }

  .tria-feat-row-main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* category — suptitle style with accent dash */
  .tria-feat-row-cat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.4s ease;
  }
  .tria-feat-row-cat::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--accent, #068e8c);
    flex: none;
  }
  .tria-feat-row:hover .tria-feat-row-cat,
  .tria-feat-row.is-active .tria-feat-row-cat { color: rgba(0, 0, 0, 0.55); }

  .tria-feat-row-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 450;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: #0b0d17;
    margin: 0;
  }
  .tria-feat-row-desc {
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.005em;
    color: rgba(0, 0, 0, 0.5);
    margin: 0 0 18px;
    max-width: 44ch;
  }

  .tria-feat-row-meta {
    font-size: 0.78rem;
    font-weight: 450;
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.45);
  }

  /* tools — plain text, no chips */
  .tria-feat-row-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-self: start;
  }
  .tria-feat-row-tool {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    transition: color 0.4s ease;
  }
  .tria-feat-row:hover .tria-feat-row-tool,
  .tria-feat-row.is-active .tria-feat-row-tool { color: rgba(6, 142, 140, 0.75); }
  .tria-feat-row-tool-sep { margin-left: 6px; color: rgba(0, 0, 0, 0.15); }

  /* ── Wiki link for the active project ── */
  .tria-feat-wiki {
    margin-top: 4px;
    padding-left: 4px;
  }
  .tria-feat-wiki-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
    text-decoration: none;
    transition: color 0.35s var(--ease-spring), gap 0.35s var(--ease-spring);
  }
  .tria-feat-wiki-link svg:first-child {
    color: var(--accent, #068e8c);
    flex-shrink: 0;
  }
  .tria-feat-wiki-arrow {
    transition: transform 0.35s var(--ease-spring);
    flex-shrink: 0;
  }
  .tria-feat-wiki-link:hover {
    color: var(--accent, #068e8c);
    gap: 14px;
  }
  .tria-feat-wiki-link:hover .tria-feat-wiki-arrow {
    transform: translate(2px, -2px);
  }
  .tria-feat-wiki-link[aria-disabled="true"] {
    opacity: 0.3;
    pointer-events: none;
  }

  /* prev / next — subtle text buttons, centered at section level, lower */
  .tria-feat-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 88px;
  }
  .tria-feat-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.4s var(--ease-spring);
  }
  .tria-feat-nav-btn svg {
    width: 34px;
    height: 34px;
    padding: 8px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.04);
    transition: transform 0.4s var(--ease-spring), background 0.4s var(--ease-spring);
  }
  .tria-feat-nav-btn:hover { color: var(--accent, #068e8c); }
  .tria-feat-nav-btn:hover svg {
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent, #068e8c);
    transform: translateX(3px);
  }
  .tria-feat-nav-btn:first-child:hover svg { transform: translateX(-3px); }
  .tria-feat-nav-btn:active svg { transform: scale(0.9); }
  /* ═══════ LAPTOP STAGE — live demo preview ═══════ */
  .tria-feat-stage {
    position: sticky;
    top: 100px;
  }

  /* MacBook Pro 13 frame + live viewport */
  .tria-feat-laptop {
    position: relative;
    width: 100%;
    max-width: 740px;
    margin: 0 auto;
  }

  /* Media wrapper — blurs behind the expand button on hover */
  .tria-feat-laptop-media {
    position: relative;
    transition: filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-feat-stage:hover .tria-feat-laptop-media,
  .tria-feat-stage:focus-within .tria-feat-laptop-media {
    filter: blur(3px) brightness(0.95) saturate(0.95);
  }

  /* After closing the lightbox the pointer is still over the laptop, so the
     hover blur would stay stuck — this class clears it until the pointer
     leaves the stage (then a fresh hover re-enables the blur). */
  .tria-feat-stage.tria-feat-blur-cleared .tria-feat-laptop-media,
  .tria-feat-stage.tria-feat-blur-cleared:hover .tria-feat-laptop-media,
  .tria-feat-stage.tria-feat-blur-cleared:focus-within .tria-feat-laptop-media {
    filter: none;
  }

  /* ── Expand button (centered over the laptop, appears on hover) ── */
  .tria-feat-zoom {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -46%) scale(0.92);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border: none;
    border-radius: 100px;
    background: rgba(11, 13, 23, 0.85);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    color: #fff;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    z-index: 4;
    box-shadow: 0 12px 32px rgba(11, 13, 23, 0.4);
    transition: opacity 0.4s ease, transform 0.45s var(--ease-spring), background 0.35s ease, box-shadow 0.35s ease;
  }
  .tria-feat-zoom svg {
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-spring);
  }
  .tria-feat-stage:hover .tria-feat-zoom,
  .tria-feat-zoom:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
  }
  .tria-feat-zoom:hover {
    background: var(--accent, #068e8c);
    box-shadow: 0 14px 36px rgba(6, 142, 140, 0.4);
  }
  .tria-feat-zoom:hover svg {
    transform: scale(1.15);
  }
  .tria-feat-laptop:hover {
    cursor: zoom-in;
  }

  /* ── Fullscreen lightbox ── */
  .tria-feat-lightbox {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .tria-feat-lightbox[hidden] {
    display: none;
  }
  .tria-feat-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .tria-feat-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 7, 14, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: zoom-out;
  }
  .tria-feat-lightbox-screen {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
    /* Let clicks pass through to the backdrop so clicking outside the
       laptop closes the lightbox; only the laptop stays interactive. */
    pointer-events: none;
  }
  .tria-feat-lightbox-screen-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tria-feat-lightbox-laptop {
    position: relative;
    flex-shrink: 0;
    transform-origin: center;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.5));
    pointer-events: auto;
  }
  .tria-feat-lightbox-frame {
    display: block;
    width: 1200px;
    height: 706px;
    max-width: none;
  }
  /* screen cutout — same proportions as the main laptop stage */
  .tria-feat-lightbox-cutout {
    position: absolute;
    top: 7.244%;
    left: 11.813%;
    width: 76.372%;
    height: 81.054%;
    overflow: hidden;
    background: #fff;
  }
  .tria-feat-lightbox-cutout iframe {
    position: absolute;
    top: -1%;
    left: -1%;
    width: 1440px !important;
    max-width: none !important;
    height: 900px !important;
    border: none;
    background: #fff;
    transform-origin: top left;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .tria-feat-lightbox-cutout iframe.is-live { opacity: 1; }
  .tria-feat-lightbox-fallback {
    position: absolute;
    inset: 0;
    display: none;
  }
  .tria-feat-lightbox-fallback.is-fallback { display: block; }
  .tria-feat-lightbox-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .tria-feat-lightbox-loader {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    transition: opacity 0.4s ease;
  }
  .tria-feat-lightbox-loader::after {
    content: '';
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(6, 142, 140, 0.25);
    border-top-color: var(--accent, #068e8c);
    animation: tria-feat-spin 0.9s linear infinite;
  }
  .tria-feat-lightbox-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .tria-feat-laptop-frame {
    display: block;
    width: 100%;
    height: auto;
  }

  /* screen area — aligned to the real display cutout in the frame PNG
     (measured: 396,143 → 2956,1743 on a 3352×1974 image) */
  .tria-feat-screen-viewport {
    position: absolute;
    top: 7.244%;
    left: 11.813%;
    width: 76.372%;
    height: 81.054%;
    overflow: hidden;
    background: #fff;
  }
  .tria-feat-screen-viewport iframe {
    position: absolute;
    top: -1%;
    left: -1%;
    width: 1440px !important;
    max-width: none !important;
    height: 900px !important;
    border: none;
    background: #fff;
    transform-origin: top left;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .tria-feat-screen-viewport iframe.is-live { opacity: 1; }

  .tria-feat-screen-fallback {
    position: absolute;
    inset: 0;
    display: none;
  }
  .tria-feat-screen-fallback.is-fallback { display: block; }
  .tria-feat-screen-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .tria-feat-screen-loader {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f7f9;
    transition: opacity 0.4s ease;
  }
  .tria-feat-screen-loader::after {
    content: '';
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(6, 142, 140, 0.25);
    border-top-color: var(--accent, #068e8c);
    animation: tria-feat-spin 0.9s linear infinite;
  }
  .tria-feat-screen-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes tria-feat-spin {
    to { transform: rotate(360deg); }
  }

  /* ═══════ RESPONSIVE ═══════ */
  @media (max-width: 1199px) {
    .tria-feat-layout {
      grid-template-columns: minmax(0, 1fr) minmax(380px, 1fr);
      gap: 40px;
    }
    .tria-feat-row { gap: 12px 16px; }
  }

  @media (max-width: 991px) {
    .tria-feat-header-right { justify-content: flex-start; }
    .tria-feat-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tria-feat-stage {
      position: static;
      order: -1;
      max-width: 560px;
      margin: 0 auto 56px;
    }
    .tria-feat-list { max-width: 620px; }
    .tria-feat-row { gap: 10px 14px; }
    .tria-feat-row-title { font-size: clamp(1.4rem, 4vw, 1.8rem); }
  }

  @media (max-width: 767px) {
    .tria-feat-row {
      gap: 8px 12px;
      padding: 24px 4px 28px 0;
    }
    .tria-feat-row-head { gap: 12px; }
    .tria-feat-row-title { font-size: 1.35rem; letter-spacing: -0.03em; }
    .tria-feat-row-desc { font-size: 0.8rem; }
    .tria-feat-row-cat { font-size: 0.62rem; letter-spacing: 0.12em; }
    .tria-feat-row-meta { font-size: 0.72rem; }
    .tria-feat-row-tool { font-size: 0.58rem; letter-spacing: 0.08em; }
    .tria-feat-wiki-link { font-size: 0.66rem; }
    .tria-feat-nav { margin-top: 64px; }
    .tria-feat-nav-btn { font-size: 0.68rem; }
    .tria-feat-nav-btn svg { width: 32px; height: 32px; padding: 7px; }
  }

  /* ── Touch: keep the expand button visible (no hover) but anchored below
     the laptop so it doesn't cover the live demo preview ── */
  @media (hover: none) {
    .tria-feat-zoom {
      opacity: 1;
      pointer-events: auto;
      top: auto;
      bottom: -20px;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @media (max-width: 575px) {
    .tria-feat-lightbox {
      padding: 12px;
    }
    .tria-feat-lightbox-screen {
      padding: 24px;
    }
  }
</style>

<script is:inline>
(function () {
  var dispose = null;

  function initFeatured() {
    var section = document.getElementById('featured');
    if (!section) return;
    var rows = section.querySelectorAll('.tria-feat-row');
    if (!rows.length) return;

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Swup replaces the DOM on navigation — tear down the previous instance
       (listeners, observer, timers) before binding the fresh nodes. */
    if (dispose) {
      dispose();
      dispose = null;
    }

    var frame = document.getElementById('featFrame');
    var loader = document.getElementById('featLoader');
    var fallback = document.getElementById('featFallback');
    var fallbackImg = fallback ? fallback.querySelector('img') : null;
    var viewport = document.getElementById('featViewport');
    var navPrev = document.getElementById('featPrev');
    var navNext = document.getElementById('featNext');
    var wikiLink = document.getElementById('featWiki');
    if (!frame || !loader) return;

    var currentLive = '';
    var loadTimer = null;

    /* iframe renders at the MacBook 13" CSS viewport (1440×900 = 16:10)
       and is scaled to overdraw the laptop screen (4% each axis, origin
       top-left, so the -1% offsets keep both axes covered and no hairline
       of the viewport bg shows; overflow:hidden clips the excess). */
    var frameScale = 1.04;
    function scaleFrame() {
      if (!viewport || !frame) return;
      var s = (viewport.clientWidth / 1440) * frameScale;
      frame.style.transform = 'scale(' + s + ')';
    }
    scaleFrame();
    window.addEventListener('resize', scaleFrame);

    /* ── Auto-advance: cycles rows so the laptop keeps showing live demos ── */
    var DWELL = 8000;
    var advanceTimer = null;
    var currentIdx = 0;
    var hoverIdx = -1;
    var sectionVisible = false;
    var paused = false;

    function updateStage(row, trigger) {
      var live = (row.getAttribute('data-live') || '').trim();
      var fb = (row.getAttribute('data-fallback') || '').trim();
      var wiki = (row.getAttribute('data-wiki') || '').trim();

      /* Wiki link follows the active project.
         The global link handler (hideLinkPreviews) turns href → data-href, so
         BOTH attributes must stay in sync or clicks use a stale URL. */
      if (wikiLink) {
        if (wiki) {
          wikiLink.setAttribute('href', wiki);
          wikiLink.setAttribute('data-href', wiki);
          wikiLink.removeAttribute('aria-disabled');
        } else {
          wikiLink.removeAttribute('href');
          wikiLink.removeAttribute('data-href');
          wikiLink.setAttribute('aria-disabled', 'true');
        }
      }

      if (live) {
        fallback.classList.remove('is-fallback');
        if (live !== currentLive || trigger === 'force') {
          currentLive = live;
          frame.classList.remove('is-live');
          loader.classList.remove('is-hidden');
          if (loadTimer) clearTimeout(loadTimer);
          frame.src = live;
        }
      } else if (fb) {
        /* Static project → screenshot preview */
        currentLive = '';
        frame.classList.remove('is-live');
        if (fallbackImg) fallbackImg.src = fb;
        fallback.classList.add('is-fallback');
        loader.classList.add('is-hidden');
        if (loadTimer) clearTimeout(loadTimer);
      }
    }

    frame.addEventListener('load', function () {
      loader.classList.add('is-hidden');
      frame.classList.add('is-live');
      if (loadTimer) clearTimeout(loadTimer);
    });
    loadTimer = setTimeout(function () {
      loader.classList.add('is-hidden');
    }, 8000);

    function setActive(i, animate, dir) {
      rows.forEach(function (r, ri) {
        r.classList.toggle('is-active', ri === i);
        r.classList.remove('tria-dir-next', 'tria-dir-prev');
      });
      var row = rows[i];
      if (animate !== false && dir) row.classList.add(dir === -1 ? 'tria-dir-prev' : 'tria-dir-next');
      updateStage(row);
    }

    function schedule() {
      if (paused || reduced || hoverIdx >= 0) return;
      clearTimeout(advanceTimer);
      advanceTimer = setTimeout(function () {
        currentIdx = (currentIdx + 1) % rows.length;
        setActive(currentIdx, true, 1);
        schedule();
      }, DWELL);
    }

    function stop() {
      clearTimeout(advanceTimer);
      advanceTimer = null;
    }

    function goTo(index, dir) {
      currentIdx = (index + rows.length) % rows.length;
      stop();
      setActive(currentIdx, true, dir);
      schedule();
    }

    if (navPrev) navPrev.addEventListener('click', function () {
      goTo(currentIdx - 1, -1);
    });
    if (navNext) navNext.addEventListener('click', function () {
      goTo(currentIdx + 1, 1);
    });

    /* ── Fullscreen lightbox: enlarge the live preview ── */
    var zoomBtn = document.getElementById('featZoom');
    var lightbox = document.getElementById('featLightbox');
    var lbFrame = document.getElementById('featLightboxFrame');
    var lbLoader = document.getElementById('featLightboxLoader');
    var lbFallback = document.getElementById('featLightboxFallback');
    var lbFallbackImg = lbFallback ? lbFallback.querySelector('img') : null;
    var lbScreen = document.getElementById('featLightboxScreen');
    var lbScreenInner = document.getElementById('featLightboxScreenInner');
    var lbLaptop = document.getElementById('featLightboxLaptop');
    var lbCutout = document.getElementById('featLightboxCutout');
    var lbOpen_ = false;
    var closeTimer = null;

    function scaleLightbox() {
      if (!lbScreen || !lbScreenInner || !lbLaptop || !lbCutout || !lbFrame) return;
      /* Fit the laptop image inside the padded inner area (both axes). */
      var s = Math.min(lbScreenInner.clientWidth / 1200, lbScreenInner.clientHeight / 706) * 1.001;
      lbLaptop.style.transform = 'scale(' + s + ')';
      /* Scale the inner preview to overdraw the cutout so sub-pixel
         rounding can never expose a white hairline at any edge. */
      var fs = (lbCutout.clientWidth * 1.02 / 1440) * 1.001;
      lbFrame.style.transform = 'scale(' + fs + ')';
    }
    window.addEventListener('resize', scaleLightbox);

    function updateLightbox() {
      var row = rows[currentIdx];
      if (!row) return;
      var live = (row.getAttribute('data-live') || '').trim();
      var fb = (row.getAttribute('data-fallback') || '').trim();

      if (live) {
        lbFallback.classList.remove('is-fallback');
        lbFrame.classList.remove('is-live');
        lbLoader.classList.remove('is-hidden');
        lbFrame.src = live;
      } else if (fb) {
        lbFrame.classList.remove('is-live');
        lbFrame.removeAttribute('src');
        if (lbFallbackImg) lbFallbackImg.src = fb;
        lbFallback.classList.add('is-fallback');
        lbLoader.classList.add('is-hidden');
      }
    }

    function openLightbox() {
      if (!lightbox || lbOpen_) return;
      lbOpen_ = true;
      if (closeTimer) clearTimeout(closeTimer);
      paused = true;
      stop();
      updateLightbox();
      lightbox.hidden = false;
      requestAnimationFrame(function () {
        lightbox.classList.add('is-open');
        /* Scale must run AFTER the lightbox is visible — otherwise the
           container has 0 size and the iframe would be scaled to 0. */
        scaleLightbox();
      });
      document.body.style.overflow = 'hidden';
      if (window.triaLenis) window.triaLenis.stop();
      if (zoomBtn) zoomBtn.setAttribute('aria-expanded', 'true');
      /* Move focus into the dialog for keyboard users (Tab trap uses iframe). */
      if (lbFrame) lbFrame.focus();
    }

    function closeLightbox() {
      if (!lightbox || !lbOpen_) return;
      lbOpen_ = false;
      lightbox.classList.remove('is-open');
      closeTimer = setTimeout(function () {
        lightbox.hidden = true;
        lbFrame.removeAttribute('src');
        if (lbFallback) lbFallback.classList.remove('is-fallback');
        if (zoomBtn) zoomBtn.setAttribute('aria-expanded', 'false');
        zoomBtn.focus();
      }, 350);
      paused = false;
      document.body.style.overflow = '';
      if (window.triaLenis) window.triaLenis.start();
      if (sectionVisible) schedule();

      /* The pointer is still over the laptop after closing → clear the hover
         blur (the stage keeps :hover since the mouse didn't move away). Remove
         the class on mouseleave (pointer left) or mouseenter (fresh hover) so
         the next hover blurs again. Covers both close paths: Escape/outside
         click with the pointer on the laptop, and backdrop clicks when the
         pointer is elsewhere. */
      var stageEl = document.getElementById('featStage');
      if (stageEl) {
        stageEl.classList.add('tria-feat-blur-cleared');
        function clearBlurFree() {
          stageEl.classList.remove('tria-feat-blur-cleared');
          stageEl.removeEventListener('mouseleave', clearBlurFree);
          stageEl.removeEventListener('mouseenter', clearBlurFree);
        }
        stageEl.addEventListener('mouseleave', clearBlurFree);
        stageEl.addEventListener('mouseenter', clearBlurFree);
      }
    }

    /* Keep Tab inside the dialog while it's open */
    lightbox.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab' || !lbOpen_) return;
      var focusables = lightbox.querySelectorAll('button, [href], iframe');
      if (!focusables.length) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    if (zoomBtn) zoomBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      openLightbox();
    });

    /* Close when clicking anywhere OUTSIDE the laptop image — works even if
       the screen/backdrop pointer-events trick is bypassed. Clicks inside the
       laptop (frame or iframe) never close. */
    lightbox.addEventListener('click', function (e) {
      if (e.target.closest('.tria-feat-lightbox-laptop')) return;
      closeLightbox();
    });

    lbFrame.addEventListener('load', function () {
      lbLoader.classList.add('is-hidden');
      lbFrame.classList.add('is-live');
    });
    setTimeout(function () {
      lbLoader.classList.add('is-hidden');
    }, 8000);

    function onKeydown(e) {
      if (e.key === 'Escape' && lbOpen_) closeLightbox();
    }
    document.addEventListener('keydown', onKeydown);

    /* ── Click the laptop itself to enlarge ── */
    var laptop = document.getElementById('featLaptop');
    if (laptop && !reduced) {
      laptop.addEventListener('click', function (e) {
        if (e.target.closest('#featZoom')) return;
        openLightbox();
      });
    }

    rows.forEach(function (row, i) {
      row.addEventListener('mouseenter', function () {
        hoverIdx = i;
        stop();
        currentIdx = i;
        setActive(i, false);
      });
      row.addEventListener('mouseleave', function () {
        if (hoverIdx === i) hoverIdx = -1;
        if (sectionVisible) schedule();
      });
    });

    if (reduced) {
      setActive(0, false);
    } else if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sectionVisible = entry.isIntersecting;
          if (entry.isIntersecting) {
            setActive(currentIdx, true);
            schedule();
          } else {
            stop();
          }
        });
      }, { threshold: 0.3 });
      io.observe(section);
    } else {
      setActive(0, false);
    }

    /* Store the cleanup so a later Swup navigation can dispose this instance. */
    dispose = function () {
      window.removeEventListener('resize', scaleFrame);
      window.removeEventListener('resize', scaleLightbox);
      document.removeEventListener('keydown', onKeydown);
      if (io) io.disconnect();
      clearTimeout(advanceTimer);
      clearTimeout(loadTimer);
      clearTimeout(closeTimer);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeatured);
  } else {
    initFeatured();
  }
  document.addEventListener('swup:contentReplaced', initFeatured);
})();
</script>
