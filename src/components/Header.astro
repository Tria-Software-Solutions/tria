---
import { createT, localePath } from "../i18n/utils";
const t = createT(Astro.currentLocale);
const locale = Astro.currentLocale;
const pathname = Astro.url.pathname;
const path = pathname.replace(/\/+$/, "") || "/";
const barePath = locale === "en" ? path : (path.replace(new RegExp(`^/${locale}`), "") || "/");
const enHref = barePath;
const esHref = `/es${barePath === "/" ? "" : barePath}`;

const lp = (p: string) => localePath(locale, p);

// Helper to check if the current bare path matches a given href
function isCurrentPage(href: string): boolean {
  const cleanHref = href.replace(/\/+$/, "") || "/";
  // For hash-anchored links like /services#software-dev, compare the path part
  const pathPart = cleanHref.split("#")[0];
  return barePath === pathPart || barePath.startsWith(pathPart + "/");
}

// Main navigation pages — the current page is highlighted, not hidden
const pages = [
  { href: "/", key: "nav.home" },
  { href: "/about", key: "nav.about" },
  { href: "/services", key: "nav.services" },
  { href: "/portfolio", key: "nav.work" },
  { href: "/contact", key: "nav.contact" },
  { href: "/blog", key: "nav.blog" },
];

// All 8 services (anchors on /services)
const menuServices = [
  { slug: "software-dev", key: "nav.softwareDev" },
  { slug: "uiux-design", key: "nav.uiuxDesign" },
  { slug: "cloud-devops", key: "nav.cloudDevops" },
  { slug: "qa-testing", key: "nav.qaTesting" },
  { slug: "ai-ml", key: "nav.aiMl" },
  { slug: "dedicated-teams", key: "nav.dedicatedTeams" },
  { slug: "cybersecurity", key: "nav.cybersecurity" },
  { slug: "modernization", key: "nav.modernization" },
];

// Social links (same as footer)
const menuSocials = [
  { href: "https://linkedin.com", label: "LinkedIn", icon: "ti ti-brand-linkedin" },
  { href: "https://x.com", label: "X", icon: "ti ti-brand-x" },
  { href: "https://instagram.com", label: "Instagram", icon: "ti ti-brand-instagram" },
  { href: "https://github.com", label: "GitHub", icon: "ti ti-brand-github" },
];
---

<!-- menu -->
<div class="tria-menu-frame">

  <!-- frame top: logo + close -->
  <div class="tria-menu-top">
    <a href={lp("/")} class="tria-menu-logo" aria-label="tria">
      <span class="tria-menu-logo-text">tria<span class="tria-menu-logo-dot">.</span></span>
    </a>
    <div class="tria-menu-close">
      <div class="tria-menu-btn" role="button" aria-label="Close menu" tabindex="0">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>

  <div class="tria-menu-content">
    <div class="tria-menu-grid" id="swupMenu">

      <!-- Left: main pages — large type, dot indicator -->
      <nav class="tria-menu-pages" aria-label="Main navigation">
        <ul>
          {pages.map((p) => (
            <li class:list={[{ "tria-current": isCurrentPage(p.href) }]}>
              <a href={lp(p.href)} data-i18n={p.key}>{t(p.key)}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Right: side panel — bordered, bottom anchored -->
      <div class="tria-menu-side">
        <div class="tria-menu-side-inner">

          <!-- Two columns: services | useful links -->
          <div class="tria-menu-columns">

            <!-- Services -->
            <div class="tria-menu-block">
              <h6 class="tria-menu-block-title" data-i18n="nav.services">{t("nav.services")}</h6>
              <ul class="tria-menu-block-list">
                {menuServices.map((s) => (
                  <li>
                    <a href={lp(`/services#${s.slug}`)} data-i18n={s.key}>{t(s.key)}</a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Useful links -->
            <div class="tria-menu-block">
              <h6 class="tria-menu-block-title" data-i18n="nav.usefulLinks">{t("nav.usefulLinks")}</h6>
              <ul class="tria-menu-block-list">
                <li><a href={lp("/privacy")} data-i18n="nav.privacyPolicy">{t("nav.privacyPolicy")}</a></li>
                <li><a href={lp("/terms")} data-i18n="nav.terms">{t("nav.terms")}</a></li>
                <li><a href={lp("/cookies")} data-i18n="nav.cookiePolicy">{t("nav.cookiePolicy")}</a></li>
              </ul>
            </div>

          </div>

          <div class="tria-menu-divider"></div>

          <!-- Bottom meta row: location + lang + socials -->
          <div class="tria-menu-bottom">
            <div class="tria-menu-contact">
              <h6 class="tria-menu-block-title" data-i18n="contact.info.location">{t("contact.info.location")}</h6>
              <p class="tria-menu-contact-text" set:html={t("contact.info.locationValue")}></p>
            </div>
            <div class="tria-menu-bottom-right">
              <div class="tria-menu-lang">
                <span class="tria-menu-lang-label" data-i18n="nav.language">{t("nav.language")}</span>
                <a href={enHref} data-lang="en" class:list={["tria-menu-lang-btn", { "is-active": locale === "en" }]}>EN</a>
                <span class="tria-menu-lang-sep">/</span>
                <a href={esHref} data-lang="es" class:list={["tria-menu-lang-btn", { "is-active": locale === "es" }]}>ES</a>
              </div>
              <div class="tria-menu-socials">
                {menuSocials.map((social) => (
                  <a href={social.href} aria-label={social.label} target="_blank" rel="noopener noreferrer">
                    <i class={social.icon}></i>
                  </a>
                ))}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
<!-- menu end -->

<style is:global>
  /* ═══════════════════════════════════════
     FULLSCREEN MENU — editorial, Ashley-inspired
     ═══════════════════════════════════════ */

  /* ── Frame: solid dark, no effects ── */
  .tria-menu-frame {
    background: #000 !important;
    overflow-y: auto;
    transition: opacity 0.4s cubic-bezier(0, 0, 0.3642, 1) !important;
  }

  /* ── Frame top: logo + close (clone of the outside frame) ── */
  .tria-menu-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding: 50px 60px;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .tria-menu-frame.tria-active .tria-menu-top {
    opacity: 1;
  }

  .tria-menu-logo {
    display: flex !important;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 42px !important;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff !important;
    text-decoration: none;
    pointer-events: all;
  }

  .tria-menu-frame .tria-menu-logo:hover {
    color: #fff !important;
  }

  .tria-menu-logo-dot {
    color: var(--accent) !important;
  }

  .tria-menu-top .tria-menu-close {
    position: static !important;
    top: auto !important;
    right: auto !important;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
  }

  .tria-menu-top .tria-menu-close .tria-menu-btn span {
    background: #fff !important;
  }

  .tria-menu-top .tria-menu-close .tria-menu-btn:hover {
    opacity: 0.7;
  }

  /* ── Content: container-like, fills viewport ── */
  .tria-menu-content {
    position: relative;
    z-index: 1;
    height: 100vh;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
  }

  @media screen and (min-width: 1200px) and (max-width: 1399px) {
    .tria-menu-content {
      max-width: 1000px;
    }
  }

  .tria-menu-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 30px;
    width: 100%;
    height: 100vh;
    align-items: stretch;
  }

  /* ═══════════════════════════════════════
     MAIN PAGES — centered, compact type
     ═══════════════════════════════════════ */
  .tria-menu-pages {
    display: flex;
    align-items: center;
    height: 100vh;
    opacity: 0;
    transform: translateX(-30px);
    transition: transform 0.4s cubic-bezier(0, 0, 0.3642, 1), opacity 0.4s ease;
  }

  .tria-menu-frame.tria-active .tria-menu-pages {
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0.4s;
  }

  .tria-menu-pages ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tria-menu-pages ul li {
    margin-bottom: 30px !important;
  }

  .tria-menu-pages ul li:last-child {
    margin-bottom: 0 !important;
  }

  .tria-menu-pages ul li a {
    display: flex !important;
    align-items: center;
    font-family: var(--font-display);
    font-size: 26px !important;
    font-weight: 500 !important;
    letter-spacing: 0 !important;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8) !important;
    text-decoration: none;
    padding-left: 0;
    transition: color 0.4s cubic-bezier(0, 0, 0.3642, 1), padding-left 0.4s cubic-bezier(0, 0, 0.3642, 1) !important;
  }

  .tria-menu-pages ul li a:hover {
    color: #fff !important;
    padding-left: 20px !important;
  }

  /* ── Current page: accent only ── */
  .tria-menu-pages ul li.tria-current > a {
    color: var(--accent) !important;
    padding-left: 0 !important;
  }

  .tria-menu-pages ul li.tria-current > a:hover {
    color: var(--accent) !important;
    filter: brightness(110%);
    padding-left: 20px !important;
  }

  /* ═══════════════════════════════════════
     SIDE PANEL — bordered, bottom anchored
     ═══════════════════════════════════════ */
  .tria-menu-side {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 60px;
    display: flex;
    align-items: flex-end;
    height: 100vh;
    opacity: 0;
    transform: translateY(30px);
    transition: transform 0.4s cubic-bezier(0, 0, 0.3642, 1), opacity 0.4s ease;
  }

  .tria-menu-frame.tria-active .tria-menu-side {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.6s;
  }

  .tria-menu-side-inner {
    width: 100%;
    padding-bottom: 60px;
  }

  .tria-menu-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  .tria-menu-columns .tria-menu-block {
    margin-bottom: 0;
  }

  .tria-menu-block-title {
    font-size: 18px !important;
    font-weight: 500 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    color: rgba(255, 255, 255, 0.9) !important;
    margin: 0 0 30px !important;
    line-height: 1.5;
  }

  .tria-menu-block-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tria-menu-block-list li {
    margin-bottom: 15px;
  }

  .tria-menu-block-list li:last-child {
    margin-bottom: 0;
  }

  .tria-menu-block-list li a {
    display: block;
    font-size: 16px !important;
    font-weight: 300 !important;
    color: rgba(255, 255, 255, 0.4) !important;
    text-decoration: none;
    line-height: 1.5;
    transition: color 0.2s cubic-bezier(0, 0, 0.3642, 1), transform 0.2s cubic-bezier(0, 0, 0.3642, 1) !important;
  }

  .tria-menu-block-list li a:hover {
    color: #fff !important;
    transform: translateX(5px);
  }

  /* ── Divider + bottom meta row ── */
  .tria-menu-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 0 60px;
  }

  .tria-menu-bottom {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .tria-menu-contact-text {
    margin: 0 !important;
    font-size: 16px !important;
    font-weight: 300 !important;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.4);
  }

  .tria-menu-bottom-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    white-space: nowrap;
  }

  .tria-menu-socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .tria-menu-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.45);
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.35s var(--ease-spring) !important;
  }

  .tria-menu-socials a:hover {
    border-color: rgba(var(--accent-rgb), 0.5);
    color: var(--accent) !important;
    transform: translateY(-3px);
  }

  /* ── Language switcher ── */
  .tria-menu-lang {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tria-menu-lang-label {
    display: none;
  }

  .tria-menu-lang-btn {
    pointer-events: all;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.3s ease;
    padding: 4px 6px;
  }

  .tria-menu-lang-btn.is-active {
    color: var(--accent);
    font-weight: 700;
  }

  .tria-menu-frame .tria-menu-lang-btn:hover {
    color: #fff;
  }

  .tria-menu-lang-sep {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.15);
  }

  /* ═══════════════════════════════════════
     RESPONSIVE — mirrors the reference
     ═══════════════════════════════════════ */

  /* ≤1200px: hide the in-menu top bar (the sticky header covers it),
     hide the right panel and center the main menu — like the reference. */
  @media screen and (max-width: 1200px) {
    .tria-menu-top {
      display: none !important;
    }
    .tria-menu-side {
      display: none;
    }
    .tria-menu-content {
      padding: 0 24px;
    }
    .tria-menu-grid {
      grid-template-columns: 1fr;
      gap: 0;
      height: 100vh;
    }
    .tria-menu-pages {
      justify-content: center;
      padding-left: 0;
    }
    .tria-menu-pages ul {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .tria-menu-pages ul li {
      margin-bottom: 30px !important;
    }
    .tria-menu-pages ul li a {
      justify-content: center;
    }
    .tria-menu-pages ul li.tria-current > a {
      padding-left: 0 !important;
    }
  }

  /* ≤992px: smaller nav type, like the reference */
  @media screen and (max-width: 992px) {
    .tria-menu-pages ul li a {
      font-size: 26px !important;
    }
  }

  /* Short desktop viewport: keep only the main menu (reference hides the right panel) */
  @media screen and (max-height: 800px) and (min-width: 1201px) {
    .tria-menu-side {
      display: none;
    }
  }
</style>
