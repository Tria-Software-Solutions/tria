---
import Footer from "./Footer.astro";
import { createT, localePath } from "../i18n/utils";
const t = createT(Astro.currentLocale);
const locale = Astro.currentLocale || "en";

// Determine current page path for footer filtering
const pathname = Astro.url.pathname;
const path = pathname.replace(/\/+$/, "") || "/";
const barePath = path.startsWith("/es") ? (path.replace(/^\/es/, "") || "/") : path;

// Filter explore links: exclude the current page
const allExploreLinks = [
  { href: "/", label: t("nav.home") || "" },
  { href: "/about", label: t("nav.about") || "" },
  { href: "/services", label: t("nav.services") || "" },
  { href: "/quote", label: t("nav.quote") || "" },
  { href: "/contact", label: t("nav.contact") || "" }
];

function isCurrent(href: string): boolean {
  const cleanHref = href.replace(/\/+$/, "") || "/";
  // Don't filter anchor links (#section) — they're in-page navigation
  if (cleanHref.includes("#")) return false;
  const pathPart = cleanHref.split("#")[0];
  return barePath === pathPart || barePath.startsWith(pathPart + "/");
}

const exploreLinks = allExploreLinks.map((link) => ({ ...link, href: localePath(locale, link.href) }));

// Core services — short list; "All services" link points to the full page
const allServiceLinks = [
  { href: "/services#software-dev", label: t("nav.softwareDev") || "" },
  { href: "/services#uiux-design", label: t("nav.uiuxDesign") || "" },
  { href: "/services#cloud-devops", label: t("nav.cloudDevops") || "" },
  { href: "/services#ai-ml", label: t("nav.aiMl") || "" }
];

const serviceLinks = allServiceLinks
  .filter((link) => !isCurrent(link.href))
  .map((link) => ({ ...link, href: localePath(locale, link.href) }));

const servicesAllLabel = t("nav.allServices") || "";
const servicesAllHref = isCurrent("/services") ? "" : localePath(locale, "/services");

/* ── Page sections for "On this page" column ── */

/* Plain-text version of an i18n key: strip HTML tags (as spaces so
   <br> doesn't join words) and decode common HTML entities. */
function plain(key: string): string {
  return (t(key) || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

/* Labels use the real heading of each section so the "On this page"
   column matches the section titles on the page. */
function getPageSections(): { href: string; label: string }[] {
  const p = barePath;
  const sections: Record<string, { href: string; label: string }[]> = {
    "/": [
      { href: "/#services", label: plain("services.modernSolutions") || "Services" },
      { href: "/#featured", label: plain("featured.title") || "Featured Work" },
      { href: "/#process", label: plain("process.title") || "Process" },
      { href: "/#pricing", label: plain("pricing.heading") || "Pricing" },
      { href: "/#faq", label: "FAQ" }
    ],
    "/services": [
      { href: "/services/#practices", label: plain("services.showcase.heading") || "Capabilities" },
      { href: "/services/#engagement", label: plain("services.engagement.title") || "Engagement" }
    ],
    "/about": [
      { href: "/about#values", label: plain("about.valuesTitle") || "What Drives Us" },
      { href: "/about#culture", label: plain("team.cultureTitle") || "How We Work" },
      { href: "/about#team", label: plain("about.teamTitle") || "Team" },
      { href: "/about#testimonials", label: plain("testimonials.title") || "Testimonials" }
    ],
    "/contact": [
      { href: "/contact#contact-form", label: plain("contact.heading") || "Contact" }
    ]
  };
  return sections[p] || [];
}

const pageSections = getPageSections().map((s) => ({ ...s, href: localePath(locale, s.href) }));
const labelByLocale: Record<string, string> = {
  en: "On this page",
  es: "En esta página",
};
const footerSectionsLabel = labelByLocale[Astro.currentLocale || "en"] || "On this page";

const footerExploreLabel = t("nav.explore") || "";
const footerServicesLabel = t("nav.services") || "";

const footerContactLabel = t("nav.contactInfo") || "";
const footerNewsletterLabel = t("footer.stayInLoop") || "";
const footerNewsletterPlaceholder = t("footer.emailPlaceholder") || "";
const footerNewsletterHeading = t("footer.newsletterHeading") || "";
const footerSocialLabel = t("contact.info.followUs") || "";
const footerBrandDesc = t("footer.description") || "";
const footerCopyright = t("footer.allRights")?.replace("{year}", String(new Date().getFullYear())) || "";
---

<Footer
  brandName="tria"
  brandHref="/"
  brandDescription={footerBrandDesc}
  socialLabel={footerSocialLabel}
  exploreLabel={footerExploreLabel}
  servicesLabel={footerServicesLabel}
  contactLabel={footerContactLabel}
  newsletterLabel={footerNewsletterLabel}
  newsletterPlaceholder={footerNewsletterPlaceholder}
  newsletterHeading={footerNewsletterHeading}
  sectionsLabel={footerSectionsLabel}
  pageSections={pageSections}
  exploreLinks={exploreLinks}
  serviceLinks={serviceLinks}
  servicesAllLabel={servicesAllLabel}
  servicesAllHref={servicesAllHref}
  contactLinks={[
    { href: "#", label: t("footer.contactLink") || "", icon: "ti-mail", mailto: "hola@triacr.com" },
    { href: "#", label: t("footer.supportLink") || "", icon: "ti-headset", mailto: "support@triacr.com" },
    { href: "#", label: t("footer.salesLink") || "", icon: "ti-briefcase", mailto: "sales@triacr.com" }
  ]}
  socialLinks={[
    { href: "https://linkedin.com", label: "LinkedIn", icon: "ti ti-brand-linkedin" },
    { href: "https://x.com", label: "X", icon: "ti ti-brand-x" },
    { href: "https://instagram.com", label: "Instagram", icon: "ti ti-brand-instagram" },
    { href: "https://github.com", label: "GitHub", icon: "ti ti-brand-github" }
  ]}
  copyrightText={footerCopyright}
  legalLinks={[
    { href: "/privacy", label: t("nav.privacyPolicy") || "" },
    { href: "/terms", label: t("nav.terms") || "" },
    { href: "/cookies", label: t("nav.cookiePolicy") || "" }
  ]}
  showGlow={true}
/>
