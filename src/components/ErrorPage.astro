---
interface Props {
  code: string;
  titleKey: string;
  descriptionKey: string;
}

const { code, titleKey, descriptionKey } = Astro.props;
const { createT } = await import("../i18n/utils");
const t = createT(Astro.currentLocale);
const title = t(titleKey);
const description = t(descriptionKey);
---

<section class="tria-error-page" data-section-theme="dark">
  <div class="page-hero-bg">
    <!-- WebGL interactive gradient (canvas injected here) -->
    <div class="tria-hero-bg" data-grad-props='{"color1":"#0f111a","color2":"#1a1d2e","color3":"#1a3538","timeSpeed":1.2,"warpStrength":0.6,"warpFrequency":4,"blendAngle":45,"rotationAmount":300,"noiseScale":1.5,"contrast":1.3,"saturation":0.5,"zoom":0.7,"centerY":-0.1}'></div>
    <div class="page-hero-bg-dots"></div>
    <div class="page-hero-orb page-hero-orb--1" style="width:800px;height:800px;"></div>
    <div class="page-hero-orb page-hero-orb--2" style="width:600px;height:600px;"></div>
    <div class="page-hero-gradient-overlay"></div>
    <div class="tria-hero-grain"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="tria-error-particles"></div>
  </div>

  <div class="container tria-error-inner">
    <div class="tria-center">

      <!-- Status label -->
      <div class="tria-error-eyebrow">HTTP {code}</div>

      <!-- Fuzzy animated title — canvas takes over once ready, crisp h1 stays as fallback -->
      <div class="tria-error-title-wrap" id="triaErrorTitleWrap">
        <h1 class="tria-error-heading" data-i18n={titleKey}>{title}</h1>
        <canvas class="tria-error-canvas" id="triaErrorTitle" data-text={title} aria-hidden="true"></canvas>
      </div>

      <p class="tria-error-desc" data-i18n={descriptionKey}>{description}</p>

      <div class="tria-error-line" aria-hidden="true"></div>

      <!-- Single essential action -->
      <div class="tria-error-actions">
        <a href="/" class="tria-btn tria-btn--primary" data-i18n="error.home">{t("error.home")}</a>
      </div>

    </div>
  </div>
</section>

<style>
  /* ═══════ Full-viewport error page ═══════ */
  .tria-error-page {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(11, 13, 23);
    min-height: 100vh;
    min-height: 100svh;
  }

  .tria-error-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 96px 24px 72px;
  }

  .tria-error-particles {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(6, 142, 140, 0.04) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(6, 142, 140, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.02) 1px, transparent 0);
    background-size: 100% 100%, 100% 100%, 40px 40px;
    pointer-events: none;
  }

  /* ── Status label (plain text, no badge) ── */
  .tria-error-eyebrow {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 44px;
    font-variant-numeric: tabular-nums;
  }

  /* ── Fuzzy title (canvas) with crisp h1 fallback ── */
  .tria-error-title-wrap {
    position: relative;
    text-align: center;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(2.6rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: #fff;
    margin: 0 auto 30px;
    max-width: 100%;
  }
  .tria-error-heading {
    margin: 0;
    /* !important beats the global responsive `h1 { font-size: ... !important }`
       rules so the fallback always matches the fuzzy canvas size */
    font-size: inherit !important;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    color: #fff;
    opacity: 1;
    transition: opacity 0.5s ease;
    text-wrap: balance;
  }
  .tria-error-canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: auto;
  }
  .tria-error-canvas.is-ready { opacity: 1; }
  .tria-error-title-wrap.is-live .tria-error-heading { opacity: 0; }

  /* ── Description ── */
  .tria-error-desc {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.45);
    max-width: 480px;
    margin: 0 auto 30px;
    line-height: 1.7;
    text-wrap: balance;
  }

  .tria-error-line {
    width: 40px;
    height: 2px;
    background: var(--accent);
    margin: 0 auto 36px;
    border-radius: 2px;
    opacity: 0.5;
  }

  /* ── Action: single primary button ── */
  .tria-error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tria-btn--primary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    background-color: var(--accent);
    color: #fff;
    border-radius: 100px;
    padding: 0 2rem;
    height: 48px;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.4s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)), background-color 0.3s ease;
  }
  .tria-btn--primary:hover {
    transform: translateY(-2px);
    background-color: var(--accent-hover, #057573);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 576px) {
    .tria-error-inner { padding: 80px 20px 56px; }
    .tria-error-eyebrow { margin-bottom: 34px; }
    .tria-error-desc { font-size: 0.85rem; }
  }
</style>

<script is:inline>
(function () {
  /* ─────────────────────────────────────────────────────────────
     Fuzzy text — vanilla re-implementation of ReactBits' FuzzyText
     (https://reactbits.dev/text-animations/fuzzy-text).
     The title is drawn to an offscreen canvas, then every frame it
     is redrawn as 1px slices shifted by a random amount. Intensity
     rises when the pointer is over the text.
     ───────────────────────────────────────────────────────────── */
  function initFuzzyTitle(canvas, wrap) {
    var text = (canvas.getAttribute('data-text') || '').trim();
    if (!text) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var style = window.getComputedStyle(canvas);
    var fontFamily = style.fontFamily || '"Outfit", sans-serif';
    var fontSize = parseFloat(style.fontSize) || 64;
    var fontWeight = parseInt(style.fontWeight, 10) || 500;

    var color = '#ffffff';
    var baseIntensity = 0.14;    /* idle shimmer */
    var hoverIntensity = 0.5;    /* pointer near */
    var fuzzRange = 26;          /* max slice displacement (px) */
    var fps = 60;

    var offscreen = document.createElement('canvas');
    var offCtx = offscreen.getContext('2d');
    var fontStr = fontWeight + ' ' + fontSize + 'px ' + fontFamily;

    var W = 0, H = 0, offW = 0, margin = 0, xOffset = 0;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    function measure() {
      offCtx.font = fontStr;
      offCtx.textBaseline = 'alphabetic';
      var m = offCtx.measureText(text);
      var l = m.actualBoundingBoxLeft || 0;
      var r = m.actualBoundingBoxRight || m.width;
      var asc = m.actualBoundingBoxAscent || fontSize;
      var desc = m.actualBoundingBoxDescent || fontSize * 0.2;
      offW = Math.ceil(l + r) + 10;
      H = Math.ceil(asc + desc);
      xOffset = 5;
      offscreen.width = offW;
      offscreen.height = H;
      offCtx.font = fontStr;
      offCtx.textBaseline = 'alphabetic';
      offCtx.fillStyle = color;
      offCtx.fillText(text, xOffset - l, asc);
      margin = fuzzRange + 20;
      W = offW;
      canvas.width = Math.round((W + margin * 2) * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = Math.round(W + margin * 2) + 'px';
    }

    function markLive() {
      canvas.classList.add('is-ready');
      if (wrap) {
        /* hide the crisp fallback once the fuzzy canvas is fully visible */
        setTimeout(function () {
          wrap.classList.add('is-live');
        }, 650);
      }
    }

    function frame(ts) {
      if (ts - last < frameDur) { rafId = requestAnimationFrame(frame); return; }
      last = ts;
      var target = hovering ? hoverIntensity : baseIntensity;
      intensity += (target - intensity) * 0.12;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.translate(margin, 0);
      ctx.clearRect(-fuzzRange - 20, -fuzzRange - 10, W + 2 * (fuzzRange + 20), H + 2 * (fuzzRange + 10));
      /* Horizontal: shift each 1px row left/right (ReactBits default) */
      for (var j = 0; j < H; j++) {
        var dx = Math.floor(intensity * (Math.random() - 0.5) * fuzzRange);
        ctx.drawImage(offscreen, 0, j, offW, 1, dx, j, offW, 1);
      }
      rafId = requestAnimationFrame(frame);
    }

    var rafId = null, last = 0, intensity = baseIntensity, hovering = false;
    var frameDur = 1000 / fps;

    /* Wait for the display font before measuring/drawing */
    var fontsReady = document.fonts && document.fonts.load
      ? document.fonts.load(fontStr).catch(function () { return document.fonts.ready; })
      : Promise.resolve();

    fontsReady.then(function () {
      measure();
      markLive();
      if (reduced) {
        /* static render — no animation */
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.translate(margin, 0);
        ctx.drawImage(offscreen, 0, 0);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        return;
      }
      rafId = requestAnimationFrame(frame);

      /* hover — intensify when the pointer is over the glyphs */
      function onMove(e) {
        var rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        var sx = (W + margin * 2) / rect.width;
        var sy = H / rect.height;
        var x = (e.clientX - rect.left) * sx;
        var y = (e.clientY - rect.top) * sy;
        var l = margin + xOffset;
        hovering = x >= l && x <= l + offW - 10 && y >= 0 && y <= H;
      }
      canvas.addEventListener('mousemove', onMove);
      canvas.addEventListener('mouseleave', function () { hovering = false; });
    });

    /* re-measure when the clamp() font size changes (viewport resize / zoom) */
    var resizeTimer = null;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        var s = window.getComputedStyle(canvas);
        var nf = parseFloat(s.fontSize) || fontSize;
        var ndpr = Math.min(window.devicePixelRatio || 1, 2);
        if (nf !== fontSize || ndpr !== dpr) {
          fontSize = nf;
          dpr = ndpr;
          fontStr = fontWeight + ' ' + fontSize + 'px ' + fontFamily;
          measure();
        }
      }, 200);
    });
  }

  function init() {
    var canvas = document.getElementById('triaErrorTitle');
    var wrap = document.getElementById('triaErrorTitleWrap');
    if (canvas) initFuzzyTitle(canvas, wrap);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
