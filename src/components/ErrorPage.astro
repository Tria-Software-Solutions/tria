---
interface Props {
  code: string;
  titleKey: string;
  descriptionKey: string;
  searchPlaceholderKey?: string;
}

const { code, titleKey, descriptionKey, searchPlaceholderKey = "error.searchPlaceholder" } = Astro.props;
const { createT } = await import("../i18n/utils");
const t = createT(Astro.currentLocale);
---

<section class="page-hero" data-section-theme="dark">
  <div class="page-hero-bg">
    <!-- WebGL interactive gradient (canvas injected here) -->
    <div class="tria-hero-bg" data-grad-props='{"color1":"#0f111a","color2":"#1a1d2e","color3":"#1a3538","timeSpeed":1.2,"warpStrength":0.6,"warpFrequency":4,"blendAngle":45,"rotationAmount":300,"noiseScale":1.5,"contrast":1.3,"saturation":0.5,"zoom":0.7,"centerY":-0.1}'></div>
    <div class="page-hero-bg-dots"></div>
    <div class="page-hero-orb page-hero-orb--1" style="width:800px;height:800px;"></div>
    <div class="page-hero-orb page-hero-orb--2" style="width:600px;height:600px;"></div>
    <div class="page-hero-gradient-overlay"></div>
    <div class="tria-hero-grain"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="tria-error-particles"></div>
  </div>
  <div class="container page-hero-inner">
    <div class="tria-center">
      <div class="tria-error-code" aria-hidden="true">{code}</div>
      <h1 class="tria-error-title" data-i18n={titleKey}>{t(titleKey)}</h1>
      <p class="tria-error-desc" data-i18n={descriptionKey}>{t(descriptionKey)}</p>
      <div class="tria-error-line"></div>

      <!-- Navigation links -->
      <div class="tria-error-links">
        <a href="/" class="tria-btn tria-btn--primary" data-i18n="error.home">{t("error.home")}</a>
        <a href="/portfolio" class="tria-error-link">
          <span data-i18n="error.portfolio">{t("error.portfolio")}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/services" class="tria-error-link">
          <span data-i18n="error.services">{t("error.services")}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/contact" class="tria-error-link">
          <span data-i18n="error.contact">{t("error.contact")}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Search -->
      <div class="tria-error-search-wrap">
        <div class="tria-error-search">
          <svg class="tria-error-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" class="tria-error-search-input" id="triaErrorSearch" data-i18n-placeholder={searchPlaceholderKey} placeholder={t(searchPlaceholderKey)} aria-label={t(searchPlaceholderKey)} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tria-error-particles {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(6, 142, 140, 0.04) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(6, 142, 140, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.02) 1px, transparent 0);
    background-size: 100% 100%, 100% 100%, 40px 40px;
    pointer-events: none;
  }

  .tria-error-code {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(6rem, 18vw, 12rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 8px;
    position: relative;
    animation: tria-error-float 4s ease-in-out infinite;
    text-shadow: 0 0 80px rgba(6, 142, 140, 0.15);
  }

  @keyframes tria-error-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .tria-error-title {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 450;
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .tria-error-desc {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.4);
    max-width: 480px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }

  .tria-error-line {
    width: 40px;
    height: 2px;
    background: var(--accent);
    margin: 0 auto 32px;
    border-radius: 2px;
    opacity: 0.5;
  }

  .tria-error-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }

  .tria-error-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    text-decoration: none;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .tria-error-link:hover {
    color: var(--accent);
    gap: 12px;
  }

  .tria-error-link svg {
    transition: transform 0.3s ease;
  }

  .tria-error-link:hover svg {
    transform: translateX(4px);
  }

  .tria-btn--primary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    background-color: var(--accent);
    color: #fff;
    border-radius: 100px;
    padding: 0 2rem;
    height: 48px;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.4s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .tria-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
  }

  /* ── Search ── */
  .tria-error-search-wrap {
    display: flex;
    justify-content: center;
  }

  .tria-error-search {
    position: relative;
    width: 100%;
    max-width: 360px;
  }

  .tria-error-search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.2);
    pointer-events: none;
  }

  .tria-error-search-input {
    width: 100%;
    height: 50px;
    padding: 0 18px 0 46px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 60px;
    background: rgba(255,255,255,0.04);
    color: #fff;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.85rem;
    font-weight: 380;
    outline: none;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    letter-spacing: 0.01em;
  }

  .tria-error-search-input::placeholder {
    color: rgba(255,255,255,0.15);
    font-weight: 380;
  }

  .tria-error-search-input:focus {
    border-color: rgba(6,142,140,0.3);
    background: rgba(255,255,255,0.06);
    box-shadow: 0 0 0 6px rgba(6,142,140,0.03), inset 0 0 0 1px rgba(6,142,140,0.05);
  }

  @media (max-width: 576px) {
    .tria-error-desc {
      font-size: 0.85rem;
    }
    .tria-error-links {
      gap: 14px;
    }
    .tria-error-link {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 400px) {
    .tria-error-code {
      font-size: 5rem;
    }
    .tria-error-title {
      font-size: 1.1rem;
    }
  }
</style>

<script is:inline>
(function() {
  var input = document.getElementById('triaErrorSearch');
  if (!input) return;

  function handleSearch(query) {
    if (!query || query.trim() === '') return;
    window.location.href = '/?s=' + encodeURIComponent(query.trim());
  }

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      handleSearch(this.value);
    }
  });
})();
</script>
