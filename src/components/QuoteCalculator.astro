---
import Button from "./Button.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";

/* ── Project type (base price + timeline) ── */
const types = [
  {
    key: 'landing', label: t("quote.typeLanding"), desc: t("quote.typeLandingDesc"), base: 700, weeks: [2, 4],
    includes: [], scale: 'screens',
    groups: ['screens', 'complexity', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'website', label: t("quote.typeWebsite"), desc: t("quote.typeWebsiteDesc"), base: 1500, weeks: [3, 6],
    includes: ['landing'], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'ecommerce', label: t("quote.typeEcommerce"), desc: t("quote.typeEcommerceDesc"), base: 2500, weeks: [6, 10],
    includes: ['website', 'landing'], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'webapp', label: t("quote.typeWebapp"), desc: t("quote.typeWebappDesc"), base: 5000, weeks: [8, 14],
    includes: [], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'mobile', label: t("quote.typeMobile"), desc: t("quote.typeMobileDesc"), base: 6000, weeks: [10, 16],
    includes: [], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'backend', label: t("quote.typeBackend"), desc: t("quote.typeBackendDesc"), base: 3000, weeks: [6, 12],
    includes: [], scale: 'endpoints',
    groups: ['endpoints', 'complexity', 'users', 'deadline', 'integrations', 'features']
  },
  {
    key: 'desktop', label: t("quote.typeDesktop"), desc: t("quote.typeDesktopDesc"), base: 4000, weeks: [8, 14],
    includes: [], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
  {
    key: 'ai', label: t("quote.typeAi"), desc: t("quote.typeAiDesc"), base: 4000, weeks: [8, 16],
    includes: [], scale: 'endpoints',
    groups: ['endpoints', 'complexity', 'users', 'deadline', 'integrations', 'features']
  },
  {
    key: 'cloud', label: t("quote.typeCloud"), desc: t("quote.typeCloudDesc"), base: 3000, weeks: [4, 10],
    includes: [], scale: 'infra',
    groups: ['infra', 'complexity', 'users', 'deadline', 'integrations', 'features']
  },
  {
    key: 'data', label: t("quote.typeData"), desc: t("quote.typeDataDesc"), base: 3000, weeks: [6, 12],
    includes: [], scale: 'infra',
    groups: ['infra', 'complexity', 'users', 'deadline', 'integrations', 'features']
  },
  {
    key: 'security', label: t("quote.typeSecurity"), desc: t("quote.typeSecurityDesc"), base: 3000, weeks: [4, 10],
    includes: [], scale: 'infra',
    groups: ['infra', 'complexity', 'deadline', 'integrations', 'features']
  },
  {
    key: 'custom', label: t("quote.typeCustom"), desc: t("quote.typeCustomDesc"), base: 10000, weeks: [12, 24],
    includes: [], scale: 'screens',
    groups: ['screens', 'complexity', 'users', 'deadline', 'design', 'integrations', 'features']
  },
];

/* ── Screens & pages (slider levels) ── */
const screens = [
  { key: 's1', label: t("quote.screens1"), desc: t("quote.screens1Desc"), mult: 1 },
  { key: 's2', label: t("quote.screens2"), desc: t("quote.screens2Desc"), mult: 1.1 },
  { key: 's3', label: t("quote.screens3"), desc: t("quote.screens3Desc"), mult: 1.25 },
  { key: 's4', label: t("quote.screens4"), desc: t("quote.screens4Desc"), mult: 1.45 },
  { key: 's5', label: t("quote.screens5"), desc: t("quote.screens5Desc"), mult: 1.65 },
];

/* ── API / endpoints scale (backend, AI) ── */
const endpoints = [
  { key: 'e1', label: t("quote.endpoints1"), desc: t("quote.endpoints1Desc"), mult: 1 },
  { key: 'e2', label: t("quote.endpoints2"), desc: t("quote.endpoints2Desc"), mult: 1.1 },
  { key: 'e3', label: t("quote.endpoints3"), desc: t("quote.endpoints3Desc"), mult: 1.25 },
  { key: 'e4', label: t("quote.endpoints4"), desc: t("quote.endpoints4Desc"), mult: 1.45 },
];

/* ── Infrastructure / data scale (cloud, data, security) ── */
const infras = [
  { key: 'i1', label: t("quote.infra1"), desc: t("quote.infra1Desc"), mult: 1 },
  { key: 'i2', label: t("quote.infra2"), desc: t("quote.infra2Desc"), mult: 1.1 },
  { key: 'i3', label: t("quote.infra3"), desc: t("quote.infra3Desc"), mult: 1.25 },
  { key: 'i4', label: t("quote.infra4"), desc: t("quote.infra4Desc"), mult: 1.45 },
];

/* Format a base price as USD, e.g. 7500 -> "$7,500" */
function fmtUsd(n: number): string {
  return '$' + n.toLocaleString('en-US');
}

const fromLabel = t("pricing.fromLabel");

/* Which feature add-ons make sense per project type */
const featureTypes: Record<string, string[]> = {
  auth: ['webapp', 'ecommerce', 'mobile', 'desktop', 'custom'],
  admin: ['webapp', 'ecommerce', 'mobile', 'desktop', 'backend', 'data', 'custom'],
  payments: ['ecommerce', 'webapp', 'mobile', 'custom'],
  integrations: ['landing', 'website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'backend', 'ai', 'cloud', 'data', 'custom'],
  cms: ['website', 'ecommerce', 'custom'],
  multilang: ['website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'custom'],
  uiux: ['landing', 'website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'custom'],
  seo: ['landing', 'website', 'ecommerce', 'webapp', 'custom'],
  analytics: ['landing', 'website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'backend', 'ai', 'cloud', 'data', 'custom'],
  security: ['ecommerce', 'webapp', 'mobile', 'desktop', 'backend', 'ai', 'cloud', 'data', 'security', 'custom'],
  support: ['landing', 'website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'backend', 'ai', 'cloud', 'data', 'security', 'custom'],
  maintenance: ['landing', 'website', 'ecommerce', 'webapp', 'mobile', 'desktop', 'backend', 'ai', 'cloud', 'data', 'security', 'custom'],
};

/* Features already covered by each project type's BASE price. They are shown
   as "Included" in the wizard and are never charged again as add-ons — this
   prevents double-counting (e.g. an E-commerce already includes payments and
   customer accounts, so selecting those features costs $0). Inheritance:
   types that include other types (ecommerce → website → landing) inherit their
   included features too. */
const includedFeatures: Record<string, string[]> = {
  landing: ['seo', 'analytics'],
  website: ['cms', 'seo', 'analytics'],
  ecommerce: ['payments', 'auth', 'admin', 'cms', 'seo', 'analytics'],
  webapp: ['auth', 'admin', 'analytics'],
  mobile: ['auth', 'analytics'],
  backend: ['security'],
  desktop: ['auth'],
  ai: ['integrations', 'analytics'],
  cloud: ['security', 'analytics'],
  data: ['integrations', 'analytics'],
  security: ['security'],
  custom: [],
};

/* ── Complexity ── */
const complexities = [
  { key: 'basic', label: t("quote.complexityBasic"), desc: t("quote.complexityBasicDesc"), mult: 1 },
  { key: 'standard', label: t("quote.complexityStandard"), desc: t("quote.complexityStandardDesc"), mult: 1.1 },
  { key: 'advanced', label: t("quote.complexityAdvanced"), desc: t("quote.complexityAdvancedDesc"), mult: 1.25 },
];

/* ── Expected users ── */
const users = [
  { key: 'u1', label: t("quote.users1"), desc: t("quote.users1Desc"), mult: 1 },
  { key: 'u2', label: t("quote.users2"), desc: t("quote.users2Desc"), mult: 1.05 },
  { key: 'u3', label: t("quote.users3"), desc: t("quote.users3Desc"), mult: 1.15 },
  { key: 'u4', label: t("quote.users4"), desc: t("quote.users4Desc"), mult: 1.3 },
  { key: 'u5', label: t("quote.users5"), desc: t("quote.users5Desc"), mult: 1.45 },
];

/* ── Deadline ── */
const deadlines = [
  { key: 'd1', label: t("quote.deadline1"), desc: t("quote.deadline1Desc"), mult: 0.95 },
  { key: 'd2', label: t("quote.deadline2"), desc: t("quote.deadline2Desc"), mult: 1 },
  { key: 'd3', label: t("quote.deadline3"), desc: t("quote.deadline3Desc"), mult: 1.1 },
  { key: 'd4', label: t("quote.deadline4"), desc: t("quote.deadline4Desc"), mult: 1.2 },
];

/* ── UI/UX design ── */
const designs = [
  { key: 'ds1', label: t("quote.design1"), desc: t("quote.design1Desc"), mult: 0.97 },
  { key: 'ds2', label: t("quote.design2"), desc: t("quote.design2Desc"), mult: 1 },
  { key: 'ds3', label: t("quote.design3"), desc: t("quote.design3Desc"), mult: 1.12 },
];

/* ── Integrations ── */
const integrations = [
  { key: 'i1', label: t("quote.integrations1"), desc: t("quote.integrations1Desc"), mult: 1 },
  { key: 'i2', label: t("quote.integrations2"), desc: t("quote.integrations2Desc"), mult: 1.05 },
  { key: 'i3', label: t("quote.integrations3"), desc: t("quote.integrations3Desc"), mult: 1.12 },
  { key: 'i4', label: t("quote.integrations4"), desc: t("quote.integrations4Desc"), mult: 1.25 },
];

/* ── Features (additive) ── */
const features = [
  { key: 'auth', label: t("quote.featureAuth"), price: 300 },
  { key: 'admin', label: t("quote.featureAdmin"), price: 400 },
  { key: 'payments', label: t("quote.featurePayments"), price: 350 },
  { key: 'integrations', label: t("quote.featureIntegrations"), price: 300 },
  { key: 'cms', label: t("quote.featureCms"), price: 250 },
  { key: 'multilang', label: t("quote.featureMultilang"), price: 200 },
  { key: 'uiux', label: t("quote.featureUiux"), price: 500 },
  { key: 'seo', label: t("quote.featureSeo"), price: 200 },
  { key: 'analytics', label: t("quote.featureAnalytics"), price: 180 },
  { key: 'security', label: t("quote.featureSecurity"), price: 300 },
  { key: 'support', label: t("quote.featureSupport"), price: 250 },
  { key: 'maintenance', label: t("quote.featureMaintenance"), price: 250 },
];

interface Props {
  showHeader?: boolean;
}

const { showHeader = false } = Astro.props;

/* Approx. USD→CRC exchange rate (2025-26), used for the colones equivalent */
const crcRate = 510;

const quoteTexts = {
  weeks: t("quote.resultTimelineValue"),
  next: t("quote.next"),
  sendCta: t("quote.sendCta"),
  sending: t("quote.sending"),
  successTitle: t("quote.successTitle"),
  successText: t("quote.successText"),
  contactRequired: t("quote.contactRequired"),
  total: t("quote.resultTotal"),
  more: "+{n}",
  barLabel: t("quote.barLabel"),
  sheetClose: t("quote.sheetClose"),
  resultEmpty: t("quote.resultEmpty"),
  typeLabel: t("quote.resultType"),
  companyLabel: t("quote.contactCompany"),
  phoneLabel: t("quote.contactPhone"),
  notesLabel: t("quote.contactNotes"),
  sections: {
    base: t("quote.resultBase"),
    screens: t("quote.resultScreens"),
    complexity: t("quote.resultComplexity"),
    users: t("quote.resultUsers"),
    deadline: t("quote.resultDeadline"),
    design: t("quote.resultDesign"),
    integrations: t("quote.resultIntegrations"),
    features: t("quote.resultFeatures"),
  },
  included: t("quote.typeIncluded"),
};

const screensData = screens.map((s) => ({ key: s.key, label: s.label, desc: s.desc, mult: s.mult }));
const endpointsData = endpoints.map((e) => ({ key: e.key, label: e.label, desc: e.desc, mult: e.mult }));
const infrasData = infras.map((ig) => ({ key: ig.key, label: ig.label, desc: ig.desc, mult: ig.mult }));
const scaleData: Record<string, { key: string; label: string; desc: string; mult: number }[]> = {
  screens: screensData,
  endpoints: endpointsData,
  infra: infrasData,
};
const typeScaleMap: Record<string, string> = {};
types.forEach((t) => { typeScaleMap[t.key] = t.scale; });
const typeGroupMap: Record<string, string[]> = {};
types.forEach((t) => { typeGroupMap[t.key] = t.groups; });
const typeIncludeMap: Record<string, string[]> = {};
types.forEach((t) => { typeIncludeMap[t.key] = t.includes; });

/* Minimal line icons per project type (24×24, stroke-based) — inner SVG markup */
const typeIcons: Record<string, string> = {
  landing:
    '<rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M3 9h18M8 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  website:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle><path d="M3 12h18M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.5-4-9s1.5-6.5 4-9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>',
  ecommerce:
    '<path d="M6 8h12l-1 12.5H7L6 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  webapp:
    '<rect x="4" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>',
  mobile:
    '<rect x="7" y="2.5" width="10" height="19" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M11 18.5h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  backend:
    '<rect x="3" y="4" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5"></rect><rect x="3" y="13" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 7.5h.01M7 16.5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>',
  desktop:
    '<rect x="3" y="4" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 20h8M12 16v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  ai:
    '<rect x="6" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5"></rect><rect x="10" y="10" width="4" height="4" stroke="currentColor" stroke-width="1.5"></rect><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  cloud:
    '<path d="M6.5 18.5a4.5 4.5 0 0 1-.6-8.96 6 6 0 0 1 11.63 1.63A3.8 3.8 0 0 1 17.5 18.5h-11z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>',
  data:
    '<ellipse cx="12" cy="5.5" rx="8" ry="3" stroke="currentColor" stroke-width="1.5"></ellipse><path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13" stroke="currentColor" stroke-width="1.5"></path><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" stroke="currentColor" stroke-width="1.5"></path>',
  security:
    '<path d="M12 3l7 2.8v5c0 4.6-3 8.2-7 10.2-4-2-7-5.6-7-10.2v-5L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M9 12l2.2 2.2L15 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>',
  custom:
    '<path d="M12 3l9 5-9 5-9-5 9-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>',
};

function typeIconSvg(key: string) {
  const inner = typeIcons[key] || typeIcons.landing;
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">${inner}</svg>`;
}
---

<section id="quote" class="tria-quote-section" data-section-theme="light">
  <div class="tria-quote-glow tria-quote-glow--1"></div>
  <div class="tria-quote-glow tria-quote-glow--2"></div>
  <div class="container tria-p-120-120">
    {showHeader && (
      <div class="tria-quote-header">
        <div class="row justify-content-between">
          <div class="col-lg-7">
            <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="quote.suptitle">{t("quote.suptitle")}</span>
            <h2 class="tria-up tria-mt-30" set:html={t("quote.heading")} />
          </div>
          <div class="col-lg-4 tria-quote-intro-col">
            <p class="tria-up tria-quote-intro" data-i18n="quote.description">{t("quote.description")}</p>
          </div>
        </div>
      </div>
    )}

    <div class="tria-quote-shell tria-up" id="tria-quote-shell">
      {/* ── Wizard column ── */}
      <div class="tria-quote-wizard">
        <form class="tria-quote-form" id="tria-quote-form" novalidate>
          {/* Step 1 — Type */}
          <div class="tria-quiz-step is-active" data-step="1" tabindex="-1">
            <div class="tria-quiz-step-head">
              <div>
                <h3 class="tria-quiz-step-title" data-i18n="quote.wizardType">{t("quote.wizardType")}</h3>
                <p class="tria-quiz-step-hint" data-i18n="quote.hintType">{t("quote.hintType")}</p>
              </div>
            </div>
            <div class="tria-quiz-step-body">
            <div class="tria-quote-types">
              {types.map((type) => (
                <label class="tria-quote-type">
                  <input type="checkbox" name="types" value={type.key} data-base={type.base} data-weeks={JSON.stringify(type.weeks)} data-label={type.label} />
                  <span class="tria-quote-type-card">
                    <span class="tria-quote-type-icon" set:html={typeIconSvg(type.key)}></span>
                    <span class="tria-quote-type-copy">
                      <span class="tria-quote-type-name-row">
                        <span class="tria-quote-type-name">{type.label}</span>
                        <span class="tria-quote-type-included" data-included-badge hidden data-i18n="quote.typeIncluded">{t("quote.typeIncluded")}</span>
                      </span>
                      <span class="tria-quote-type-desc">{type.desc}</span>
                      <span class="tria-quote-type-price">{fromLabel} {fmtUsd(type.base)}</span>
                    </span>
                    <span class="tria-quote-type-radio" aria-hidden="true">
                      <svg width="10" height="10" viewBox="0 0 16 16" fill="none">
                        <path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </span>
                </label>
              ))}
            </div>
            </div>
          </div>

          {/* Step 2 — Scope (screens + complexity) */}
          <div class="tria-quiz-step" data-step="2" tabindex="-1">
            <div class="tria-quiz-step-head">
              <div>
                <h3 class="tria-quiz-step-title" data-i18n="quote.wizardScope">{t("quote.wizardScope")}</h3>
                <p class="tria-quiz-step-hint" data-i18n="quote.hintScope">{t("quote.hintScope")}</p>
              </div>
            </div>
            <div class="tria-quiz-step-body">
              <div class="tria-quote-group" data-group="screens">
                <span class="tria-quote-group-label" data-i18n="quote.wizardScreens">{t("quote.wizardScreens")}</span>
                <div class="tria-quote-pills">
                  {screens.map((s) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="screens" value={s.key} data-mult={s.mult} data-label={s.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{s.label}</span>
                        <span class="tria-quote-pill-desc">{s.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
              <div class="tria-quote-group" data-group="endpoints" hidden>
                <span class="tria-quote-group-label" data-i18n="quote.wizardEndpoints">{t("quote.wizardEndpoints")}</span>
                <div class="tria-quote-pills">
                  {endpoints.map((e) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="endpoints" value={e.key} data-mult={e.mult} data-label={e.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{e.label}</span>
                        <span class="tria-quote-pill-desc">{e.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
              <div class="tria-quote-group" data-group="infra" hidden>
                <span class="tria-quote-group-label" data-i18n="quote.wizardInfra">{t("quote.wizardInfra")}</span>
                <div class="tria-quote-pills">
                  {infras.map((ig) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="infra" value={ig.key} data-mult={ig.mult} data-label={ig.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{ig.label}</span>
                        <span class="tria-quote-pill-desc">{ig.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
              <div class="tria-quote-group" data-group="complexity">
                <span class="tria-quote-group-label" data-i18n="quote.wizardComplexity">{t("quote.wizardComplexity")}</span>
                <div class="tria-quote-pills">
                  {complexities.map((c) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="complexity" value={c.key} data-mult={c.mult} data-label={c.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{c.label}</span>
                        <span class="tria-quote-pill-desc">{c.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Step 3 — Timing (users + deadline + design) */}
          <div class="tria-quiz-step" data-step="3" tabindex="-1">
            <div class="tria-quiz-step-head">
              <div>
                <h3 class="tria-quiz-step-title" data-i18n="quote.wizardTiming">{t("quote.wizardTiming")}</h3>
                <p class="tria-quiz-step-hint" data-i18n="quote.hintTiming">{t("quote.hintTiming")}</p>
              </div>
            </div>
            <div class="tria-quiz-step-body">
              <div class="tria-quote-group" data-group="users">
                  <span class="tria-quote-group-label" data-i18n="quote.wizardUsers">{t("quote.wizardUsers")}</span>
                  <div class="tria-quote-pills">
                    {users.map((u) => (
                      <label class="tria-quote-pill">
                        <input type="radio" name="users" value={u.key} data-mult={u.mult} data-label={u.label} />
                        <span class="tria-quote-pill-inner">
                          <span class="tria-quote-pill-name">{u.label}</span>
                          <span class="tria-quote-pill-desc">{u.desc}</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </div>
                <div class="tria-quote-group" data-group="deadline">
                  <span class="tria-quote-group-label" data-i18n="quote.wizardDeadline">{t("quote.wizardDeadline")}</span>
                  <div class="tria-quote-pills">
                    {deadlines.map((dl) => (
                      <label class="tria-quote-pill">
                        <input type="radio" name="deadline" value={dl.key} data-mult={dl.mult} data-label={dl.label} />
                        <span class="tria-quote-pill-inner">
                          <span class="tria-quote-pill-name">{dl.label}</span>
                          <span class="tria-quote-pill-desc">{dl.desc}</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </div>
              <div class="tria-quote-group" data-group="design">
                <span class="tria-quote-group-label" data-i18n="quote.wizardDesign">{t("quote.wizardDesign")}</span>
                <div class="tria-quote-pills">
                  {designs.map((ds) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="design" value={ds.key} data-mult={ds.mult} data-label={ds.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{ds.label}</span>
                        <span class="tria-quote-pill-desc">{ds.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Step 4 — Extras (integrations + features) */}
          <div class="tria-quiz-step" data-step="4" tabindex="-1">
            <div class="tria-quiz-step-head">
              <div>
                <h3 class="tria-quiz-step-title" data-i18n="quote.wizardExtras">{t("quote.wizardExtras")}</h3>
                <p class="tria-quiz-step-hint" data-i18n="quote.hintExtras">{t("quote.hintExtras")}</p>
              </div>
            </div>
            <div class="tria-quiz-step-body">
              <div class="tria-quote-group" data-group="integrations">
                <span class="tria-quote-group-label" data-i18n="quote.wizardIntegrations">{t("quote.wizardIntegrations")}</span>
                <div class="tria-quote-pills">
                  {integrations.map((ig) => (
                    <label class="tria-quote-pill">
                      <input type="radio" name="integrations" value={ig.key} data-mult={ig.mult} data-label={ig.label} />
                      <span class="tria-quote-pill-inner">
                        <span class="tria-quote-pill-name">{ig.label}</span>
                        <span class="tria-quote-pill-desc">{ig.desc}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
              <div class="tria-quote-group" data-group="features">
                <span class="tria-quote-group-label" data-i18n="quote.wizardFeatures">{t("quote.wizardFeatures")}</span>
                <div class="tria-quote-features">
                  {features.map((f) => (
                    <label class="tria-quote-feature">
                      <input type="checkbox" name="features" value={f.key} data-price={f.price} data-label={f.label} />
                      <span class="tria-quote-feature-check">
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span class="tria-quote-feature-copy">
                        <span class="tria-quote-feature-name">{f.label}</span>
                        <span class="tria-quote-feature-price">{fmtUsd(f.price)}</span>
                        <span class="tria-quote-feature-included" data-feature-included hidden data-i18n="quote.typeIncluded">{t("quote.typeIncluded")}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Step 5 — Contact */}
          <div class="tria-quiz-step" data-step="5" tabindex="-1">
            <div class="tria-quiz-step-head">
              <div>
                <h3 class="tria-quiz-step-title" data-i18n="quote.wizardContact">{t("quote.wizardContact")}</h3>
                <p class="tria-quiz-step-hint" data-i18n="quote.hintContact">{t("quote.hintContact")}</p>
              </div>
            </div>
            <div class="tria-quiz-step-body">
            <div class="tria-quote-contact">
              <div class="tria-quote-contact-row">
                <div class="tria-quote-field">
                  <label class="tria-quote-field-label" for="quote-name" data-i18n="quote.contactName">{t("quote.contactName")}</label>
                  <input class="tria-quote-input" type="text" id="quote-name" name="name" autocomplete="name" data-i18n-placeholder="quote.contactNamePh" placeholder={t("quote.contactNamePh")} />
                </div>
                <div class="tria-quote-field">
                  <label class="tria-quote-field-label" for="quote-email" data-i18n="quote.contactEmail">{t("quote.contactEmail")}</label>
                  <input class="tria-quote-input" type="email" id="quote-email" name="email" autocomplete="email" data-i18n-placeholder="quote.contactEmailPh" placeholder={t("quote.contactEmailPh")} />
                </div>
              </div>
              <div class="tria-quote-contact-row">
                <div class="tria-quote-field">
                  <label class="tria-quote-field-label" for="quote-company" data-i18n="quote.contactCompany">{t("quote.contactCompany")}</label>
                  <input class="tria-quote-input" type="text" id="quote-company" name="company" autocomplete="organization" data-i18n-placeholder="quote.contactCompanyPh" placeholder={t("quote.contactCompanyPh")} />
                </div>
                <div class="tria-quote-field">
                  <label class="tria-quote-field-label" for="quote-phone" data-i18n="quote.contactPhone">{t("quote.contactPhone")}</label>
                  <input class="tria-quote-input" type="tel" id="quote-phone" name="phone" autocomplete="tel" data-i18n-placeholder="quote.contactPhonePh" placeholder={t("quote.contactPhonePh")} />
                </div>
              </div>
              <div class="tria-quote-field tria-quote-field--notes">
                <label class="tria-quote-field-label" for="quote-notes" data-i18n="quote.contactNotes">{t("quote.contactNotes")}</label>
                <textarea class="tria-quote-input tria-quote-textarea" id="quote-notes" name="notes" rows="2" data-i18n-placeholder="quote.contactNotesPh" placeholder={t("quote.contactNotesPh")}></textarea>
              </div>
              <p class="tria-quote-contact-error" id="quote-contact-error" role="alert"></p>

              <Button text={t("quote.sendCta")} type="submit" variant="primary" size="md" fullWidth={true} showArrow={true} id="quote-submit" className="tria-quote-submit" />
            </div>
            </div>
          </div>
        </form>

        <!-- Wizard nav — same prev/next as featured work, centered with step count -->
        <div class="tria-quote-nav">
          <button type="button" class="tria-quote-nav-btn tria-quote-nav-btn--prev" id="quote-prev" aria-label={t("quote.back")}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="tria-quote-nav-text" data-i18n="quote.back">{t("quote.back")}</span>
          </button>
          <button type="submit" form="tria-quote-form" class="tria-quote-nav-btn tria-quote-nav-btn--next" id="quote-next">
            <span class="tria-quote-nav-text" data-i18n="quote.next">{t("quote.next")}</span>
            <svg class="tria-quote-nav-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      {/* ── Estimate panel (invoice style) ── */}
      <aside class="tria-quote-result" id="tria-quote-result" aria-live="polite">
        <div class="tria-quote-result-head">
          <div>
            <span class="tria-quote-result-kicker" data-i18n="quote.resultLabel">{t("quote.resultLabel")}</span>
            <span class="tria-quote-result-docno" id="quote-docno"></span>
          </div>
          <span class="tria-quote-result-date" id="quote-docdate"></span>
        </div>

        <div class="tria-quote-result-empty" id="quote-result-empty" data-i18n="quote.resultEmpty">{t("quote.resultEmpty")}</div>

        <div class="tria-quote-result-range" id="quote-range">$0</div>
        <span class="tria-quote-result-crc" id="quote-crc"></span>

        <div class="tria-quote-result-timeline">
          <span class="tria-quote-result-timeline-label" data-i18n="quote.resultTimeline">{t("quote.resultTimeline")}</span>
          <span class="tria-quote-result-timeline-value" id="quote-weeks"></span>
        </div>

        <div class="tria-quote-bd-wrap">
          <ul class="tria-quote-result-breakdown" id="quote-breakdown"></ul>
          <div class="tria-quote-bd-summary">
            <span class="tria-quote-bd-subtotal">
              <span data-i18n="quote.bdSubtotal">{t("quote.bdSubtotal")}</span>
              <span id="quote-subtotal">$0</span>
            </span>
            <span class="tria-quote-bd-total-row">
              <span data-i18n="quote.resultTotal">{t("quote.resultTotal")}</span>
              <span class="tria-quote-bd-total-val">
                <span id="quote-total">$0</span>
                <span class="tria-quote-bd-total-crc" id="quote-total-crc"></span>
              </span>
            </span>
          </div>
        </div>

        <p class="tria-quote-result-disclaimer" data-i18n="quote.resultDisclaimer">{t("quote.resultDisclaimer")}</p>

        <button type="button" class="tria-quote-reset" id="quote-reset" data-i18n="quote.resultReset">{t("quote.resultReset")}</button>
      </aside>
    </div>

    {/* ── Mobile summary bar — fixed bottom pill; opens the invoice as a bottom sheet ── */}
    <button type="button" class="tria-quote-bar" id="tria-quote-bar" aria-expanded="false" aria-controls="tria-quote-result">
      <span class="tria-quote-bar-copy">
        <span class="tria-quote-bar-label" data-i18n="quote.barLabel">{t("quote.barLabel")}</span>
        <span class="tria-quote-bar-total" id="quote-bar-total">$0</span>
      </span>
      <span class="tria-quote-bar-step" id="quote-bar-step">01 / 05</span>
      <span class="tria-quote-bar-chev" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
          <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>

    {/* ── Success state ── */}
    <div class="tria-quote-success" id="tria-quote-success" hidden>
      <div class="tria-quote-success-card">
        <span class="tria-quote-success-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3 class="tria-quote-success-title" data-i18n="quote.successTitle">{t("quote.successTitle")}</h3>
        <p class="tria-quote-success-text" data-i18n="quote.successText">{t("quote.successText")}</p>
        <button type="button" class="tria-quote-success-reset" id="quote-success-reset" data-i18n="quote.resultReset">{t("quote.resultReset")}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .tria-quote-section {
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  .tria-quote-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.04) 1px, transparent 0);
    background-size: 36px 36px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 30% 0%, black 15%, transparent 65%);
    -webkit-mask-image: radial-gradient(ellipse at 30% 0%, black 15%, transparent 65%);
  }

  .tria-quote-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    opacity: 0.1;
  }

  .tria-quote-glow--1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #068e8c 0%, transparent 70%);
    top: -200px;
    right: -140px;
  }

  .tria-quote-glow--2 {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, #068e8c 0%, transparent 70%);
    bottom: -180px;
    left: -120px;
  }

  .tria-quote-section .tria-suptitle::before {
    background-color: rgba(6, 142, 140, 0.35);
  }

  .tria-quote-section h2 {
    color: #0b0d17;
  }

  .tria-quote-section :global(.tria-thin) {
    color: rgba(0, 0, 0, 0.25);
    font-weight: 300;
  }

  .tria-quote-header {
    margin-bottom: 72px;
    position: relative;
    z-index: 1;
  }

  .tria-quote-section .container.tria-p-120-120 {
    padding-top: 32px;
    padding-bottom: 120px;
  }

  .tria-quote-intro-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 8px;
  }

  .tria-quote-intro {
    line-height: 1.7;
    font-size: 1rem;
    color: rgba(0, 0, 0, 0.5);
    margin: 0;
  }

  /* ── Shell layout ── */
  .tria-quote-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(330px, 1fr);
    gap: 32px;
    align-items: stretch;
    position: relative;
    z-index: 1;
  }

  .tria-quote-shell[hidden] {
    display: none;
  }

  /* ── Wizard column — open, no app frame (home look & feel) ── */
  .tria-quote-wizard {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .tria-quote-form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* ── Steps ── */
  .tria-quiz-step {
    display: none;
    outline: none;
  }

  .tria-quiz-step.is-active {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    animation: triaStepIn 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quiz-step.is-active.anim-from-left {
    animation-name: triaStepInLeft;
  }

  @keyframes triaStepIn {
    from { opacity: 0; transform: translateX(26px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes triaStepInLeft {
    from { opacity: 0; transform: translateX(-26px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .tria-quiz-step-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    text-align: left;
  }

  .tria-quiz-step-title {
    font-size: 1.3rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: #0b0d17;
    margin: 0 0 4px;
    line-height: 1.25;
  }

  .tria-quiz-step-hint {
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.45);
    margin: 0;
  }



  /* Type cards — equal height & width */
  .tria-quote-types {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    grid-auto-rows: 1fr;
  }

  .tria-quote-type {
    cursor: pointer;
    height: 100%;
  }

  .tria-quote-type input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tria-quote-type-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 100%;
    padding: 18px 18px;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-type:hover .tria-quote-type-card {
    border-color: rgba(6, 142, 140, 0.4);
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.06), 0 12px 32px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .tria-quote-type input:checked + .tria-quote-type-card {
    border-color: var(--accent);
    background: linear-gradient(180deg, rgba(6, 142, 140, 0.05), rgba(6, 142, 140, 0.02));
    box-shadow: 0 0 0 1px var(--accent), 0 8px 28px rgba(6, 142, 140, 0.14);
  }

  .tria-quote-type input:focus-visible + .tria-quote-type-card {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tria-quote-type-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(6, 142, 140, 0.08);
    color: var(--accent);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-type:hover .tria-quote-type-icon {
    background: rgba(6, 142, 140, 0.14);
    transform: scale(1.05);
  }

  .tria-quote-type input:checked ~ .tria-quote-type-card .tria-quote-type-icon {
    background: var(--accent);
    color: #fff;
  }

  .tria-quote-type-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .tria-quote-type-name {
    font-size: 0.92rem;
    font-weight: 520;
    color: #0b0d17;
    letter-spacing: -0.01em;
  }

  .tria-quote-type-desc {
    font-size: 0.74rem;
    color: rgba(0, 0, 0, 0.45);
    line-height: 1.4;
  }

  .tria-quote-type-price {
    font-size: 0.72rem;
    font-weight: 560;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    margin-top: 2px;
  }

  .tria-quote-type-radio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    color: transparent;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-type input:checked + .tria-quote-type-card .tria-quote-type-radio {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.3);
  }

  /* "Included" — quiet inline label on types auto-included by a parent selection */
  .tria-quote-type-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .tria-quote-type-included {
    flex-shrink: 0;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent);
    opacity: 0.75;
    pointer-events: none;
    white-space: nowrap;
  }

  .tria-quote-type-card {
    position: relative;
  }

  /* Dynamic groups hidden by type logic must not render */
  .tria-quote-group[hidden] {
    display: none !important;
  }

  /* ── Pills (screens / endpoints / infra / complexity) ── */
  .tria-quote-pills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    grid-auto-rows: 1fr;
  }

  .tria-quote-pill {
    cursor: pointer;
    height: 100%;
  }


  .tria-quote-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tria-quote-pill-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    height: 100%;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 16px rgba(0, 0, 0, 0.03);
    text-align: center;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Corner selection indicator — same pattern as the type cards */
  .tria-quote-pill-inner::before {
    content: '';
    position: absolute;
    top: 10px;
    right: 10px;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    background: #fff;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-pill-inner::after {
    content: '';
    position: absolute;
    top: 10px;
    right: 10px;
    width: 18px;
    height: 18px;
    background: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none'%3E%3Cpath d='M4 9l3 3 5-7' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") center/12px 12px no-repeat;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-pill input:checked + .tria-quote-pill-inner::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.3);
  }

  .tria-quote-pill input:checked + .tria-quote-pill-inner::after {
    opacity: 1;
    transform: scale(1);
  }

  .tria-quote-pill:hover .tria-quote-pill-inner {
    border-color: rgba(6, 142, 140, 0.4);
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.06), 0 12px 32px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .tria-quote-pill input:checked + .tria-quote-pill-inner {
    border-color: var(--accent);
    background: linear-gradient(180deg, rgba(6, 142, 140, 0.05), rgba(6, 142, 140, 0.02));
    box-shadow: 0 0 0 1px var(--accent), 0 8px 28px rgba(6, 142, 140, 0.14);
  }

  .tria-quote-pill input:focus-visible + .tria-quote-pill-inner {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tria-quote-pill-name {
    font-size: 0.88rem;
    font-weight: 520;
    color: #0b0d17;
  }

  .tria-quote-pill-desc {
    font-size: 0.7rem;
    color: rgba(0, 0, 0, 0.45);
  }

  .tria-quote-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .tria-quote-group-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }

  /* Features — same card language as type cards & pills */
  .tria-quote-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    grid-auto-rows: 1fr;
  }

  .tria-quote-feature {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    height: 100%;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 16px rgba(0, 0, 0, 0.03);
    text-align: center;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-feature:hover {
    border-color: rgba(6, 142, 140, 0.4);
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.06), 0 12px 32px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .tria-quote-feature:has(input:checked) {
    border-color: var(--accent);
    background: linear-gradient(180deg, rgba(6, 142, 140, 0.05), rgba(6, 142, 140, 0.02));
    box-shadow: 0 0 0 1px var(--accent), 0 8px 28px rgba(6, 142, 140, 0.14);
  }

  .tria-quote-feature input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Corner check — same pattern as the pill cards */
  .tria-quote-feature-check {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    color: transparent;
    background: #fff;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-feature input:checked + .tria-quote-feature-check {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    box-shadow: 0 4px 12px rgba(6, 142, 140, 0.3);
  }

  .tria-quote-feature input:focus-visible + .tria-quote-feature-check {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tria-quote-feature-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    min-width: 0;
    padding-right: 6px;
  }

  .tria-quote-feature-name {
    font-size: 0.88rem;
    font-weight: 520;
    color: #0b0d17;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .tria-quote-feature-price {
    font-size: 0.72rem;
    font-weight: 560;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  /* Feature already included in the selected type's base price — no extra
     cost; the card shows an "Included" label instead of the price */
  .tria-quote-feature-included {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
  }

  .tria-quote-feature.is-included {
    border-style: dashed;
    border-color: rgba(6, 142, 140, 0.4);
    background: rgba(6, 142, 140, 0.03);
    box-shadow: none;
    cursor: default;
  }

  .tria-quote-feature.is-included:hover {
    border-color: rgba(6, 142, 140, 0.4);
    box-shadow: none;
    transform: none;
  }

  .tria-quote-feature.is-included .tria-quote-feature-price {
    display: none;
  }

  .tria-quote-feature.is-included .tria-quote-feature-included {
    display: block;
    color: var(--accent);
  }

  .tria-quote-feature.is-included .tria-quote-feature-check {
    border-color: rgba(6, 142, 140, 0.4);
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent);
    box-shadow: none;
  }

  /* Invoice row for an included feature — no amount, quiet accent */
  .tria-quote-bd-item--included > span:last-child {
    color: var(--accent);
    font-weight: 550;
  }

  /* Desktop only: keep feature cards the same height as the pill cards */
  @media (min-width: 992px) {
    .tria-quote-feature {
      min-height: 86px;
    }
  }

  /* ── Contact step — frameless, matches /contact form look ── */
  .tria-quote-contact {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    min-height: 0;
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .tria-quote-contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .tria-quote-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .tria-quote-field-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }

  .tria-quote-input {
    height: 42px;
    padding: 0 16px;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #ffffff;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.9rem;
    font-weight: 400;
    color: #0b0d17;
    letter-spacing: 0.01em;
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .tria-quote-textarea {
    flex: 1;
    height: auto;
    padding: 12px 16px;
    line-height: 1.6;
    min-height: 86px;
    margin-bottom: 0; /* neutralize the global textarea 30px bottom margin */
  }

  /* Notes field grows so the textarea fills the step's available space */
  .tria-quote-field--notes {
    flex: 1;
    min-height: 0;
  }

  .tria-quote-input::-webkit-input-placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-weight: 380;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .tria-quote-input::-moz-placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-weight: 380;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .tria-quote-input:-ms-input-placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-weight: 380;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .tria-quote-input::-ms-input-placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-weight: 380;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .tria-quote-input::placeholder {
    color: rgba(0, 0, 0, 0.28);
    font-weight: 380;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .tria-quote-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(6, 142, 140, 0.12);
  }

  .tria-quote-input--error {
    border-color: #d64545;
  }

  .tria-quote-contact-error {
    margin: 0;
    font-size: 0.78rem;
    color: #d64545;
    min-height: 1em;
  }

  /* ── Wizard nav — same prev/next as featured work on /home ── */
  .tria-quote-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 18px;
    margin-top: 28px;
    padding-top: 12px;
  }

  .tria-quote-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    white-space: nowrap;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
    transition: color 0.4s var(--ease-spring);
  }

  .tria-quote-nav-btn svg {
    width: 34px;
    height: 34px;
    padding: 8px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.04);
    transition: transform 0.4s var(--ease-spring), background 0.4s var(--ease-spring);
  }

  .tria-quote-nav-btn:hover {
    color: var(--accent, #068e8c);
  }

  .tria-quote-nav-btn:hover svg {
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent, #068e8c);
    transform: translateX(3px);
  }

  .tria-quote-nav-btn--prev:hover svg {
    transform: translateX(-3px);
  }

  .tria-quote-nav-btn:active svg {
    transform: scale(0.9);
  }

  .tria-quote-nav-btn[hidden] {
    display: none;
  }

  .tria-quote-nav-btn--next:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .tria-quote-nav-btn--next.is-blocked {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .tria-quote-nav-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Step body — uniform height across steps (same as step 1), scrollable when it doesn't fit ── */
  .tria-quiz-step.is-active > .tria-quiz-step-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1 1 auto;
    height: var(--tria-step-h, min(580px, calc(100vh - 300px)));
    min-height: var(--tria-step-h, min(540px, calc(100vh - 300px)));
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    /* Bottom padding ≥ the scroll-fade height so the last row of cards is
       never faded/cut when scrolled to the end */
    padding: 16px 12px 18px;
    scrollbar-width: thin;
    scrollbar-color: rgba(6, 142, 140, 0.3) transparent;
  }

  .tria-quiz-step.is-active > .tria-quiz-step-body::-webkit-scrollbar {
    width: 5px;
  }

  .tria-quiz-step.is-active > .tria-quiz-step-body::-webkit-scrollbar-thumb {
    background: rgba(6, 142, 140, 0.3);
    border-radius: 100px;
  }

  .tria-quiz-step.is-active > .tria-quiz-step-body::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Step 5 (contact) — same fixed height as every other step for a symmetric
     wizard; the compact form fits inside without scrolling. */

  /* Scroll affordance — soft bottom fade only when content overflows */
  .tria-quiz-step.is-active > .tria-quiz-step-body.is-overflowing {
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 22px), transparent 100%);
    mask-image: linear-gradient(to bottom, black calc(100% - 22px), transparent 100%);
  }

  /* ── Result panel — minimalist card, fills the column height ── */
  .tria-quote-result {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 24px 30px 20px;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), 0 20px 48px rgba(0, 0, 0, 0.045);
    color: #0b0d17;
  }

  .tria-quote-result-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .tria-quote-result-kicker {
    display: block;
    font-size: 0.68rem;
    font-weight: 520;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }

  .tria-quote-result-docno {
    display: block;
    margin-top: 6px;
    font-size: 0.86rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: #0b0d17;
  }

  .tria-quote-result-date {
    font-size: 0.72rem;
    color: rgba(0, 0, 0, 0.4);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 3px;
  }

  /* Empty state — nothing selected yet */
  .tria-quote-result-empty {
    margin: 4px 0 0;
    padding: 30px 20px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.02);
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(0, 0, 0, 0.42);
    text-align: center;
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tria-quote-result-empty[hidden] {
    display: none;
  }

  .tria-quote-result.is-empty .tria-quote-reset {
    display: none;
  }

  .tria-quote-result-range[hidden],
  .tria-quote-result-crc[hidden],
  .tria-quote-result-timeline[hidden],
  .tria-quote-bd-wrap[hidden] {
    display: none;
  }

  .tria-quote-result-crc {
    display: block;
    text-align: center;
    font-size: 0.76rem;
    font-weight: 460;
    font-variant-numeric: tabular-nums;
    color: rgba(0, 0, 0, 0.4);
    margin-top: 4px;
    margin-bottom: 0;
  }

  .tria-quote-bd-total-val {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .tria-quote-bd-total-crc {
    font-size: 0.68rem;
    font-weight: 460;
    font-variant-numeric: tabular-nums;
    color: rgba(0, 0, 0, 0.4);
    letter-spacing: 0;
  }

  .tria-quote-result-range {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(1.8rem, 2.7vw, 2.2rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    color: #0b0d17;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-align: center;
    margin-bottom: 14px;
  }

  .tria-quote-result-timeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    margin-bottom: 10px;
  }

  .tria-quote-result-timeline-label {
    font-size: 0.82rem;
    font-weight: 440;
    color: rgba(0, 0, 0, 0.5);
  }

  .tria-quote-result-timeline-value {
    font-size: 0.9rem;
    font-weight: 560;
    color: #0b0d17;
  }

  .tria-quote-bd-wrap {
    margin: 0 0 14px;
    min-height: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .tria-quote-result-breakdown {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    /* Fills the space left in the invoice panel and scrolls when full */
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.12) transparent;
  }

  /* Bottom fade — hints there's more content to scroll */
  .tria-quote-result-breakdown.is-scrollable::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    background: linear-gradient(to top, #ffffff, rgba(255, 255, 255, 0));
    pointer-events: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* Breakdown rows are built at runtime via innerHTML — must stay global (no data-astro-cid) */
  .tria-quote-result-breakdown :global(li.tria-quote-bd-item) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    font-size: 0.84rem;
    color: rgba(0, 0, 0, 0.6);
    line-height: 1.45;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .tria-quote-result-breakdown :global(li.tria-quote-bd-item:last-child) {
    border-bottom: none;
  }

  .tria-quote-result-breakdown :global(li.tria-quote-bd-item span:first-child) {
    min-width: 0;
  }

  .tria-quote-result-breakdown :global(li.tria-quote-bd-item span:last-child) {
    font-weight: 540;
    color: rgba(0, 0, 0, 0.82);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tria-quote-bd-summary {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .tria-quote-bd-subtotal,
  .tria-quote-bd-total-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.76rem;
  }

  .tria-quote-bd-subtotal span:first-child {
    color: rgba(0, 0, 0, 0.48);
  }

  .tria-quote-bd-subtotal span:last-child {
    font-weight: 520;
    color: rgba(0, 0, 0, 0.72);
    font-variant-numeric: tabular-nums;
  }

  .tria-quote-bd-total-row {
    margin-top: 2px;
    font-weight: 620;
    color: #0b0d17;
  }

  .tria-quote-bd-total-row span:last-child {
    font-size: 1.08rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .tria-quote-result-disclaimer {
    flex-shrink: 0;
    font-size: 0.7rem;
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.45);
    margin-bottom: 12px;
  }

  .tria-quote-reset {
    display: block;
    flex-shrink: 0;
    margin: 12px auto 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.74rem;
    font-weight: 480;
    color: rgba(0, 0, 0, 0.42);
    transition: color 0.3s ease;
  }

  .tria-quote-reset:hover {
    color: var(--accent);
  }

  /* ── Success state ── */
  .tria-quote-success {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: 40px 0 0;
  }

  .tria-quote-success[hidden] {
    display: none;
  }

  .tria-quote-success-card {
    max-width: 560px;
    width: 100%;
    text-align: center;
    padding: 56px 48px;
    border-radius: 24px;
    border: 1px solid rgba(6, 142, 140, 0.22);
    background: #ffffff;
    box-shadow: 0 8px 40px rgba(6, 142, 140, 0.08), 0 2px 8px rgba(0, 0, 0, 0.03);
    animation: triaStepIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-quote-success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent);
    margin-bottom: 24px;
  }

  .tria-quote-success-title {
    font-size: 1.6rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: #0b0d17;
    margin: 0 0 12px;
  }

  .tria-quote-success-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.55);
    margin: 0 0 32px;
  }

  .tria-quote-success-reset {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.4);
    transition: color 0.3s ease;
  }

  .tria-quote-success-reset:hover {
    color: var(--accent);
  }

  /* ── Mobile summary bar (desktop: hidden) ── */
  .tria-quote-bar {
    display: none;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .tria-quote-shell {
      grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 991px) {
    .tria-quote-shell {
      grid-template-columns: 1fr;
      gap: 40px;
      /* Clearance so the fixed summary bar never covers the nav / submit */
      padding-bottom: 96px;
    }

    /* Wizard clears the fixed top bar when scrolled into view on step change */
    .tria-quote-wizard {
      scroll-margin-top: 96px;
    }

    /* ── Fixed summary bar ── */
    .tria-quote-bar {
      display: flex;
      position: fixed;
      left: 14px;
      right: 14px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: 70;
      align-items: center;
      gap: 14px;
      padding: 13px 18px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 22px;
      background: rgba(11, 13, 23, 0.9);
      -webkit-backdrop-filter: blur(20px) saturate(1.6);
      backdrop-filter: blur(20px) saturate(1.6);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
