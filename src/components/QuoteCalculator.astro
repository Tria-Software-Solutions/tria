  }

  /* ── Responsive ── */
  @media (max-width: 991px) {
    .tria-quote-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .tria-quote-result {
      position: static;
    }

    .tria-quote-pills--3,
    .tria-quote-pills--4 {
      grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .tria-quote-header {
      margin-bottom: 48px;
    }

    .tria-quote-types,
    .tria-quote-features {
      grid-template-columns: 1fr;
    }

    .tria-quote-contact-row {
      grid-template-columns: 1fr;
    }
  }

  /* When used as a dedicated page section (no internal header) */
  .tria-quote-section:not(:has(.tria-quote-header)) .tria-quote-layout {
    padding-top: 8px;
  }

  @media (max-width: 576px) {
    .tria-quote-step {
      margin-bottom: 36px;
    }

    .tria-quote-pills,
    .tria-quote-pills--3,
    .tria-quote-pills--4 {
      grid-template-columns: 1fr 1fr;
    }

    .tria-quote-result {
      padding: 28px 22px;
    }

    .tria-quote-result-range {
      font-size: clamp(2.1rem, 9vw, 2.7rem);
    }

    .tria-quote-contact {
      padding: 22px 18px;
    }

    .tria-quote-success-card {
      padding: 40px 24px;
    }
  }
</style>

<script define:vars={{ quoteTexts, turnstileSiteKey }}>
  (function () {
    var form = document.getElementById('tria-quote-form');
    var layout = document.getElementById('tria-quote-layout');
    var success = document.getElementById('tria-quote-success');
    var rangeEl = document.getElementById('quote-range');
    var weeksEl = document.getElementById('quote-weeks');
    var breakdownEl = document.getElementById('quote-breakdown');
    var resetBtn = document.getElementById('quote-reset');
    var successReset = document.getElementById('quote-success-reset');
    if (!form || !rangeEl) return;

    var weeksTemplate = quoteTexts.weeks;

    function getSelected(name) {
      return form.querySelector('input[name="' + name + '"]:checked');
    }

    function round50(n) {
      return Math.round(n / 50) * 50;
    }

    function money(n) {
      return '$' + n.toLocaleString('en-US');
    }

    function fmtMult(m) {
      return '×' + parseFloat(m.toFixed(2)).toString();
    }

    function calc() {
      var typeEl = getSelected('type');
      var screensEl = getSelected('screens');
      var compEl = getSelected('complexity');
      var usersEl = getSelected('users');
      var deadlineEl = getSelected('deadline');
      var designEl = getSelected('design');
      var integEl = getSelected('integrations');
      if (!typeEl || !screensEl || !compEl || !usersEl || !deadlineEl || !designEl || !integEl) return;

      var base = parseFloat(typeEl.getAttribute('data-base')) || 0;
      var sMult = parseFloat(screensEl.getAttribute('data-mult')) || 1;
      var cMult = parseFloat(compEl.getAttribute('data-mult')) || 1;
      var uMult = parseFloat(usersEl.getAttribute('data-mult')) || 1;
      var dMult = parseFloat(deadlineEl.getAttribute('data-mult')) || 1;
      var dsMult = parseFloat(designEl.getAttribute('data-mult')) || 1;
      var iMult = parseFloat(integEl.getAttribute('data-mult')) || 1;

      var weeks = JSON.parse(typeEl.getAttribute('data-weeks') || '[2,4]');
      var compFactor = cMult;
      var screensIdx = ['s1', 's2', 's3', 's4', 's5'].indexOf(screensEl.value);
      var screensWeekFactor = 0.8 + Math.max(0, screensIdx) * 0.15;
      var wMin = Math.max(1, Math.round(weeks[0] * screensWeekFactor * (0.75 + compFactor * 0.25)));
      var wMax = Math.max(wMin, Math.round(weeks[1] * screensWeekFactor * (0.75 + compFactor * 0.25)));

      var subtotal = base * sMult * cMult * uMult * dMult * dsMult * iMult;
      var featureTotal = 0;
      var featureNames = [];
      var feats = form.querySelectorAll('input[name="features"]:checked');
      feats.forEach(function (el) {
        featureTotal += parseFloat(el.getAttribute('data-price')) || 0;
        featureNames.push(el.getAttribute('data-label'));
      });

      var mid = subtotal + featureTotal;
      var low = round50(mid * 0.85);
      var high = round50(mid * 1.25);

      rangeEl.textContent = money(low) + ' \u2013 ' + money(high);
      weeksEl.textContent = weeksTemplate.replace('{min}', wMin).replace('{max}', wMax);

      var bd = [];
      bd.push({ label: typeEl.getAttribute('data-label'), value: money(base), sub: quoteTexts.base });
      if (sMult !== 1) bd.push({ label: screensEl.getAttribute('data-label'), value: fmtMult(sMult), sub: quoteTexts.screens });
      if (cMult !== 1) bd.push({ label: compEl.getAttribute('data-label'), value: fmtMult(cMult), sub: quoteTexts.complexity });
      if (uMult !== 1) bd.push({ label: usersEl.getAttribute('data-label'), value: fmtMult(uMult), sub: quoteTexts.users });
      if (dMult !== 1) bd.push({ label: deadlineEl.getAttribute('data-label'), value: fmtMult(dMult), sub: quoteTexts.deadline });
      if (dsMult !== 1) bd.push({ label: designEl.getAttribute('data-label'), value: fmtMult(dsMult), sub: quoteTexts.design });
      if (iMult !== 1) bd.push({ label: integEl.getAttribute('data-label'), value: fmtMult(iMult), sub: quoteTexts.integrations });
      if (featureNames.length) {
        bd.push({ label: featureNames.slice(0, 3).join(', ') + (featureNames.length > 3 ? ' ' + quoteTexts.more.replace('{n}', featureNames.length - 3) : ''), value: money(featureTotal), sub: quoteTexts.features });
      }
      bd.push({ label: quoteTexts.total, value: money(mid), total: true });

      breakdownEl.innerHTML = '';
      bd.forEach(function (row) {
        var li = document.createElement('li');
        if (row.total) li.className = 'tria-quote-bd-total';
        var left = row.sub && row.sub !== row.label
          ? '<span>' + row.label + '</span>'
          : '<span>' + row.label + '</span>';
        li.innerHTML = left + '<span>' + row.value + '</span>';
        breakdownEl.appendChild(li);
      });
    }

    form.addEventListener('change', calc);

    function resetAll() {
      form.querySelectorAll('input[type="radio"]').forEach(function (el) {
        if (el.name === 'type') el.checked = el.value === 'landing';
        if (el.name === 'screens') el.checked = el.value === 's2';
        if (el.name === 'complexity') el.checked = el.value === 'standard';
        if (el.name === 'users') el.checked = el.value === 'u2';
        if (el.name === 'deadline') el.checked = el.value === 'd2';
        if (el.name === 'design') el.checked = el.value === 'ds2';
        if (el.name === 'integrations') el.checked = el.value === 'i1';
      });
      form.querySelectorAll('input[type="checkbox"]').forEach(function (el) {
        el.checked = false;
      });
      var nameEl = document.getElementById('quote-name');
      var emailEl = document.getElementById('quote-email');
      var companyEl = document.getElementById('quote-company');
      if (nameEl) nameEl.value = '';
      if (emailEl) emailEl.value = '';
      if (companyEl) companyEl.value = '';
      clearContactError();
      calc();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (successReset) successReset.addEventListener('click', function () {
      resetAll();
      layout.hidden = false;
      success.hidden = true;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* ── Contact validation ── */
    var contactError = document.getElementById('quote-contact-error');

    function clearContactError() {
      var nameEl = document.getElementById('quote-name');
      var emailEl = document.getElementById('quote-email');
      if (nameEl) nameEl.classList.remove('tria-quote-input--error');
      if (emailEl) emailEl.classList.remove('tria-quote-input--error');
      if (contactError) contactError.textContent = '';
    }

    /* ── Turnstile ── */
    function loadTurnstile() {
      if (typeof turnstile !== 'undefined') return;
      var script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    function getTurnstileToken() {
      return new Promise(function (resolve) {
        if (typeof turnstile === 'undefined' || !turnstile.render) {
          resolve('');
          return;
        }
        var container = document.getElementById('quote-turnstile-container');
        if (!container) {
          container = document.createElement('div');
          container.id = 'quote-turnstile-container';
          container.style.display = 'none';
          form.appendChild(container);
        }
        turnstile.render(container, {
          sitekey: turnstileSiteKey,
          callback: function (token) { resolve(token); },
          'error-callback': function () { resolve(''); },
          'expired-callback': function () { resolve(''); },
        });
      });
    }

    /* ── Build the message summary for the lead ── */
    function buildSummary() {
      var lines = [];
      lines.push(typeElLabel('type') + ': ' + getSelected('type').getAttribute('data-label'));
      lines.push(quoteTexts.screens + ': ' + getSelected('screens').getAttribute('data-label'));
      lines.push(quoteTexts.complexity + ': ' + getSelected('complexity').getAttribute('data-label'));
      lines.push(quoteTexts.users + ': ' + getSelected('users').getAttribute('data-label'));
      lines.push(quoteTexts.deadline + ': ' + getSelected('deadline').getAttribute('data-label'));
      lines.push(quoteTexts.design + ': ' + getSelected('design').getAttribute('data-label'));
      lines.push(quoteTexts.integrations + ': ' + getSelected('integrations').getAttribute('data-label'));
      var featNames = Array.prototype.map.call(form.querySelectorAll('input[name="features"]:checked'), function (el) {
        return el.getAttribute('data-label');
      });
      lines.push(quoteTexts.features + ': ' + (featNames.length ? featNames.join(', ') : '-'));
      lines.push(quoteTexts.total + ': ' + rangeEl.textContent + ' (' + weeksEl.textContent + ')');
      return lines.join('\n');
    }

    function typeElLabel() {
      return getSelected('type').getAttribute('data-label');
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearContactError();

      var nameEl = document.getElementById('quote-name');
      var emailEl = document.getElementById('quote-email');
      var companyEl = document.getElementById('quote-company');
      var name = nameEl ? nameEl.value.trim() : '';
      var email = emailEl ? emailEl.value.trim() : '';
      var company = companyEl ? companyEl.value.trim() : '';

      var valid = true;
      if (!name) { if (nameEl) nameEl.classList.add('tria-quote-input--error'); valid = false; }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { if (emailEl) emailEl.classList.add('tria-quote-input--error'); valid = false; }
      if (!valid) {
        if (contactError) contactError.textContent = quoteTexts.contactRequired;
        return;
      }

      var btn = document.getElementById('quote-submit');
      if (btn) {
        btn.disabled = true;
        var btnText = btn.querySelector('.tria-btn-text');
        if (btnText) btnText.textContent = quoteTexts.sending;
      }

      getTurnstileToken().then(function (turnstileToken) {
        var data = {
          name: name,
          email: email,
          company: company,
          budget: rangeEl.textContent,
          services: [typeElLabel(), getSelected('screens').getAttribute('data-label'), getSelected('complexity').getAttribute('data-label')],
          message: buildSummary(),
          turnstileToken: turnstileToken,
        };

        fetch('/api/create-jira-ticket', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (btn) {
            btn.disabled = false;
            var btnText = btn.querySelector('.tria-btn-text');
            if (btnText) btnText.textContent = quoteTexts.sendCta;
          }
          if (result && result.success) {
            layout.hidden = true;
            success.hidden = false;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            if (contactError) contactError.textContent = (result && result.error) || '';
          }
        })
        .catch(function () {
          if (btn) {
            btn.disabled = false;
            var btnText = btn.querySelector('.tria-btn-text');
            if (btnText) btnText.textContent = quoteTexts.sendCta;
          }
          if (contactError) contactError.textContent = quoteTexts.contactRequired;
        });
      });
    });

    calc();
    loadTurnstile();
  })();
</script>
