  }

  /* Very narrow screens: single column keeps cards tappable */
  @media (max-width: 380px) {
    .tria-quote-types,
    .tria-quote-features,
    .tria-quote-pills {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ quoteTexts, turnstileSiteKey, screensData, crcRate, scaleData, typeScaleMap, typeGroupMap, typeIncludeMap, featureTypes, includedFeatures }}>
  /* Named init so the wizard can re-bind after a locale swap (swup:contentReplaced)
     without re-executing the page's inline script. */
  function initQuote() {
    var form = document.getElementById('tria-quote-form');
    var shell = document.getElementById('tria-quote-shell');
    var success = document.getElementById('tria-quote-success');
    var rangeEl = document.getElementById('quote-range');
    var weeksEl = document.getElementById('quote-weeks');
    var breakdownEl = document.getElementById('quote-breakdown');
    var resetBtn = document.getElementById('quote-reset');
    var successReset = document.getElementById('quote-success-reset');
    var prevBtn = document.getElementById('quote-prev');
    var nextBtn = document.getElementById('quote-next');
    var nextBtnText = nextBtn ? nextBtn.querySelector('.tria-quote-nav-text') : null;
    var steps = Array.prototype.slice.call(document.querySelectorAll('.tria-quiz-step'));
    var totalSteps = steps.length;

    /* Mobile summary bar + invoice bottom sheet */
    var barEl = document.getElementById('tria-quote-bar');
    var barTotalEl = document.getElementById('quote-bar-total');
    var barStepEl = document.getElementById('quote-bar-step');
    var asideEl = document.getElementById('tria-quote-result');
    var asideParent = null;
    var asideNext = null;
    var sheetEl = null;

    /* A previous init (locale swap while the sheet was open) may have left the
       scroll-lock state applied to the document — always start clean. */
    document.documentElement.classList.remove('tria-sheet-open');

    if (!form || !rangeEl || !steps.length) return;

    var currentStep = 1;
    var prevLow = 0;
    var prevHigh = 0;
    var prevSub = 0;
    var prevMid = 0;

    var weeksTemplate = quoteTexts.weeks;

    var subTotalEl = document.getElementById('quote-subtotal');
    var totalEl = document.getElementById('quote-total');
    var crcEl = document.getElementById('quote-crc');
    var totalCrcEl = document.getElementById('quote-total-crc');

    /* ── Invoice doc meta (no + date) ── */
    var docnoEl = document.getElementById('quote-docno');
    var docdateEl = document.getElementById('quote-docdate');
    (function setDocMeta() {
      var now = new Date();
      var pad = function (n) { return String(n).padStart(2, '0'); };
      if (docnoEl) {
        docnoEl.textContent = 'TRIA-' + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + '-01';
      }
      if (docdateEl) {
        var lang = (document.documentElement.lang || 'en').toLowerCase();
        docdateEl.textContent = now.toLocaleDateString(lang.indexOf('es') === 0 ? 'es' : 'en', {
          year: 'numeric', month: 'short', day: 'numeric'
        });
      }
    })();

    function getSelected(name) {
      return form.querySelector('input[name="' + name + '"]:checked');
    }

    function round50(n) {
      return Math.round(n / 50) * 50;
    }

    function money(n) {
      return '$' + n.toLocaleString('en-US');
    }

    /* CRC equivalent (exchange rate passed via define:vars) */
    function crc(n) {
      return '₡' + Math.round(n * crcRate).toLocaleString('en-US');
    }

    /* ── Screens (radio pills) ── */
    function activeScaleGroups() {
      var groups = {};
      selectedTypes().forEach(function (el) {
        var scale = typeScaleMap[el.value];
        if (scale) groups[scale] = true;
      });
      return groups;
    }

    /* Selected radio element for each active scale group, in priority order */
    function activeScaleEls() {
      var names = ['screens', 'endpoints', 'infra'];
      var groups = activeScaleGroups();
      var els = [];
      for (var i = 0; i < names.length; i++) {
        if (groups[names[i]]) {
          var el = getSelected(names[i]);
          if (el) els.push({ name: names[i], el: el });
        }
      }
      return els;
    }

    function currentScale() {
      var els = activeScaleEls();
      return els.length ? els[0].el : null;
    }

    function currentScaleData() {
      var els = activeScaleEls();
      if (!els.length) return { key: 's2', label: '', desc: '', mult: 1 };
      var data = scaleData[els[0].name] || [];
      for (var j = 0; j < data.length; j++) {
        if (data[j].key === els[0].el.value) return data[j];
      }
      return { key: 's2', label: '', desc: '', mult: 1 };
    }

    /* Labels of every active scale selection, e.g. "4-8 screens", "15-40 endpoints" */
    function activeScaleLabels() {
      return activeScaleEls().map(function (s) { return s.el.getAttribute('data-label'); });
    }

    /* ── Result panel empty state (nothing selected yet) ── */
    function setResultEmpty(empty) {
      var aside = document.getElementById('tria-quote-result');
      var emptyEl = document.getElementById('quote-result-empty');
      var head = document.querySelector('.tria-quote-result-head');
      var tl = document.querySelector('.tria-quote-result-timeline');
      var bdWrap = document.querySelector('.tria-quote-bd-wrap');
      if (aside) aside.classList.toggle('is-empty', empty);
      if (emptyEl) emptyEl.hidden = !empty;
      if (head) head.hidden = empty;
      if (rangeEl) rangeEl.hidden = empty;
      if (crcEl) crcEl.hidden = empty;
      if (tl) tl.hidden = empty;
      if (bdWrap) bdWrap.hidden = empty;
      syncMobileBar();
    }

    /* ── Multi-select project types ── */
    function selectedTypes() {
      return form.querySelectorAll('input[name="types"]:checked');
    }

    function selectedTypeKeys() {
      return Array.prototype.map.call(selectedTypes(), function (el) { return el.value; });
    }

    /* True when any selected type needs the given option group */
    function groupActive(group) {
      var keys = selectedTypeKeys();
      for (var i = 0; i < keys.length; i++) {
        var g = typeGroupMap[keys[i]] || [];
        if (g.indexOf(group) !== -1) return true;
      }
      return false;
    }

    /* ── Calculation ──
       Progressive accumulation: the result panel sums only what has been
       selected in the current step and the previous ones. Steps not yet
       reached contribute neutral multipliers (1) and no breakdown rows.

       Precision rules:
       • Each selected type is scaled by ITS OWN scale group multiplier
         (screens / endpoints / infra), so Web App + Backend no longer apply
         one global multiplier to the whole sum.
       • Features already included in a type's base price (includedFeatures)
         cost $0 and appear in the invoice marked as "Included". ── */
    function calc() {
      var typeEls = selectedTypes();
      if (!typeEls.length) {
        setResultEmpty(true);
        return;
      }
      setResultEmpty(false);

      var reached = {
        scope: currentStep >= 2,
        timing: currentStep >= 3,
        extras: currentStep >= 4
      };
      var compEl = getSelected('complexity');
      var usersEl = getSelected('users');
      var deadlineEl = getSelected('deadline');
      var designEl = getSelected('design');
      var integEl = getSelected('integrations');

      var incKeys = includedFeatureKeys();

      /* Sum of each selected type's base price scaled by its own scale
         group multiplier. Types auto-included by a parent (e.g. Landing
         inside Website) are already covered by the parent's base price and
         are skipped so they don't double-count. */
      var base = 0;
      var wMinAll = Infinity;
      var wMaxAll = 0;
      typeEls.forEach(function (el) {
        if (isCoveredByOther(el.value)) return;
        var b = parseFloat(el.getAttribute('data-base')) || 0;
        var scaleName = typeScaleMap[el.value];
        var m = 1;
        if (reached.scope && scaleName) {
          var sel = getSelected(scaleName);
          if (sel) m = parseFloat(sel.getAttribute('data-mult')) || 1;
        }
        base += b * m;
        var weeks = JSON.parse(el.getAttribute('data-weeks') || '[2,4]');
        if (weeks[0] < wMinAll) wMinAll = weeks[0];
        if (weeks[1] > wMaxAll) wMaxAll = weeks[1];
      });
      var cMult = reached.scope && compEl && groupActive('complexity') ? parseFloat(compEl.getAttribute('data-mult')) || 1 : 1;
      var uMult = reached.timing && usersEl && groupActive('users') ? parseFloat(usersEl.getAttribute('data-mult')) || 1 : 1;
      var dMult = reached.timing && deadlineEl && groupActive('deadline') ? parseFloat(deadlineEl.getAttribute('data-mult')) || 1 : 1;
      var dsMult = reached.timing && designEl && groupActive('design') ? parseFloat(designEl.getAttribute('data-mult')) || 1 : 1;
      var iMult = reached.extras && integEl && groupActive('integrations') ? parseFloat(integEl.getAttribute('data-mult')) || 1 : 1;

      var weeks = [wMinAll === Infinity ? 2 : wMinAll, wMaxAll || 4];

      /* Features: included ones (already in a base price) cost $0 and are
         listed in the invoice as "Included"; only the rest add to the total
         and to the timeline. */
      var featureTotal = 0;
      var featureNames = [];
      var feats = reached.extras && groupActive('features') ? form.querySelectorAll('input[name="features"]:checked') : [];
      feats.forEach(function (el) {
        if (!incKeys[el.value]) {
          featureTotal += parseFloat(el.getAttribute('data-price')) || 0;
          featureNames.push(el.getAttribute('data-label'));
        }
      });
      var featureEls = Array.prototype.slice.call(feats);

      /* Weeks reflect what was actually requested: scope size, complexity,
         expected users, deadline urgency, design depth, integrations and
         selected features. Neutral (1) when a step isn't reached yet. */
      var screensIdx = 1;
      var names2 = ['screens', 'endpoints', 'infra'];
      for (var si2 = 0; si2 < names2.length; si2++) {
        if (!scaleData[names2[si2]]) continue;
        var list2 = scaleData[names2[si2]] || [];
        for (var j2 = 0; j2 < list2.length; j2++) {
          var el2 = getSelected(names2[si2]);
          if (el2 && el2.value === list2[j2].key && j2 > screensIdx) screensIdx = j2;
        }
      }
      var scopeFactor = reached.scope ? 0.9 + Math.max(0, screensIdx) * 0.18 : 1;
      var complexityFactor = reached.scope ? (0.8 + (cMult - 1) * 0.85) : 1;
      var usersFactor = reached.timing ? (1 + (uMult - 1) * 0.6) : 1;
      var deadlineFactor = reached.timing ? (1.18 - (dMult - 1) * 0.6) : 1;
      var designFactor = reached.timing ? (1 + (dsMult - 1) * 0.5) : 1;
      var integFactor = reached.extras ? (1 + (iMult - 1) * 0.5) : 1;
      var featureFactor = reached.extras ? (1 + featureNames.length * 0.04) : 1;
      var weekScale = scopeFactor * complexityFactor * usersFactor * deadlineFactor * designFactor * integFactor * featureFactor;
      var wMin = Math.max(1, Math.round(weeks[0] * weekScale));
      var wMax = Math.max(wMin, Math.round(weeks[1] * weekScale));

      var subtotal = base * cMult * uMult * dMult * dsMult * iMult;

      var mid = subtotal + featureTotal;
      var low = round50(mid * 0.75);
      var high = round50(mid * 1.35);

      animateRange(low, high, subtotal, mid, 450);
      weeksEl.textContent = weeksTemplate.replace('{min}', wMin).replace('{max}', wMax);

      var bd = [];
      typeEls.forEach(function (el) {
        if (isCoveredByOther(el.value)) return;
        var b = parseFloat(el.getAttribute('data-base')) || 0;
        var scaleName = typeScaleMap[el.value];
        var m = 1;
        var scaleLabel = '';
        if (reached.scope && scaleName) {
          var sel = getSelected(scaleName);
          if (sel) { m = parseFloat(sel.getAttribute('data-mult')) || 1; scaleLabel = sel.getAttribute('data-label'); }
        }
        var label = el.getAttribute('data-label');
        if (scaleLabel) label += ' · ' + scaleLabel;
        bd.push({ label: label, value: money(Math.round(b * m)), sub: quoteTexts.sections.base });
      });
      if (reached.extras && groupActive('features')) {
        featureEls.forEach(function (el) {
          if (!el.checked) return;
          if (incKeys[el.value]) {
            bd.push({ label: el.getAttribute('data-label'), value: quoteTexts.included });
            return;
          }
          bd.push({ label: el.getAttribute('data-label'), value: money(parseFloat(el.getAttribute('data-price')) || 0) });
        });
      }
      breakdownEl.innerHTML = '';
      bd.forEach(function (row) {
        if (row.total) return;
        var li = document.createElement('li');
        li.className = 'tria-quote-bd-item' + (row.value === quoteTexts.included ? ' tria-quote-bd-item--included' : '');
        li.innerHTML = '<span>' + row.label + '</span><span>' + row.value + '</span>';
        breakdownEl.appendChild(li);
      });
      updateBreakdownScroll();
    }

    /* ── Animated count-up for range + invoice summary ── */
    function animateRange(low, high, subtotal, mid, duration) {
      var start = performance.now();
      function tick(now) {
        var p = Math.min(1, (now - start) / duration);
        var e = 1 - Math.pow(1 - p, 3);
        var l = Math.round(prevLow + (low - prevLow) * e);
        var h = Math.round(prevHigh + (high - prevHigh) * e);
        var s = Math.round(prevSub + (subtotal - prevSub) * e);
        var m = Math.round(prevMid + (mid - prevMid) * e);
        rangeEl.textContent = money(l) + ' \u2013 ' + money(h);
        if (crcEl) crcEl.textContent = '≈ ' + crc(l) + ' – ' + crc(h);
        if (subTotalEl) subTotalEl.textContent = money(s);
        if (totalEl) totalEl.textContent = money(m);
        if (totalCrcEl) totalCrcEl.textContent = '≈ ' + crc(m);
        if (barTotalEl) barTotalEl.textContent = rangeEl.textContent;
        if (p < 1) {
          requestAnimationFrame(tick);
        } else {
          prevLow = low;
          prevHigh = high;
          prevSub = subtotal;
          prevMid = mid;
        }
      }
      requestAnimationFrame(tick);
    }

    /* ── Smart type-dependent wizard ── */
    function includesSet(key, acc) {
      acc = acc || {};
      var inc = typeIncludeMap[key] || [];
      inc.forEach(function (k) {
        if (!acc[k]) {
          acc[k] = true;
          includesSet(k, acc);
        }
      });
      return acc;
    }

    function isCoveredByOther(key) {
      var keys = selectedTypeKeys();
      for (var i = 0; i < keys.length; i++) {
        if (keys[i] === key) continue;
        var acc = includesSet(keys[i]);
        if (acc[key]) return true;
      }
      return false;
    }

    /* Every feature already included in the base price of any selected type
       (including inherited types, e.g. ecommerce → website → landing). */
    function includedFeatureKeys() {
      var acc = {};
      var keys = selectedTypeKeys();
      keys.forEach(function (key) {
        var set = includesSet(key);
        set[key] = true;
        Object.keys(set).forEach(function (k) {
          (includedFeatures[k] || []).forEach(function (f) { acc[f] = true; });
        });
      });
      return acc;
    }

    function syncBadges() {
      form.querySelectorAll('input[name="types"]').forEach(function (inp) {
        var label = inp.closest('.tria-quote-type');
        var badge = label ? label.querySelector('[data-included-badge]') : null;
        if (badge) badge.hidden = !(inp.checked && isCoveredByOther(inp.value));
      });
    }

    function syncGroups() {
      var keys = selectedTypeKeys();
      var none = keys.length === 0;
      document.querySelectorAll('[data-group]').forEach(function (g) {
        var name = g.getAttribute('data-group');
        var show = none ? true : groupActive(name);
        g.hidden = !show;
      });
      var scaleGroups = activeScaleGroups();
      ['screens', 'endpoints', 'infra'].forEach(function (name) {
        var g = form.querySelector('[data-group="' + name + '"]');
        if (g) g.hidden = !(none || scaleGroups[name]);
      });
    }

    function syncFeatures() {
      var keys = selectedTypeKeys();
      var none = keys.length === 0;
      var incKeys = includedFeatureKeys();
      form.querySelectorAll('.tria-quote-feature').forEach(function (label) {
        var input = label.querySelector('input');
        var ftypes = (input && featureTypes[input.value]) || [];
        var ok = none || ftypes.some(function (t) { return keys.indexOf(t) !== -1; });
        var isIncluded = ok && !none && !!incKeys[input.value];
        label.hidden = !ok;
        label.classList.toggle('is-included', isIncluded);
        var badge = label.querySelector('[data-feature-included]');
        if (badge) badge.hidden = !isIncluded;
        /* Uncheck features that no longer apply so they don't silently add to the total */
        if (!ok && input && input.checked) input.checked = false;
      });
    }

    function syncTypes(changed) {
      if (changed) {
        if (changed.checked) {
          var acc = includesSet(changed.value);
          Object.keys(acc).forEach(function (k) {
            var inp = form.querySelector('input[name="types"][value="' + k + '"]');
            if (inp && !inp.checked) inp.checked = true;
          });
        } else {
          var acc2 = includesSet(changed.value);
          Object.keys(acc2).forEach(function (k) {
            var inp = form.querySelector('input[name="types"][value="' + k + '"]');
            if (inp && inp.checked && !isCoveredByOther(k)) inp.checked = false;
          });
        }
      }
      syncBadges();
      syncGroups();
      syncFeatures();
      calc();
      updateNav();
      updateStepScroll();
    }

    form.addEventListener('change', function (e) {
      var t = e.target;
      if (t && t.name === 'types') {
        syncTypes(t);
      } else {
        calc();
        updateNav();
      }
    });

    /* ── Each step requires at least one selection before Continue ── */
    /* Every visible required group in the step must be answered */
    function groupsComplete(names) {
      for (var i = 0; i < names.length; i++) {
        var g = form.querySelector('.tria-quote-group[data-group="' + names[i] + '"]');
        if (g && !g.hidden && !form.querySelector('input[name="' + names[i] + '"]:checked')) {
          return false;
        }
      }
      return true;
    }

    function stepHasSelection(step) {
      if (step === 1) return !!form.querySelector('input[name="types"]:checked');
      if (step === 2) return groupsComplete(['screens', 'endpoints', 'infra', 'complexity']);
      if (step === 3) return groupsComplete(['users', 'deadline', 'design']);
      if (step === 4) return groupsComplete(['integrations']);
      return true;
    }

    /* ── Wizard navigation ── */
    function updateNav() {
      var lastStep = currentStep === totalSteps;
      if (prevBtn) {
        prevBtn.hidden = currentStep === 1;
        prevBtn.disabled = false;
      }
      /* On the last step the next/send button disappears from the nav — only the
         back button remains; submission lives in the form below. */
      if (nextBtn) {
        nextBtn.hidden = lastStep;
        if (!lastStep) {
          var blocked = !stepHasSelection(currentStep);
          nextBtn.classList.toggle('is-blocked', blocked);
          nextBtn.setAttribute('aria-disabled', blocked ? 'true' : 'false');
        }
      }
      if (nextBtnText) {
        nextBtnText.textContent = quoteTexts.next;
      }
      syncMobileBar();
    }

    function goTo(step, dir) {
      var next = form.querySelector('.tria-quiz-step[data-step="' + step + '"]');
      if (!next) return;
      var cur = form.querySelector('.tria-quiz-step.is-active');
      if (cur && cur !== next) {
        cur.classList.remove('is-active', 'anim-from-left');
      }
      next.classList.add('is-active');
      if (dir === 'back') next.classList.add('anim-from-left');
      currentStep = step;
      updateNav();
      updateStepScroll();
      calc();
      /* Re-sync the invoice panel height — step bodies have different natural
         heights (e.g. step 5 with the full contact form) and the panel would
         otherwise stay at the height measured on load */
      syncLayout();
      var first = next.querySelector('input, textarea, button');
      if (first && first.focus) first.focus({ preventScroll: true });
      if (window.innerWidth < 992) {
        var wizard = document.querySelector('.tria-quote-wizard');
        if (wizard) wizard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', function () {
      if (currentStep > 1) goTo(currentStep - 1, 'back');
    });

    /* ── Scroll affordance on step content ── */
    function updateStepScroll() {
      var cur = form.querySelector('.tria-quiz-step.is-active > .tria-quiz-step-body');
      if (!cur) return;
      cur.classList.toggle('is-overflowing', cur.scrollHeight > cur.clientHeight + 4);
    }

    /* ── Scroll affordance on the invoice items list ── */
    function updateBreakdownScroll() {
      if (!breakdownEl) return;
      breakdownEl.classList.toggle('is-scrollable', breakdownEl.scrollHeight > breakdownEl.clientHeight + 4);
    }

    /* ── Uniform step height — fixed short height so all steps look the same, taller ones scroll ── */
    function syncStepHeight() {
      if (window.innerWidth < 769) return;
      var body1 = form.querySelector('.tria-quiz-step[data-step="1"] > .tria-quiz-step-body');
      if (!body1) return;
      var prevH = body1.style.height;
      var prevMin = body1.style.minHeight;
      var prevFlex = body1.style.flex;
      /* flex:none while measuring so the natural height isn't inflated by flex-grow
         (the wizard may still be stretched by the pinned invoice panel) */
      body1.style.flex = 'none';
      body1.style.height = 'auto';
      body1.style.minHeight = '0';
      var h = body1.offsetHeight;
      body1.style.flex = prevFlex;
      body1.style.height = prevH;
      body1.style.minHeight = prevMin;
      if (!h || h < 100) return;
      var MAX = 580;
      /* Keep the shared height viewport-aware: shrink on short desktop viewports
         so the wizard never pushes the nav below the fold */
      if (window.innerHeight) {
        MAX = Math.min(580, Math.max(440, window.innerHeight - 380));
      }
      form.style.setProperty('--tria-step-h', Math.min(h, MAX) + 'px');
      updateStepScroll();
    }

    /* ── Invoice panel height matches the wizard column (and stays constant) ── */
    function syncResultHeight() {
      var wizard = document.querySelector('.tria-quote-wizard');
      var result = document.getElementById('tria-quote-result');
      if (!result) return;
      if (window.innerWidth < 992) {
        /* Single-column layout — let the panel flow naturally */
        result.style.height = '';
        return;
      }
      if (!wizard) return;
      var prev = result.style.height;
      result.style.height = '0px';
      var h = wizard.offsetHeight;
      result.style.height = prev;
      if (!h || h < 300) return;
      /* Slight headroom over the wizard so the invoice (and its items area)
         breathes — the grid stretches both columns to the taller one, so they match */
      result.style.height = Math.max(h + 48, 620) + 'px';
    }

    function syncLayout() {
      syncStepHeight();
      syncResultHeight();
    }

    /* ── Mobile: invoice as a bottom sheet + fixed summary bar ── */
    function buildSheet() {
      var wrap = document.createElement('div');
      wrap.className = 'tria-quote-sheet';
      wrap.setAttribute('role', 'dialog');
      wrap.setAttribute('aria-modal', 'true');
      wrap.setAttribute('aria-label', quoteTexts.barLabel);

      var backdrop = document.createElement('div');
      backdrop.className = 'tria-quote-sheet-backdrop';

      var panel = document.createElement('div');
      panel.className = 'tria-quote-sheet-panel';
      panel.setAttribute('data-lenis-prevent', '');

      var head = document.createElement('div');
      head.className = 'tria-quote-sheet-head';
      var title = document.createElement('span');
      title.className = 'tria-quote-sheet-title';
      title.textContent = quoteTexts.barLabel;
      var close = document.createElement('button');
      close.type = 'button';
      close.className = 'tria-quote-sheet-close';
      close.setAttribute('aria-label', quoteTexts.sheetClose);
      close.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
      head.appendChild(title);
      head.appendChild(close);

      panel.appendChild(head);
      wrap.appendChild(backdrop);
      wrap.appendChild(panel);
      return wrap;
    }

    function setupMobileInvoice() {
      if (!asideEl) return;
      var mobile = window.innerWidth < 992;
      var inSheet = sheetEl && sheetEl.contains(asideEl);
      if (mobile && !inSheet) {
        if (!sheetEl) {
          /* Drop any stale sheet left by a previous init (locale swap) */
          var stale = document.querySelector('.tria-quote-sheet');
          if (stale) stale.remove();
          sheetEl = buildSheet();
        }
        asideParent = asideEl.parentNode;
        asideNext = asideEl.nextSibling;
        sheetEl.querySelector('.tria-quote-sheet-panel').appendChild(asideEl);
        asideEl.classList.add('is-in-sheet');
        document.body.appendChild(sheetEl);
      } else if (!mobile && inSheet) {
        setSheetOpen(false);
        if (asideParent) asideParent.insertBefore(asideEl, asideNext);
        if (sheetEl) { sheetEl.remove(); sheetEl = null; }
        asideEl.classList.remove('is-in-sheet');
      }
    }

    function setSheetOpen(open) {
      if (!sheetEl) return;
      sheetEl.classList.toggle('is-open', open);
      if (barEl) barEl.classList.toggle('is-open', open);
      if (barEl) barEl.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.classList.toggle('tria-sheet-open', open);
      if (window.triaLenis && typeof window.triaLenis.stop === 'function' && typeof window.triaLenis.start === 'function') {
        if (open) window.triaLenis.stop(); else window.triaLenis.start();
      }
    }

    function syncMobileBar() {
      if (!barEl) return;
      barEl.hidden = !!(success && !success.hidden) || window.innerWidth >= 992;
      if (barTotalEl && rangeEl) {
        var empty = asideEl && asideEl.classList.contains('is-empty');
        barTotalEl.textContent = empty ? '$0' : rangeEl.textContent;
      }
      if (barStepEl) barStepEl.textContent = (currentStep < 10 ? '0' : '') + currentStep + ' / ' + (totalSteps < 10 ? '0' : '') + totalSteps;
    }

    function onQuoteKeydown(e) {
      if (e.key === 'Escape' && sheetEl && sheetEl.classList.contains('is-open')) {
        setSheetOpen(false);
        if (barEl) barEl.focus({ preventScroll: true });
      }
    }

    if (barEl) {
      barEl.addEventListener('click', function () {
        if (!sheetEl) return;
        setSheetOpen(!sheetEl.classList.contains('is-open'));
      });
    }
    function onQuoteDocClick(e) {
      if (!sheetEl || !sheetEl.classList.contains('is-open')) return;
      if (e.target.closest('.tria-quote-sheet-backdrop') || e.target.closest('.tria-quote-sheet-close') ||
          e.target.closest('.tria-menu-btn') || e.target.closest('.tria-menu-close')) {
        setSheetOpen(false);
      }
    }
    if (document.addEventListener) {
      document.addEventListener('click', onQuoteDocClick);
      document.addEventListener('keydown', onQuoteKeydown);
    }

    var stepHeightTimer = null;
    function scheduleStepHeight() {
      clearTimeout(stepHeightTimer);
      stepHeightTimer = setTimeout(syncLayout, 120);
    }

    function onQuoteResize() {
      scheduleStepHeight();
      updateStepScroll();
      updateBreakdownScroll();
      setupMobileInvoice();
      syncMobileBar();
    }

    /* Re-init safety: remove listeners added by a previous init (locale swap) */
    if (window.__triaQuoteCleanup) window.__triaQuoteCleanup();
    window.addEventListener('resize', onQuoteResize);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () { setTimeout(syncLayout, 60); });
    }
    if (window.addEventListener) window.addEventListener('load', function () {
      setTimeout(syncLayout, 60);
    });
    window.__triaQuoteCleanup = function () {
      window.removeEventListener('resize', onQuoteResize);
      if (document.removeEventListener) {
        document.removeEventListener('click', onQuoteDocClick);
        document.removeEventListener('keydown', onQuoteKeydown);
      }
    };
    syncLayout();

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearContactError();
      if (currentStep < totalSteps) {
        if (!stepHasSelection(currentStep)) return;
        goTo(currentStep + 1);
        return;
      }
      submitFinal();
    });

    /* ── Reset ── */
    function resetAll() {
      form.querySelectorAll('input[type="radio"]').forEach(function (el) {
        el.checked = false;
      });
      form.querySelectorAll('input[type="checkbox"]').forEach(function (el) {
        el.checked = false;
      });
      ['quote-name', 'quote-email', 'quote-company', 'quote-phone', 'quote-notes'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
      });
      clearContactError();
      syncTypes(null);
      goTo(1);
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (successReset) successReset.addEventListener('click', function () {
      resetAll();
      shell.hidden = false;
      success.hidden = true;
      syncMobileBar();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* ── Contact form submit button (only shown on the last step) ── */
    var submitBtn = document.getElementById('quote-submit');
    var submitBtnText = submitBtn ? submitBtn.querySelector('.tria-btn-text') : null;

    /* ── Contact validation ── */
    var contactError = document.getElementById('quote-contact-error');

    function clearContactError() {
      var nameEl = document.getElementById('quote-name');
      var emailEl = document.getElementById('quote-email');
      if (nameEl) nameEl.classList.remove('tria-quote-input--error');
      if (emailEl) emailEl.classList.remove('tria-quote-input--error');
      if (contactError) contactError.textContent = '';
    }

    /* ── Turnstile ── */
    function loadTurnstile() {
      if (typeof turnstile !== 'undefined') return;
      var script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    function getTurnstileToken() {
      return new Promise(function (resolve) {
        if (typeof turnstile === 'undefined' || !turnstile.render) {
          resolve('');
          return;
        }
        var container = document.getElementById('quote-turnstile-container');
        if (!container) {
          container = document.createElement('div');
          container.id = 'quote-turnstile-container';
          container.style.display = 'none';
          form.appendChild(container);
        }
        turnstile.render(container, {
          sitekey: turnstileSiteKey,
          callback: function (token) { resolve(token); },
          'error-callback': function () { resolve(''); },
          'expired-callback': function () { resolve(''); },
        });
      });
    }

    /* ── Build the message summary for the lead ── */
    function buildSummary() {
      var lines = [];
      if (docnoEl) lines.push('#' + docnoEl.textContent + ' (' + (docdateEl ? docdateEl.textContent : '') + ')');
      var typeNames = Array.prototype.map.call(selectedTypes(), function (el) {
        return el.getAttribute('data-label');
      });
      lines.push(quoteTexts.typeLabel + ': ' + typeNames.join(', '));
      var scaleLabels = activeScaleLabels();
      lines.push(quoteTexts.sections.screens + ': ' + (scaleLabels.length ? scaleLabels.join(', ') : '-'));
      [['complexity'], ['users'], ['deadline'], ['design'], ['integrations']].forEach(function (g) {
        var el = getSelected(g[0]);
        if (el) lines.push(quoteTexts.sections[g[0]] + ': ' + el.getAttribute('data-label'));
      });
      var featNames = Array.prototype.map.call(form.querySelectorAll('input[name="features"]:checked'), function (el) {
        return el.getAttribute('data-label');
      });
      lines.push(quoteTexts.sections.features + ': ' + (featNames.length ? featNames.join(', ') : '-'));
      lines.push(quoteTexts.total + ': ' + rangeEl.textContent + ' (' + weeksEl.textContent + ')');
      return lines.join('\n');
    }

    function submitFinal() {
      var nameEl = document.getElementById('quote-name');
      var emailEl = document.getElementById('quote-email');
      var companyEl = document.getElementById('quote-company');
      var phoneEl = document.getElementById('quote-phone');
      var notesEl = document.getElementById('quote-notes');
      var name = nameEl ? nameEl.value.trim() : '';
      var email = emailEl ? emailEl.value.trim() : '';
      var company = companyEl ? companyEl.value.trim() : '';
      var phone = phoneEl ? phoneEl.value.trim() : '';
      var notes = notesEl ? notesEl.value.trim() : '';

      var valid = true;
      if (!name) { if (nameEl) nameEl.classList.add('tria-quote-input--error'); valid = false; }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { if (emailEl) emailEl.classList.add('tria-quote-input--error'); valid = false; }
      if (!valid) {
        if (contactError) contactError.textContent = quoteTexts.contactRequired;
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = quoteTexts.sending;
      }

      getTurnstileToken().then(function (turnstileToken) {
        var summary = buildSummary();
        if (company) summary += '\n' + quoteTexts.companyLabel + ': ' + company;
        if (phone) summary += '\n' + quoteTexts.phoneLabel + ': ' + phone;
        if (notes) summary += '\n' + quoteTexts.notesLabel + ': ' + notes;

        var data = {
          source: 'quote',
          name: name,
          email: email,
          company: company,
          budget: rangeEl.textContent,
          services: [Array.prototype.map.call(selectedTypes(), function (el) { return el.getAttribute('data-label'); }).join(', '), activeScaleLabels().join(', '), getSelected('complexity').getAttribute('data-label')],
          message: summary,
          turnstileToken: turnstileToken,
        };

        fetch('/api/create-jira-ticket', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = quoteTexts.sendCta;
          }
          if (result && result.success) {
            setSheetOpen(false);
            shell.hidden = true;
            success.hidden = false;
            if (barEl) barEl.hidden = true;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            if (contactError) contactError.textContent = (result && result.error) || '';
          }
        })
        .catch(function () {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = quoteTexts.sendCta;
          }
          if (contactError) contactError.textContent = quoteTexts.contactRequired;
        });
      });
    }

    /* ── Init ── */
    updateNav();
    updateStepScroll();
    calc();
    loadTurnstile();
    setupMobileInvoice();
    syncMobileBar();
  }

  initQuote();
  if (!window.__triaQuoteBound) {
    window.__triaQuoteBound = true;
    /* The locale swap replaces #swup content without re-running inline scripts,
       so re-bind the wizard after the swap. */
    document.addEventListener('swup:contentReplaced', function () {
      initQuote();
    });
  }
</script>
