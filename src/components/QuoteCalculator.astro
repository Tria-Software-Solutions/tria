  }

  /* ── Success state ── */
  .tria-quote-success {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: 40px 0 0;
  }

  .tria-quote-success[hidden] {
    display: none;
  }

  .tria-quote-success-card {
    max-width: 560px;
    width: 100%;
    text-align: center;
    padding: 56px 48px;
    border-radius: 24px;
    border: 1px solid rgba(6, 142, 140, 0.22);
    background: #ffffff;
    box-shadow: 0 8px 40px rgba(6, 142, 140, 0.08), 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .tria-quote-success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent);
    margin-bottom: 24px;
  }

  .tria-quote-success-title {
    font-size: 1.6rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    color: #0b0d17;
    margin: 0 0 12px;
  }

  .tria-quote-success-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.55);
    margin: 0 0 32px;
  }

  .tria-quote-success-reset {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.4);
    transition: color 0.3s ease;
  }

  .tria-quote-success-reset:hover {
