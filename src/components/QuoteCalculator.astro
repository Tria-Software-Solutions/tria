---
import Button from "./Button.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";

/* ── Project type (base price + timeline) ── */
const types = [
  { key: 'landing', label: t("quote.typeLanding"), desc: t("quote.typeLandingDesc"), base: 400, weeks: [2, 4] },
  { key: 'website', label: t("quote.typeWebsite"), desc: t("quote.typeWebsiteDesc"), base: 800, weeks: [3, 6] },
  { key: 'ecommerce', label: t("quote.typeEcommerce"), desc: t("quote.typeEcommerceDesc"), base: 1800, weeks: [6, 10] },
  { key: 'webapp', label: t("quote.typeWebapp"), desc: t("quote.typeWebappDesc"), base: 2500, weeks: [8, 14] },
  { key: 'mobile', label: t("quote.typeMobile"), desc: t("quote.typeMobileDesc"), base: 3500, weeks: [10, 16] },
  { key: 'backend', label: t("quote.typeBackend"), desc: t("quote.typeBackendDesc"), base: 2500, weeks: [6, 12] },
  { key: 'ai', label: t("quote.typeAi"), desc: t("quote.typeAiDesc"), base: 4000, weeks: [8, 16] },
  { key: 'custom', label: t("quote.typeCustom"), desc: t("quote.typeCustomDesc"), base: 6000, weeks: [12, 24] },
];

/* ── Screens & pages ── */
const screens = [
  { key: 's1', label: t("quote.screens1"), desc: t("quote.screens1Desc"), mult: 1 },
  { key: 's2', label: t("quote.screens2"), desc: t("quote.screens2Desc"), mult: 1.35 },
  { key: 's3', label: t("quote.screens3"), desc: t("quote.screens3Desc"), mult: 1.8 },
  { key: 's4', label: t("quote.screens4"), desc: t("quote.screens4Desc"), mult: 2.4 },
  { key: 's5', label: t("quote.screens5"), desc: t("quote.screens5Desc"), mult: 3.2 },
];

/* ── Complexity ── */
const complexities = [
  { key: 'basic', label: t("quote.complexityBasic"), desc: t("quote.complexityBasicDesc"), mult: 1 },
  { key: 'standard', label: t("quote.complexityStandard"), desc: t("quote.complexityStandardDesc"), mult: 1.25 },
  { key: 'advanced', label: t("quote.complexityAdvanced"), desc: t("quote.complexityAdvancedDesc"), mult: 1.6 },
];

/* ── Expected users ── */
const users = [
  { key: 'u1', label: t("quote.users1"), desc: t("quote.users1Desc"), mult: 1 },
  { key: 'u2', label: t("quote.users2"), desc: t("quote.users2Desc"), mult: 1.12 },
  { key: 'u3', label: t("quote.users3"), desc: t("quote.users3Desc"), mult: 1.3 },
  { key: 'u4', label: t("quote.users4"), desc: t("quote.users4Desc"), mult: 1.55 },
  { key: 'u5', label: t("quote.users5"), desc: t("quote.users5Desc"), mult: 1.85 },
];

/* ── Deadline ── */
const deadlines = [
  { key: 'd1', label: t("quote.deadline1"), desc: t("quote.deadline1Desc"), mult: 0.9 },
  { key: 'd2', label: t("quote.deadline2"), desc: t("quote.deadline2Desc"), mult: 1 },
  { key: 'd3', label: t("quote.deadline3"), desc: t("quote.deadline3Desc"), mult: 1.2 },
  { key: 'd4', label: t("quote.deadline4"), desc: t("quote.deadline4Desc"), mult: 1.35 },
];

/* ── UI/UX design ── */
const designs = [
  { key: 'ds1', label: t("quote.design1"), desc: t("quote.design1Desc"), mult: 0.92 },
  { key: 'ds2', label: t("quote.design2"), desc: t("quote.design2Desc"), mult: 1 },
  { key: 'ds3', label: t("quote.design3"), desc: t("quote.design3Desc"), mult: 1.25 },
];

/* ── Integrations ── */
const integrations = [
  { key: 'i1', label: t("quote.integrations1"), desc: t("quote.integrations1Desc"), mult: 1 },
  { key: 'i2', label: t("quote.integrations2"), desc: t("quote.integrations2Desc"), mult: 1.1 },
  { key: 'i3', label: t("quote.integrations3"), desc: t("quote.integrations3Desc"), mult: 1.22 },
  { key: 'i4', label: t("quote.integrations4"), desc: t("quote.integrations4Desc"), mult: 1.4 },
];

/* ── Features (additive) ── */
const features = [
  { key: 'auth', label: t("quote.featureAuth"), price: 350 },
  { key: 'admin', label: t("quote.featureAdmin"), price: 600 },
  { key: 'payments', label: t("quote.featurePayments"), price: 500 },
  { key: 'integrations', label: t("quote.featureIntegrations"), price: 400 },
  { key: 'cms', label: t("quote.featureCms"), price: 350 },
  { key: 'multilang', label: t("quote.featureMultilang"), price: 250 },
  { key: 'uiux', label: t("quote.featureUiux"), price: 700 },
  { key: 'seo', label: t("quote.featureSeo"), price: 250 },
  { key: 'analytics', label: t("quote.featureAnalytics"), price: 200 },
  { key: 'security', label: t("quote.featureSecurity"), price: 400 },
  { key: 'support', label: t("quote.featureSupport"), price: 300 },
  { key: 'maintenance', label: t("quote.featureMaintenance"), price: 300 },
];

interface Props {
  showHeader?: boolean;
}

const { showHeader = false } = Astro.props;

const quoteTexts = {
  weeks: t("quote.resultTimelineValue"),
  base: t("quote.resultBase"),
  screens: t("quote.resultScreens"),
  complexity: t("quote.resultComplexity"),
  users: t("quote.resultUsers"),
  deadline: t("quote.resultDeadline"),
  design: t("quote.resultDesign"),
  integrations: t("quote.resultIntegrations"),
  features: t("quote.resultFeatures"),
  total: t("quote.resultTotal"),
  more: "+{n}",
  sendCta: t("quote.sendCta"),
  sending: t("quote.sending"),
  successTitle: t("quote.successTitle"),
  successText: t("quote.successText"),
  contactRequired: t("quote.contactRequired"),
  resultCta: t("quote.resultCta"),
  reset: t("quote.resultReset"),
};

/* Minimal line icons per project type (24×24, stroke-based) — inner SVG markup */
const typeIcons: Record<string, string> = {
  landing:
    '<rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M3 9h18M8 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  website:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle><path d="M3 12h18M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.5-4-9s1.5-6.5 4-9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>',
  ecommerce:
    '<path d="M6 8h12l-1 12.5H7L6 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  webapp:
    '<rect x="4" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>',
  mobile:
    '<rect x="7" y="2.5" width="10" height="19" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M11 18.5h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  backend:
    '<rect x="3" y="4" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5"></rect><rect x="3" y="13" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 7.5h.01M7 16.5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>',
  ai:
    '<rect x="6" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5"></rect><rect x="10" y="10" width="4" height="4" stroke="currentColor" stroke-width="1.5"></rect><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>',
  custom:
    '<path d="M12 3l9 5-9 5-9-5 9-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>',
};

function typeIconSvg(key: string) {
  const inner = typeIcons[key] || typeIcons.landing;
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">${inner}</svg>`;
}
---

<section id="quote" class="tria-quote-section" data-section-theme="light">
  <div class="tria-quote-glow tria-quote-glow--1"></div>
  <div class="tria-quote-glow tria-quote-glow--2"></div>
  <div class="container tria-p-120-120">
    {showHeader && (
      <div class="tria-quote-header">
        <div class="row justify-content-between">
          <div class="col-lg-7">
            <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="quote.suptitle">{t("quote.suptitle")}</span>
            <h2 class="tria-up tria-mt-30" set:html={t("quote.heading")} />
          </div>
          <div class="col-lg-4 tria-quote-intro-col">
            <p class="tria-up tria-quote-intro" data-i18n="quote.description">{t("quote.description")}</p>
          </div>
        </div>
      </div>
    )}

    <div class="tria-quote-layout tria-up" id="tria-quote-layout">
      {/* ── Form ── */}
      <form class="tria-quote-form" id="tria-quote-form" novalidate>
        {/* Step 1 — Type */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepType">{t("quote.stepType")}</legend>
          <div class="tria-quote-types">
            {types.map((type, i) => (
              <label class="tria-quote-type">
                <input type="radio" name="type" value={type.key} data-base={type.base} data-weeks={JSON.stringify(type.weeks)} data-label={type.label} checked={i === 0} />
                <span class="tria-quote-type-card">
                  <span class="tria-quote-type-icon" set:html={typeIconSvg(type.key)}></span>
                  <span class="tria-quote-type-copy">
                    <span class="tria-quote-type-name">{type.label}</span>
                    <span class="tria-quote-type-desc">{type.desc}</span>
                  </span>
                  <span class="tria-quote-type-radio" aria-hidden="true">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="none">
                      <path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 2 — Screens */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepScreens">{t("quote.stepScreens")}</legend>
          <div class="tria-quote-pills">
            {screens.map((s, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="screens" value={s.key} data-mult={s.mult} data-label={s.label} checked={i === 1} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{s.label}</span>
                  <span class="tria-quote-pill-desc">{s.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 3 — Complexity */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepComplexity">{t("quote.stepComplexity")}</legend>
          <div class="tria-quote-pills tria-quote-pills--3">
            {complexities.map((c, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="complexity" value={c.key} data-mult={c.mult} data-label={c.label} checked={i === 1} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{c.label}</span>
                  <span class="tria-quote-pill-desc">{c.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 4 — Users */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepUsers">{t("quote.stepUsers")}</legend>
          <div class="tria-quote-pills">
            {users.map((u, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="users" value={u.key} data-mult={u.mult} data-label={u.label} checked={i === 1} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{u.label}</span>
                  <span class="tria-quote-pill-desc">{u.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 5 — Deadline */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepDeadline">{t("quote.stepDeadline")}</legend>
          <div class="tria-quote-pills tria-quote-pills--4">
            {deadlines.map((dl, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="deadline" value={dl.key} data-mult={dl.mult} data-label={dl.label} checked={i === 1} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{dl.label}</span>
                  <span class="tria-quote-pill-desc">{dl.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 6 — Design */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepDesign">{t("quote.stepDesign")}</legend>
          <div class="tria-quote-pills tria-quote-pills--3">
            {designs.map((ds, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="design" value={ds.key} data-mult={ds.mult} data-label={ds.label} checked={i === 1} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{ds.label}</span>
                  <span class="tria-quote-pill-desc">{ds.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 7 — Integrations */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepIntegrations">{t("quote.stepIntegrations")}</legend>
          <div class="tria-quote-pills tria-quote-pills--4">
            {integrations.map((ig, i) => (
              <label class="tria-quote-pill">
                <input type="radio" name="integrations" value={ig.key} data-mult={ig.mult} data-label={ig.label} checked={i === 0} />
                <span class="tria-quote-pill-inner">
                  <span class="tria-quote-pill-name">{ig.label}</span>
                  <span class="tria-quote-pill-desc">{ig.desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 8 — Features */}
        <fieldset class="tria-quote-step">
          <legend class="tria-quote-step-label" data-i18n="quote.stepFeatures">{t("quote.stepFeatures")}</legend>
          <div class="tria-quote-features">
            {features.map((f) => (
              <label class="tria-quote-feature">
                <input type="checkbox" name="features" value={f.key} data-price={f.price} data-label={f.label} />
                <span class="tria-quote-feature-check">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="tria-quote-feature-label">{f.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Step 9 — Contact */}
        <fieldset class="tria-quote-step tria-quote-step--contact">
          <legend class="tria-quote-step-label" data-i18n="quote.stepContact">{t("quote.stepContact")}</legend>
          <div class="tria-quote-contact">
            <div class="tria-quote-contact-row">
              <div class="tria-quote-field">
                <label class="tria-quote-field-label" for="quote-name" data-i18n="quote.contactName">{t("quote.contactName")}</label>
                <input class="tria-quote-input" type="text" id="quote-name" name="name" data-i18n-placeholder="quote.contactNamePh" placeholder={t("quote.contactNamePh")} />
              </div>
              <div class="tria-quote-field">
                <label class="tria-quote-field-label" for="quote-email" data-i18n="quote.contactEmail">{t("quote.contactEmail")}</label>
                <input class="tria-quote-input" type="email" id="quote-email" name="email" data-i18n-placeholder="quote.contactEmailPh" placeholder={t("quote.contactEmailPh")} />
              </div>
            </div>
            <div class="tria-quote-field">
              <label class="tria-quote-field-label" for="quote-company" data-i18n="quote.contactCompany">{t("quote.contactCompany")}</label>
              <input class="tria-quote-input" type="text" id="quote-company" name="company" data-i18n-placeholder="quote.contactCompanyPh" placeholder={t("quote.contactCompanyPh")} />
            </div>
            <p class="tria-quote-contact-error" id="quote-contact-error" role="alert"></p>
          </div>
        </fieldset>
      </form>

      {/* ── Result panel ── */}
      <aside class="tria-quote-result" id="tria-quote-result" aria-live="polite">
        <span class="tria-quote-result-kicker" data-i18n="quote.resultLabel">{t("quote.resultLabel")}</span>
        <div class="tria-quote-result-range" id="quote-range">$0</div>

        <div class="tria-quote-result-timeline">
          <span class="tria-quote-result-timeline-label" data-i18n="quote.resultTimeline">{t("quote.resultTimeline")}</span>
          <span class="tria-quote-result-timeline-value" id="quote-weeks"></span>
        </div>

        <div class="tria-quote-result-divider"></div>

        <span class="tria-quote-result-breakdown-label" data-i18n="quote.resultBreakdown">{t("quote.resultBreakdown")}</span>
        <ul class="tria-quote-result-breakdown" id="quote-breakdown"></ul>

        <p class="tria-quote-result-disclaimer" data-i18n="quote.resultDisclaimer">{t("quote.resultDisclaimer")}</p>

        <Button id="quote-submit" type="submit" form="tria-quote-form" text={t("quote.sendCta")} size="sm" fullWidth={true} />
        <Button text={t("quote.resultCta")} href="/contact" variant="outline" size="sm" showArrow={true} fullWidth={true} className="tria-quote-result-cta2" />
        <button type="button" class="tria-quote-reset" id="quote-reset" data-i18n="quote.resultReset">{t("quote.resultReset")}</button>
      </aside>
    </div>

    {/* ── Success state ── */}
    <div class="tria-quote-success" id="tria-quote-success" hidden>
      <div class="tria-quote-success-card">
        <span class="tria-quote-success-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h3 class="tria-quote-success-title" data-i18n="quote.successTitle">{t("quote.successTitle")}</h3>
        <p class="tria-quote-success-text" data-i18n="quote.successText">{t("quote.successText")}</p>
        <button type="button" class="tria-quote-success-reset" id="quote-success-reset" data-i18n="quote.resultReset">{t("quote.resultReset")}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .tria-quote-section {
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  .tria-quote-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.04) 1px, transparent 0);
    background-size: 36px 36px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 30% 0%, black 15%, transparent 65%);
    -webkit-mask-image: radial-gradient(ellipse at 30% 0%, black 15%, transparent 65%);
  }

  .tria-quote-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    opacity: 0.1;
  }

  .tria-quote-glow--1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #068e8c 0%, transparent 70%);
    top: -200px;
    right: -140px;
  }

  .tria-quote-glow--2 {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, #068e8c 0%, transparent 70%);
    bottom: -180px;
    left: -120px;
  }

  .tria-quote-section .tria-suptitle::before {
    background-color: rgba(6, 142, 140, 0.35);
  }

  .tria-quote-section h2 {
    color: #0b0d17;
  }

  .tria-quote-section :global(.tria-thin) {
    color: rgba(0, 0, 0, 0.25);
    font-weight: 300;
  }

  .tria-quote-header {
    margin-bottom: 72px;
    position: relative;
    z-index: 1;
  }

  .tria-quote-section .container.tria-p-120-120 {
    padding-top: 60px;
    padding-bottom: 120px;
  }

  .tria-quote-intro-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 8px;
  }

  .tria-quote-intro {
    line-height: 1.7;
    font-size: 1rem;
    color: rgba(0, 0, 0, 0.5);
    margin: 0;
  }

  /* ── Layout ── */
  .tria-quote-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
    position: relative;
    z-index: 1;
  }

  /* ── Steps ── */
  .tria-quote-step {
    border: none;
    padding: 0;
    margin: 0 0 48px;
  }

  .tria-quote-step-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
    margin-bottom: 22px;
    padding: 0;
  }

  .tria-quote-step-label::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--accent);
    opacity: 0.45;
  }

  /* Type cards */
  .tria-quote-types {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tria-quote-type {
    cursor: pointer;
  }

  .tria-quote-type input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tria-quote-type-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 18px;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 16px rgba(0, 0, 0, 0.03);
