<style>
  .tria-tech-marquee {
    margin-top: 8px;
    padding-bottom: 120px;
    position: relative;
    z-index: 1;
  }

  .tria-tech-marquee-inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tria-marquee-row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .tria-marquee-track {
    display: flex;
    gap: 10px;
    width: max-content;
    animation: tria-marquee-scroll 160s linear infinite;
    padding: 8px 0;
  }

  .tria-marquee-row--right .tria-marquee-track {
    animation-direction: normal;
  }

  .tria-marquee-row--left .tria-marquee-track {
    animation-direction: reverse;
  }

  @keyframes tria-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .tria-marquee-icon {
    font-size: 56px;
    color: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
    transition: color 0.3s var(--ease-spring), transform 0.3s var(--ease-spring);
    cursor: default;
    position: relative;
  }

  .tria-marquee-icon::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) scale(0.8);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 500;
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s var(--ease-spring);
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .tria-marquee-icon:hover::after {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .tria-marquee-track {
    gap: 64px;
  }

  @media (max-width: 768px) {
    .tria-marquee-icon {
      font-size: 40px;
    }
    .tria-marquee-track {
      gap: 36px;
    }
  }

  @media (max-width: 576px) {
    .tria-marquee-icon {
      font-size: 32px;
    }
    .tria-marquee-track {
      gap: 24px;
    }
    .tria-marquee-icon::after {
      display: none;
    }
  }
</style>
