---
interface Props {
  suptitleKey?: string;
  headingKey: string;
  descriptionKey?: string;
  crumbKey?: string;
  variant?: "primary" | "secondary";
}

const { suptitleKey, headingKey, descriptionKey, crumbKey, variant = "secondary" } = Astro.props;
const { createT, localePath } = await import("../i18n/utils");
const t = createT(Astro.currentLocale);
const hasChildren = await Astro.slots.render("default");
const heroClass = variant === "primary" ? "page-hero" : "page-hero page-hero--secondary";
const homeHref = localePath(Astro.currentLocale, "/");
---

<section class={heroClass} data-section-theme="dark">
  <div class="page-hero-bg">
    <!-- WebGL interactive gradient (canvas injected here) -->
    <div class="tria-hero-bg" data-grad-props='{"color1":"#0f111a","color2":"#1a1d2e","color3":"#1a3538","timeSpeed":1.2,"warpStrength":0.6,"warpFrequency":4,"blendAngle":45,"rotationAmount":300,"noiseScale":1.5,"contrast":1.3,"saturation":0.5,"zoom":0.7,"centerY":-0.1}'></div>
    <div class="page-hero-bg-dots"></div>
    <div class="page-hero-orb page-hero-orb--1"></div>
    <div class="page-hero-orb page-hero-orb--2"></div>
    <div class="page-hero-gradient-overlay"></div>
    <div class="tria-hero-grain"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
    </div>
  </div>
  <div class="container page-hero-inner">
    {crumbKey && (
      <nav class="tria-hero-crumb tria-up" aria-label="Breadcrumb">
        <a href={homeHref} class="tria-hero-crumb-link" data-i18n="nav.home">{t("nav.home")}</a>
        <span class="tria-hero-crumb-sep" aria-hidden="true">/</span>
        <span class="tria-hero-crumb-current" aria-current="page" data-i18n={crumbKey}>{t(crumbKey)}</span>
      </nav>
    )}
    {hasChildren ? (
      <div class="row">
        <div class="col-lg-8">
          {suptitleKey && <span class="tria-suptitle tria-light-soft tria-up" style="display:block;margin-bottom:20px;" data-i18n={suptitleKey}>{t(suptitleKey)}</span>}
          <h1 class="tria-up page-hero-heading" data-i18n-html={headingKey} set:html={t(headingKey)} />
          {descriptionKey && <p class="tria-up page-hero-sub" data-i18n={descriptionKey}>{t(descriptionKey)}</p>}
        </div>
        <div class="col-lg-4">
          <slot />
        </div>
      </div>
    ) : descriptionKey ? (
      <div class="row">
        <div class="col-lg-7">
          {suptitleKey && <span class="tria-suptitle tria-light-soft tria-up" style="display:block;margin-bottom:20px;" data-i18n={suptitleKey}>{t(suptitleKey)}</span>}
          <h1 class="page-hero-heading tria-up" data-i18n-html={headingKey} set:html={t(headingKey)} />
        </div>
        <div class="col-lg-4 offset-lg-1 tria-up">
          <p class="page-hero-sub" data-i18n={descriptionKey}>{t(descriptionKey)}</p>
        </div>
      </div>
    ) : (
      <div>
        {suptitleKey && <span class="tria-suptitle tria-light-soft tria-up" style="display:block;margin-bottom:20px;" data-i18n={suptitleKey}>{t(suptitleKey)}</span>}
        <h1 class="page-hero-heading tria-up" data-i18n-html={headingKey} set:html={t(headingKey)} />
      </div>
    )}
  </div>
</section>
