---
import Button from "./Button.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);

interface PricingPlan {
  name: string;
  price: string;
  period?: string;
  description?: string;
  features?: string[];
  featureCategories?: string[];
  highlighted?: boolean;
  buttonText?: string;
  buttonHref?: string;
  /* Structured price display (modern cards) */
  amount?: string;
  prefix?: string;
  suffix?: string;
}

interface Props {
  suptitle?: string;
  heading: string;
  description?: string;
  plans: PricingPlan[];
  theme?: 'light' | 'dark';
  padding?: string;
  suptitleKey?: string;
  headingKey?: string;
  descriptionKey?: string;
}

const {
  suptitle,
  heading,
  description,
  plans = [],
  theme = 'light',
  padding = 'tria-p-120-120',
  suptitleKey,
  headingKey,
  descriptionKey
} = Astro.props;

const CATEGORIES: { key: string; label: string }[] = [
  { key: 'website', label: t("pricing.catWebsite") },
  { key: 'seoPerf', label: t("pricing.catSeoPerf") },
  { key: 'ecom', label: t("pricing.catEcom") },
  { key: 'webApp', label: t("pricing.catWebApp") },
  { key: 'mobile', label: t("pricing.catMobile") },
  { key: 'backend', label: t("pricing.catBackend") },
  { key: 'aiAuto', label: t("pricing.catAiAuto") },
  { key: 'devops', label: t("pricing.catDevops") },
  { key: 'security', label: t("pricing.catSecurity") },
  { key: 'support', label: t("pricing.catSupport") },
  { key: 'desktop', label: t("pricing.catDesktop") },
];

function isCustomPlan(plan: PricingPlan): boolean {
  return !!(plan.buttonHref && !plan.period && !plan.featureCategories?.length);
}

function planFeatures(plan: PricingPlan): { label: string; key: string }[] {
  if (!plan.featureCategories) return [];
  return plan.featureCategories
    .map((k) => CATEGORIES.find((c) => c.key === k))
    .filter((c): c is { key: string; label: string } => !!c);
}

const tablePlans = plans.filter(p => !isCustomPlan(p));
const customPlan = plans.find(p => isCustomPlan(p));
const showTable = tablePlans.length > 0;
const popularLabel = t("pricing.popular");
const ctaDefault = t("nav.startProject");
---

<section id="pricing" class={`tria-pricing-section tria-pricing-${theme === 'dark' ? 'dark' : 'light'}`} data-section-theme={theme}>
  <div class={`container ${padding}`}>
    <div class="tria-pricing-header">
      <div class="row justify-content-between">
        <div class="col-lg-7">
          {suptitle && <span class={`tria-suptitle tria-up ${theme === 'dark' ? '' : 'tria-suptitle-dark'}`} data-i18n={suptitleKey || undefined}>{suptitle}</span>}
          <h2 class="tria-up tria-mt-30" set:html={heading} data-i18n-html={headingKey || undefined} />
        </div>
        {description && (
          <div class="col-lg-4 tria-pricing-intro-col">
            <p class="tria-up tria-pricing-intro" data-i18n={descriptionKey || undefined}>{description}</p>
          </div>
        )}
      </div>
    </div>

    {showTable && (
      <div class="tria-pricing-body tria-up">
        {/* ── Modern plan cards ── */}
        <div class="tria-pricing-cards">
          {tablePlans.map((plan) => {
            const featured = !!plan.highlighted;
            return (
              <article class={`tria-pricing-card${featured ? ' tria-pricing-card--highlighted' : ''}`}>
                {featured && (
                  <span class="tria-pricing-badge" data-i18n="pricing.popular">{popularLabel}</span>
                )}
                <div class="tria-pricing-card-head">
                  <h3 class="tria-pricing-card-name">{plan.name}</h3>
                  {plan.description && <p class="tria-pricing-card-desc">{plan.description}</p>}
                </div>

                <div class="tria-pricing-card-price-row">
                  {plan.amount ? (
                    <>
                      {plan.prefix && <span class="tria-pricing-price-prefix" data-i18n="pricing.fromLabel">{plan.prefix}</span>}
                      <span class="tria-pricing-card-price">{plan.amount}</span>
                      {plan.suffix && <span class="tria-pricing-price-suffix" data-i18n="pricing.projectPeriod">{plan.suffix}</span>}
                    </>
                  ) : (
                    <span class="tria-pricing-card-price">{plan.price}</span>
                  )}
                </div>

                <div class="tria-pricing-card-divider"></div>

                <ul class="tria-pricing-card-features">
                  {planFeatures(plan).map((f) => (
                    <li>
                      <span class="tria-pricing-feat-check">
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>{f.label}</span>
                    </li>
                  ))}
                </ul>

                <div class="tria-pricing-card-cta">
                  <Button
                    text={plan.buttonText || ctaDefault}
                    href={plan.buttonHref || "/contact"}
                    variant={featured ? "primary" : "outline"}
                    size="sm"
                    fullWidth={true}
                  />
                </div>
              </article>
            );
          })}
        </div>

        {/* ── Custom Solution + Estimator card ── */}
        {customPlan && (
          <div class="tria-pricing-custom">
            <div class="tria-pricing-custom-card">
              <div class="tria-pricing-custom-body">
                <div class="tria-pricing-custom-header">
                  <h3 class="tria-pricing-custom-name">{customPlan.name}</h3>
                  {customPlan.description && <p class="tria-pricing-custom-desc">{customPlan.description}</p>}
                </div>
                <ul class="tria-pricing-custom-features">
                  {['pricing.plan4Feature1','pricing.plan4Feature2','pricing.plan4Feature3','pricing.plan4Feature4','pricing.plan4Feature5'].map((key) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 9l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span data-i18n={key}>{t(key)}</span>
                    </li>
                  ))}
                </ul>
                <div class="tria-pricing-custom-cta">
                  <Button text={customPlan.buttonText || customPlan.price} href={customPlan.buttonHref} showArrow={true} size="sm" />
                </div>
              </div>

              {/* ── Estimate strip ── */}
              <div class="tria-pricing-estimator">
                <div class="tria-pricing-estimator-copy">
                  <span class="tria-pricing-estimator-icon">
                    <i class="ti ti-calculator" aria-hidden="true"></i>
                  </span>
                  <div>
                    <strong class="tria-pricing-estimator-title" data-i18n="pricing.estimatorTitle">{t("pricing.estimatorTitle")}</strong>
                    <p class="tria-pricing-estimator-desc" data-i18n="pricing.estimatorDesc">{t("pricing.estimatorDesc")}</p>
                  </div>
                </div>
                <Button text={t("pricing.estimatorCta")} href="/quote" variant="secondary" size="sm" showArrow={true} />
              </div>
            </div>
          </div>
        )}

      </div>
    )}

  </div>
</section>

<style>
  .tria-pricing-section {
    position: relative;
    overflow: hidden;
  }

  .tria-pricing-light {
    background: #ffffff;
  }

  .tria-pricing-dark {
    background: #0b0d17;
  }

  .tria-pricing-header {
    margin-bottom: 72px;
  }

  .tria-pricing-section .tria-suptitle::before {
    background-color: rgba(6, 142, 140, 0.3);
  }

  .tria-pricing-dark h2 {
    color: #fff;
  }

  .tria-pricing-intro-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 8px;
  }

  .tria-pricing-intro {
    line-height: 1.7;
    font-size: 1rem;
    color: rgba(0, 0, 0, 0.5);
    margin: 0;
  }

  .tria-pricing-dark .tria-pricing-intro {
    color: rgba(255, 255, 255, 0.5);
  }

  /* ══ Modern plan cards ══ */
  .tria-pricing-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .tria-pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 36px 32px 32px;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02), 0 8px 32px rgba(0, 0, 0, 0.04);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease;
  }

  .tria-pricing-card:hover {
    transform: translateY(-6px);
    border-color: rgba(6, 142, 140, 0.18);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04), 0 16px 48px rgba(0, 0, 0, 0.07);
  }

  .tria-pricing-dark .tria-pricing-card {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.07);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  .tria-pricing-dark .tria-pricing-card:hover {
    border-color: rgba(6, 142, 140, 0.35);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Highlighted card — gradient border + glow */
  .tria-pricing-card--highlighted {
    border: 1.5px solid transparent;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(165deg, rgba(6, 142, 140, 0.55) 0%, rgba(6, 142, 140, 0.12) 45%, rgba(6, 142, 140, 0.45) 100%) border-box;
    box-shadow: 0 4px 20px rgba(6, 142, 140, 0.08), 0 12px 48px rgba(6, 142, 140, 0.1);
  }

  .tria-pricing-card--highlighted:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 28px rgba(6, 142, 140, 0.12), 0 20px 64px rgba(6, 142, 140, 0.14);
  }

  .tria-pricing-dark .tria-pricing-card--highlighted {
    background:
      linear-gradient(rgba(20, 24, 40, 0.9), rgba(20, 24, 40, 0.9)) padding-box,
      linear-gradient(165deg, rgba(6, 142, 140, 0.7) 0%, rgba(6, 142, 140, 0.15) 45%, rgba(6, 142, 140, 0.6) 100%) border-box;
  }

  /* Badge "Most popular" */
  .tria-pricing-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    padding: 7px 18px;
    border-radius: 100px;
    background: linear-gradient(135deg, #068e8c, #057573);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(6, 142, 140, 0.35);
  }

  /* Card head */
  .tria-pricing-card-head {
    margin-bottom: 28px;
  }

  .tria-pricing-card-name {
    font-size: 1.05rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: #0b0d17;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .tria-pricing-dark .tria-pricing-card-name {
    color: #fff;
  }

  .tria-pricing-card-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.45);
    margin: 0;
    font-weight: 380;
    letter-spacing: -0.01em;
  }

  .tria-pricing-dark .tria-pricing-card-desc {
    color: rgba(255, 255, 255, 0.4);
  }

  /* Price row */
  .tria-pricing-card-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tria-pricing-price-prefix {
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.35);
    font-weight: 420;
    letter-spacing: -0.01em;
  }

  .tria-pricing-dark .tria-pricing-price-prefix {
    color: rgba(255, 255, 255, 0.35);
  }

  .tria-pricing-card-price {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 320;
    letter-spacing: -0.04em;
    color: #0b0d17;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .tria-pricing-dark .tria-pricing-card-price {
    color: #fff;
  }

  .tria-pricing-price-suffix {
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.35);
    font-weight: 420;
  }

  .tria-pricing-dark .tria-pricing-price-suffix {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Divider */
  .tria-pricing-card-divider {
    height: 1px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.06), transparent 85%);
    margin-bottom: 24px;
  }

  .tria-pricing-dark .tria-pricing-card-divider {
    background: linear-gradient(to right, rgba(255, 255, 255, 0.08), transparent 85%);
  }

  /* Features */
  .tria-pricing-card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .tria-pricing-card-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.62);
    font-weight: 420;
    letter-spacing: -0.01em;
  }

  .tria-pricing-dark .tria-pricing-card-features li {
    color: rgba(255, 255, 255, 0.6);
  }

  .tria-pricing-feat-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(6, 142, 140, 0.1);
    color: var(--accent);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }

  .tria-pricing-card:hover .tria-pricing-feat-check {
    transform: scale(1.12);
    background: rgba(6, 142, 140, 0.16);
  }

  /* Card CTA */
  .tria-pricing-card-cta {
    margin-top: auto;
  }

  /* ══ Custom Solution + Estimator card ══ */
  .tria-pricing-custom {
    margin-top: 32px;
  }

  .tria-pricing-custom-card {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 44px 48px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b0d17;
    transition: border-color 0.4s ease;
  }

  .tria-pricing-custom-card:hover {
    border-color: rgba(6, 142, 140, 0.35);
  }

  .tria-pricing-custom-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 1.4fr auto;
    gap: 48px;
    align-items: center;
  }

  .tria-pricing-custom-header {
    position: relative;
    z-index: 1;
  }

  .tria-pricing-custom-name {
    display: block;
    font-size: 1.35rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: 10px;
  }

  .tria-pricing-custom-desc {
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 300px;
  }

  .tria-pricing-custom-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 32px;
    position: relative;
    z-index: 1;
  }

  .tria-pricing-custom-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.4;
    font-weight: 420;
  }

  .tria-pricing-custom-features li svg {
    flex-shrink: 0;
    color: var(--accent);
    width: 16px;
    height: 16px;
  }

  .tria-pricing-custom-cta {
    position: relative;
    z-index: 1;
    justify-self: end;
  }

  .tria-pricing-custom-cta :global(.tria-btn) {
    background: #fff;
    color: #0b0d17;
    font-weight: 600;
  }

  .tria-pricing-custom-cta :global(.tria-btn:hover) {
    background: #e8f1f0;
    color: #0b0d17;
  }

  /* ══ Estimate strip ══ */
  .tria-pricing-estimator {
    position: relative;
    z-index: 1;
    margin-top: 40px;
    padding-top: 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }

  .tria-pricing-estimator-copy {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
    min-width: 260px;
  }

  .tria-pricing-estimator-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: rgba(6, 142, 140, 0.14);
    color: var(--accent);
    font-size: 26px;
    line-height: 1;
  }

  .tria-pricing-estimator-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 560;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }

  .tria-pricing-estimator-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    max-width: 560px;
  }

  .tria-pricing-estimator :global(.tria-btn) {
    flex-shrink: 0;
    background: #fff;
    color: #0b0d17;
    font-weight: 600;
  }

  .tria-pricing-estimator :global(.tria-btn:hover) {
    background: #e8f1f0;
    color: #0b0d17;
  }

  /* ── Responsive ── */
  @media (max-width: 991px) {
    .tria-pricing-cards {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .tria-pricing-card--highlighted {
      transform: none;
    }

    .tria-pricing-card--highlighted:hover {
      transform: translateY(-4px);
    }

    .tria-pricing-custom-body {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .tria-pricing-custom-cta {
      justify-self: start;
    }
  }

  @media (max-width: 768px) {
    .tria-pricing-header {
      margin-bottom: 48px;
    }

    .tria-pricing-custom-features {
      grid-template-columns: 1fr;
    }

    .tria-pricing-estimator {
      margin-top: 32px;
      padding-top: 28px;
    }
  }

  @media (max-width: 576px) {
    .tria-pricing-card {
      padding: 32px 24px 28px;
    }

    .tria-pricing-estimator-copy {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .tria-pricing-estimator :global(.tria-btn) {
      width: 100%;
    }

    .tria-pricing-card-price {
      font-size: clamp(2.2rem, 9vw, 2.8rem);
    }

    .tria-pricing-custom-card {
      padding: 32px 24px;
    }

    .tria-pricing-custom-body {
      gap: 24px;
    }

    .tria-pricing-custom-cta :global(.tria-btn) {
      width: 100%;
    }

  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* ── Cards entrance animation ── */
    var cards = document.querySelectorAll('.tria-pricing-card');
    if (cards.length && typeof gsap !== 'undefined') {
      gsap.fromTo(cards, {
        y: 32,
        opacity: 0,
      }, {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.12,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: cards[0],
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      });
    }

    /* ── Badge pop ── */
    var badge = document.querySelector('.tria-pricing-badge');
    if (badge && typeof gsap !== 'undefined') {
      gsap.fromTo(badge, { scale: 0.7, opacity: 0 }, {
        scale: 1,
        opacity: 1,
        duration: 0.5,
        delay: 0.3,
        ease: 'back.out(1.8)',
        scrollTrigger: {
          trigger: badge,
          start: 'top 92%',
          toggleActions: 'play none none none',
        },
      });
    }

  });
</script>
