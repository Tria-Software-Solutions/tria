    descKey: "services.itCybersecurityDesc",
    overview: [
      isEs
        ? "Una vulnerabilidad es todo lo que necesita un atacante. Auditorías OWASP, pruebas de penetración, cumplimiento HIPAA/SOC2/ISO 27001 — cada capa de seguridad cierra una puerta que no sabías que estaba abierta."
        : "One vulnerability is all an attacker needs. OWASP audits, penetration testing, HIPAA/SOC2/ISO 27001 compliance — every security layer closes a door you didn't know was open.",
      isEs
        ? "Sistemas legacy que ralentizan tu equipo, costos cloud que crecen sin control, decisiones técnicas sin una visión clara. Diagnosticamos, priorizamos y ejecutamos — desde modernizar una base de datos hasta redefinir tu estrategia tecnológica."
        : "Legacy systems slowing your team, cloud costs growing unchecked, technical decisions without clear direction. We diagnose, prioritize, and execute — from modernizing a database to redefining your tech strategy.",
    ],
    features: [
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4v6c0 5.55-3.84 10.74-9 12-5.16-1.26-9-6.45-9-12V6z"/><path d="M9 12l2 2 4-4"/></svg>',
        title: isEs ? "Seguridad Integral" : "Comprehensive Security",
        desc: isEs ? "Auditorías de seguridad, pruebas de penetración, implementación Zero Trust y cumplimiento con estándares internacionales." : "Security audits, penetration testing, Zero Trust implementation, and international compliance standards.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M4 20V4"/><path d="M9 12h6"/><path d="M12 9v6"/></svg>',
        title: isEs ? "Modernización" : "Modernization",
        desc: isEs ? "Transformamos sistemas legacy en arquitecturas modernas, escalables y mantenibles sin interrumpir tus operaciones." : "We transform legacy systems into modern, scalable, maintainable architectures without disrupting your operations.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33-1.82l-2.1-3.76a1.66 1.66 0 0 0-2.23-.74L12 10"/><path d="M9.17 4.3a1.66 1.66 0 0 1 .83-2.2l3.76-1.57a1.66 1.66 0 0 1 2.18.86l1.94 4.15"/><path d="M4.6 9a1.65 1.65 0 0 0 .33 1.82l2.1 3.77a1.66 1.66 0 0 0 2.23.74L12 14"/><path d="M14.83 19.7a1.66 1.66 0 0 1-.83 2.2l-3.76 1.57a1.66 1.66 0 0 1-2.18-.86l-1.94-4.15"/></svg>',
        title: isEs ? "Optimización Cloud" : "Cloud Optimization",
        desc: isEs ? "Análisis y reducción de costos cloud, optimización de recursos, FinOps y mejora continua del rendimiento." : "Cloud cost analysis and reduction, resource optimization, FinOps, and continuous performance improvement.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-9.33-5"/><path d="M6 9a6 6 0 0 0 .3 6"/><path d="M8 12h8"/><path d="M12 8v8"/><circle cx="12" cy="12" r="10"/><path d="M12 2v2"/><path d="M12 20v2"/></svg>',
        title: isEs ? "Consultoría Estratégica" : "Strategic Consulting",
        desc: isEs ? "Arquitectura de referencia, selección de tecnologías y hoja de ruta tecnológica alineada con tus objetivos de negocio." : "Reference architecture, technology selection, and a technology roadmap aligned with your business goals.",
      },
    ],
    tools: [
      { group: t("serviceDetail.toolGroup.securityTesting"), items: ["OWASP", "Burp Suite", "Metasploit", "Nmap", "ZAP"] },
      { group: t("serviceDetail.toolGroup.complianceFrameworks"), items: ["SOC 2", "ISO 27001", "HIPAA", "GDPR"] },
      { group: t("serviceDetail.toolGroup.architectureDefense"), items: ["Zero Trust", "IAM", "SIEM", "WAF", "Cloud Security"] },
      { group: t("serviceDetail.toolGroup.observabilityResponse"), items: ["Incident Response", "Threat Modeling", "Vulnerability Management"] },
    ],
  },
  {
    num: "08",
    slug: "modernization",
    titleKey: "services.modernization",
    descKey: "services.modernizationDesc",
    overview: [
      isEs
        ? "Tu sistema legacy sigue pagando las cuentas, pero ya no puede crecer. Modernizamos lo que existe en vez de tirarlo: refactorizamos, migramos e integramos paso a paso, con riesgo controlado y sin detener tu operación."
        : "Your legacy system still pays the bills, but it can't grow anymore. We modernize what exists instead of throwing it away: refactor, migrate, and integrate step by step, with controlled risk and no operational downtime.",
      isEs
        ? "ERP, CRM, APIs de terceros — conectamos todo tu ecosistema en un flujo de datos único. Bases de datos migradas, procesos automatizados y una arquitectura que por fin respira."
        : "ERP, CRM, third-party APIs — we connect your entire ecosystem into a single data flow. Migrated databases, automated processes, and an architecture that can finally breathe.",
    ],
    features: [
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>',
        title: isEs ? "Modernización de Legados" : "Legacy Modernization",
        desc: isEs ? "Refactorización incremental y migración a arquitecturas modernas con cero tiempo de inactividad." : "Incremental refactoring and migration to modern architectures with zero downtime.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
        title: isEs ? "Integraciones ERP / CRM" : "ERP / CRM Integration",
        desc: isEs ? "SAP, Salesforce, HubSpot y más — un solo flujo de datos entre tus sistemas de negocio críticos." : "SAP, Salesforce, HubSpot, and more — a single data flow between your critical business systems.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
        title: isEs ? "Integración de APIs" : "API Integration",
        desc: isEs ? "REST, GraphQL y SOAP — conectamos sistemas antiguos y nuevos en una capa de integración limpia." : "REST, GraphQL, and SOAP — we connect old and new systems through a clean integration layer.",
      },
      {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>',
        title: isEs ? "Migración de Datos" : "Data Migration",
        desc: isEs ? "Migraciones de datos planificadas, validadas y sin pérdidas — con rollback y verificación en cada fase." : "Planned, validated, lossless data migrations — with rollback and verification at every phase.",
      },
    ],
    tools: [
      { group: t("serviceDetail.toolGroup.integrationTech"), items: ["REST", "GraphQL", "SOAP", "Webhooks", "Message Queues"] },
      { group: t("serviceDetail.toolGroup.erpCrm"), items: ["SAP", "Salesforce", "HubSpot", "Dynamics", "NetSuite"] },
      { group: t("serviceDetail.toolGroup.dataMigration"), items: ["ETL", "dbt", "Fivetran", "PostgreSQL", "MongoDB"] },
      { group: t("serviceDetail.toolGroup.backendApis"), items: ["Node.js", "Go", "Python", "Java", ".NET"] },
    ],
  },
];

---

<Layout title={t("meta.servicesTitle")} description={t("meta.servicesDesc")}
  structuredData={{
    "@type": "CollectionPage",
    name: "Tria Services",
    description: t("meta.servicesDesc"),
    about: {
      "@type": "Organization",
      name: "Tria Software Solutions",
    },
  }}>

  <PageBanner suptitleKey="services.hero.suptitle" headingKey="services.hero.title" descriptionKey="services.hero.desc" />

  <!-- ═══════════════════════════════════════════════
       SERVICES & CAPABILITIES — light
       Fully detailed, self-contained service accordions
       ═══════════════════════════════════════════════ -->
  <section id="practices" class="tria-sc-section" data-section-theme="light">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
    </div>
    <div class="container tria-p-120-120">

      <!-- header -->
      <div class="tria-sc-header tria-up">
        <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="services.showcase.suptitle">{t("services.showcase.suptitle")}</span>
        <h2 class="tria-sc-heading" data-i18n-html="services.showcase.heading" set:html={t("services.showcase.heading")}></h2>
        <p class="tria-sc-sub" data-i18n="services.showcase.sub">{t("services.showcase.sub")}</p>
      </div>

      <!-- services — detailed accordion table -->
      <div class="tria-tbl">
        {services.map((service) => (
          <div class="tria-tbl-item tria-up" id={service.slug}>
            <div class="tria-tbl-row">
              <span class="tria-tbl-num">{service.num}</span>
              <div class="tria-tbl-main">
                <h3 class="tria-tbl-title" data-i18n={service.titleKey}>{t(service.titleKey)}</h3>
                <p class="tria-tbl-desc" data-i18n={service.descKey}>{t(service.descKey)}</p>
              </div>
              <button class="tria-tbl-toggle" type="button" aria-expanded="false" aria-controls={`detail-${service.slug}`} data-accordion-toggle>
                <span class="tria-tbl-toggle-more" data-i18n="services.showcase.viewMore">{t("services.showcase.viewMore")}</span>
                <span class="tria-tbl-toggle-less" data-i18n="services.showcase.viewLess">{t("services.showcase.viewLess")}</span>
                <svg class="tria-tbl-toggle-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="tria-tbl-detail" id={`detail-${service.slug}`} data-accordion-panel>
              <div class="tria-tbl-detail-inner">

              <!-- overview -->
              <div class="tria-tbl-overview">
                {service.overview.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

              <!-- features -->
              <div class="tria-tbl-feats">
                {service.features.map((feat) => (
                  <div class="tria-tbl-feat">
                    <span class="tria-tbl-feat-icon" set:html={feat.icon}></span>
                    <h4 class="tria-tbl-feat-title">{feat.title}</h4>
                    <p class="tria-tbl-feat-desc">{feat.desc}</p>
                  </div>
                ))}
              </div>

              <!-- tools -->
              <div class="tria-tbl-tools">
                {service.tools.map((toolGroup) => (
                  <div class="tria-tbl-tool-group">
                    <h5 class="tria-tbl-tool-group-title">{toolGroup.group}</h5>
                    <div class="tria-tbl-tool-chips">
                      {toolGroup.items.map((item) => (
                        <span>{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA — "not a closed list" -->
      <div class="tria-cap-cta tria-up">
        <p class="tria-cap-cta-title" data-i18n="services.cap.cta">{t("services.cap.cta")}</p>
        <p class="tria-cap-cta-sub" data-i18n="services.cap.ctaSub">{t("services.cap.ctaSub")}</p>
        <a href={locale === "es" ? "/es/contact" : "/contact"} class="tria-sc-link">
          <span data-i18n="ctaService.button">{t("ctaService.button")}</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ── Engagement Models — light with texture ── -->
  <section id="engagement" class="tria-eng-section" data-section-theme="light">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="services.engagement.suptitle">{t("services.engagement.suptitle")}</span>
          <h2 class="tria-up tria-eng-title" data-i18n-html="services.engagement.title" set:html={t("services.engagement.title")} />
        </div>
        <div class="col-lg-5 offset-lg-1 tria-up">
          <p class="tria-eng-intro" data-i18n="services.engagement.intro">{t("services.engagement.intro")}</p>
        </div>
      </div>

      <div class="row tria-eng-grid">
        <!-- Project-Based -->
        <div class="col-lg-3 col-md-6 tria-up">
          <div class="tria-eng-card">
            <div class="tria-eng-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
            </div>
            <h3 class="tria-eng-card-title" data-i18n="services.engagement.projectBased">{t("services.engagement.projectBased")}</h3>
            <p class="tria-eng-card-desc" data-i18n="services.engagement.projectBasedDesc">{t("services.engagement.projectBasedDesc")}</p>
            <ul class="tria-eng-card-list">
              <li data-i18n="services.engagement.projectBased1">{t("services.engagement.projectBased1")}</li>
              <li data-i18n="services.engagement.projectBased2">{t("services.engagement.projectBased2")}</li>
              <li data-i18n="services.engagement.projectBased3">{t("services.engagement.projectBased3")}</li>
            </ul>
          </div>
        </div>

        <!-- Sprint-Based -->
        <div class="col-lg-3 col-md-6 tria-up">
          <div class="tria-eng-card">
            <div class="tria-eng-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="tria-eng-card-title" data-i18n="services.engagement.sprintBased">{t("services.engagement.sprintBased")}</h3>
            <p class="tria-eng-card-desc" data-i18n="services.engagement.sprintBasedDesc">{t("services.engagement.sprintBasedDesc")}</p>
            <ul class="tria-eng-card-list">
              <li data-i18n="services.engagement.sprintBased1">{t("services.engagement.sprintBased1")}</li>
              <li data-i18n="services.engagement.sprintBased2">{t("services.engagement.sprintBased2")}</li>
              <li data-i18n="services.engagement.sprintBased3">{t("services.engagement.sprintBased3")}</li>
            </ul>
          </div>
        </div>

        <!-- Dedicated Team -->
        <div class="col-lg-3 col-md-6 tria-up">
          <div class="tria-eng-card">
            <div class="tria-eng-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="tria-eng-card-title" data-i18n="services.engagement.dedicatedTeam">{t("services.engagement.dedicatedTeam")}</h3>
            <p class="tria-eng-card-desc" data-i18n="services.engagement.dedicatedTeamDesc">{t("services.engagement.dedicatedTeamDesc")}</p>
            <ul class="tria-eng-card-list">
              <li data-i18n="services.engagement.dedicatedTeam1">{t("services.engagement.dedicatedTeam1")}</li>
              <li data-i18n="services.engagement.dedicatedTeam2">{t("services.engagement.dedicatedTeam2")}</li>
              <li data-i18n="services.engagement.dedicatedTeam3">{t("services.engagement.dedicatedTeam3")}</li>
            </ul>
          </div>
        </div>

        <!-- Advisory -->
        <div class="col-lg-3 col-md-6 tria-up">
          <div class="tria-eng-card">
            <div class="tria-eng-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
            </div>
            <h3 class="tria-eng-card-title" data-i18n="services.engagement.advisory">{t("services.engagement.advisory")}</h3>
            <p class="tria-eng-card-desc" data-i18n="services.engagement.advisoryDesc">{t("services.engagement.advisoryDesc")}</p>
            <ul class="tria-eng-card-list">
              <li data-i18n="services.engagement.advisory1">{t("services.engagement.advisory1")}</li>
              <li data-i18n="services.engagement.advisory2">{t("services.engagement.advisory2")}</li>
              <li data-i18n="services.engagement.advisory3">{t("services.engagement.advisory3")}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA 
    heading={t("ctaServices.heading") || ""}
    primaryButtonText={t("ctaServices.button2") || ""}
    secondaryButtonText={t("pricing.estimatorCta") || ""}
    primaryButtonHref={locale === "es" ? "/es/contact" : "/contact"}
    secondaryButtonHref={locale === "es" ? "/es/quote" : "/quote"}
    theme="dark"
    showIcon={true}
    padding=""
    primaryButtonVariant="primary"
    primaryButtonColor="#0b0d17"
    primaryButtonHoverColor="#1a1f35"
  />
  <SiteFooter />
</Layout>

<style>
  /* ═══════════════════════════════════════
     SERVICES & CAPABILITIES — Light
     ═══════════════════════════════════════ */
  .tria-sc-section {
    background: #fff;
    position: relative;
    overflow: hidden;
  }

  .tria-sc-section .tria-suptitle::before {
    background-color: rgba(0,0,0,0.1);
  }

  .tria-sc-header {
    position: relative;
    z-index: 1;
    margin-bottom: 20px;
  }

  .tria-sc-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 450;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #0b0d17;
    margin-top: 20px;
  }

  .tria-sc-heading .tria-thin {
    color: rgba(0,0,0,0.18);
    font-weight: 200;
  }

  .tria-sc-sub {
    font-size: 0.95rem;
    color: rgba(0,0,0,0.4);
    max-width: 480px;
    margin: 16px 0 0;
    line-height: 1.7;
  }

  /* ── Detailed service accordion table ── */
  .tria-tbl {
    margin-top: 64px;
    position: relative;
    z-index: 1;
  }

  .tria-tbl-item {
    border-radius: 20px;
    scroll-margin-top: 120px;
    transition: background 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-tbl-item + .tria-tbl-item {
    margin-top: 4px;
  }

  .tria-tbl-item.is-open {
    background: rgba(6, 142, 140, 0.04);
  }

  .tria-tbl-row {
    display: grid;
    grid-template-areas: "num main arrow";
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 40px;
    align-items: center;
    padding: 40px 32px;
  }

  /* ── Number ── */
  .tria-tbl-num {
    grid-area: num;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: rgba(0,0,0,0.18);
    transition: color 0.35s ease;
  }

  .tria-tbl-item.is-open .tria-tbl-num { color: var(--accent); }

  /* ── Main content ── */
  .tria-tbl-main {
    grid-area: main;
    min-width: 0;
  }

  .tria-tbl-title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    color: #0b0d17;
    margin-bottom: 10px;
    line-height: 1.25;
    transition: color 0.35s ease;
  }

  .tria-tbl-item.is-open .tria-tbl-title { color: var(--accent); }

  .tria-tbl-desc {
    font-size: 0.85rem;
    color: rgba(0,0,0,0.45);
    line-height: 1.75;
    margin: 0;
    max-width: 560px;
  }

  /* ── View more / View less toggle ── */
  .tria-tbl-toggle {
    grid-area: arrow;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.5);
    white-space: nowrap;
    cursor: pointer;
    justify-self: end;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-tbl-toggle:hover {
    color: var(--accent);
  }

  .tria-tbl-toggle:focus-visible {
