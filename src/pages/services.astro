<script>
  // Controlled accordion: only the "View More / View Less" button toggles each item,
  // and only one item can be open at a time.
  // Event delegation on the container so it survives swup navigation.
  function initAccordion() {
    const container = document.querySelector(".tria-tbl");
    if (!container) return;
    // Guard against duplicate initialization (swup may re-fire contentReplaced)
    if (container.dataset.accordionInit === "1") return;
    container.dataset.accordionInit = "1";

    function setOpen(item, open) {
      if (open) {
        // Close any other open item — one open at a time (query live DOM)
        container.querySelectorAll(".tria-tbl-item.is-open").forEach((other) => {
          if (other === item) return;
          other.classList.remove("is-open");
          const otherToggle = other.querySelector("[data-accordion-toggle]");
          if (otherToggle) otherToggle.setAttribute("aria-expanded", "false");
        });
        item.classList.add("is-open");
        const toggle = item.querySelector("[data-accordion-toggle]");
        if (toggle) toggle.setAttribute("aria-expanded", "true");
      } else {
        item.classList.remove("is-open");
        const toggle = item.querySelector("[data-accordion-toggle]");
        if (toggle) toggle.setAttribute("aria-expanded", "false");
      }
    }

    container.addEventListener("click", (e) => {
      const toggle = e.target.closest("[data-accordion-toggle]");
      if (!toggle) return;
      const item = toggle.closest(".tria-tbl-item");
      if (!item) return;
      setOpen(item, !item.classList.contains("is-open"));
    });
  }

  // Open the accordion item targeted by the URL hash (e.g. /services#software-dev)
  function openFromHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target || !target.classList.contains("tria-tbl-item") || target.classList.contains("is-open")) return;
    const toggle = target.querySelector("[data-accordion-toggle]");
    if (toggle) toggle.click();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => { initAccordion(); openFromHash(); });
  } else {
    initAccordion();
    openFromHash();
  }
  // Also open on in-page anchor clicks (footer/header links while already on /services)
  window.addEventListener("hashchange", openFromHash);
  document.addEventListener("swup:contentReplaced", () => { initAccordion(); openFromHash(); });
</script>
