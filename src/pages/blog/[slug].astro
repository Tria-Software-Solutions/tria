---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { createT } from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const t = createT(Astro.currentLocale);
const { post } = Astro.props;
---

<Layout title={`${post.data.title} — tria`} description={post.data.description} pubDate={post.data.pubDate.toISOString()}>
  <section class="page-hero page-hero--secondary" data-section-theme="dark">
    <div class="page-hero-bg">
      <div class="page-hero-bg-dots"></div>
      <div class="page-hero-orb page-hero-orb--1"></div>
      <div class="page-hero-orb page-hero-orb--2"></div>
      <div class="page-hero-gradient-overlay"></div>
      <div class="tria-hero-grain"></div>
      <div class="tria-ambient-temp">
        <div class="tria-at-glow-1"></div>
        <div class="tria-at-glow-2"></div>
      </div>
    </div>
    <div class="container page-hero-inner">
      <div class="row">
        <div class="col-lg-7">
          <a href="/blog" class="tria-back-link tria-light-soft tria-up">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M11 4L7 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to Blog
          </a>
          <div class="tria-article-meta tria-up" style="margin-bottom:24px;">
            <span class="tria-label tria-upper tria-accent">{post.data.category.toUpperCase()}</span>
            <span class="tria-label tria-upper" style="color:rgba(255,255,255,0.25);margin-left:12px;">{new Date(post.data.pubDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>
          </div>
          <h1 class="page-hero-heading tria-up">{post.data.title}</h1>
        </div>
        <div class="col-lg-4 offset-lg-1 tria-up">
          <p class="page-hero-sub">{post.data.description}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tria-section-blog-content tria-soft-bg" data-section-theme="light">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <article class="tria-article" set:html={post.rendered.html}></article>

          <div class="tria-article-footer tria-up">
            <div class="tria-article-tags">
              {
                post.data.tags.map((tag) => (
                  <span class="tria-label tria-upper">{tag}</span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</Layout>
