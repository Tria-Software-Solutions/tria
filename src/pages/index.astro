---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import Partners from "../components/Partners.astro";
import CTA from "../components/CTA.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";

import SiteFooter from "../components/SiteFooter.astro";
import { createT, localePath } from "../i18n/utils";
const t = createT(Astro.currentLocale || 'en');
const locale = Astro.currentLocale || "en";
---

<Layout
  title={t("meta.homeTitle")}
  description={t("meta.homeDesc")}
  structuredData={{
    "@type": "WebPage",
    name: t("meta.homeTitle"),
    description: t("meta.homeDesc"),
    url: "https://triacr.com",
    about: {
      "@type": "Organization",
      name: "Tria Software Solutions",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://triacr.com/?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  }}>
  <Hero 
    title={t("hero.title") || ""}
    description={t("hero.description") || ""}
    buttonText={t("nav.startProject") || "Start a Project"}
    buttonHref="/contact"
  />
  <Stats 
    stats={[
      { value: 50, suffix: '+', label: t("stats.projectsLabel") || "" },
      { value: 20, suffix: '+', label: t("stats.clientsLabel") || "" },
      { value: 7, suffix: '+', label: t("stats.yearsLabel") || "" },
      { value: 99, suffix: '%', label: t("stats.satisfactionLabel") || "" }
    ]}
  />
  <Services 
    suptitle={t("services.suptitle") || ""}
    heading={t("services.modernSolutions") || ""}
    viewAllText={t("services.viewAll") || ""}
    viewAllHref="/services"
    services={[
      { 
        title: t("services.softwareDev") || "", 
        description: t("services.softwareDevDesc") || "", 
        href: localePath(locale, "/services#software-dev"),
        icon: "ti-code"
      },
      { 
        title: t("services.uiuxDesign") || "", 
        description: t("services.uiuxDesignDesc") || "", 
        href: localePath(locale, "/services#uiux-design"),
        icon: "ti-palette"
      },
      { 
        title: t("services.cloudDevops") || "", 
        description: t("services.cloudDevopsDesc") || "", 
        href: localePath(locale, "/services#cloud-devops"),
        icon: "ti-cloud"
      },
      { 
        title: t("services.qaTesting") || "", 
        description: t("services.qaTestingDesc") || "", 
        href: localePath(locale, "/services#qa-testing"),
        icon: "ti-bug"
      },
      { 
        title: t("services.aiMl") || "", 
        description: t("services.aiMlDesc") || "", 
        href: localePath(locale, "/services#ai-ml"),
        icon: "ti-robot"
      },
      { 
        title: t("services.dedicatedTeams") || "", 
        description: t("services.dedicatedTeamsDesc") || "", 
        href: localePath(locale, "/services#dedicated-teams"),
        icon: "ti-users"
      },
      { 
        title: t("services.itCybersecurity") || "", 
        description: t("services.itCybersecurityDesc") || "", 
        href: localePath(locale, "/services#cybersecurity"),
        icon: "ti-shield"
      },
      { 
        title: t("services.modernization") || "", 
        description: t("services.modernizationDesc") || "", 
        href: localePath(locale, "/services#modernization"),
        icon: "ti-puzzle"
      }
    ]}
  />
  <FeaturedWork 
    suptitle={t("featured.suptitle") || ""}
    heading={t("featured.title") || ""}
    ctaText={t("featured.viewProject") || "View project"}
    wikiText={t("featured.viewWiki") || "View wiki"}
    prevText={t("featured.prev") || "Prev"}
    nextText={t("featured.next") || "Next"}
    projects={[
      {
        category: t("featured.project1Cat") || "",
        title: t("featured.project1Title") || "",
        description: t("featured.project1Desc") || "",
        liveUrl: "https://parkit-valet.vercel.app",
        wikiUrl: "https://deepwiki.com/Tria-Building-Digital-Solutions/parkit",
        gradient: "linear-gradient(135deg, #0b0d17 0%, #1a1f35 50%, #068e8c 100%)",
        tags: ["React", "Go", "React Native", "PostgreSQL", "AWS"],
        stat: "Multi-tenant",
        statLabel: "Architecture",
        previewImg: "/assets/img/featured/parkit.avif"
      },
      {
        category: t("featured.project2Cat") || "",
        title: t("featured.project2Title") || "",
        description: t("featured.project2Desc") || "",
        liveUrl: "https://choferesdealquiler.vercel.app",
        wikiUrl: "https://deepwiki.com/Tria-Building-Digital-Solutions/choferes",
        gradient: "linear-gradient(135deg, #1a1f35 0%, #2d3561 100%)",
        tags: ["Python", "OCR", "Kubernetes", "React", "Node.js", "PostgreSQL"],
        stat: "OCR Pipeline",
        statLabel: "Automation",
        previewImg: "/assets/img/featured/choferes.avif"
      },
      {
        category: t("featured.project6Cat") || "",
        title: t("featured.project6Title") || "",
        description: t("featured.project6Desc") || "",
        liveUrl: "https://goalr-tria.vercel.app",
        wikiUrl: "https://deepwiki.com/Tria-Building-Digital-Solutions/goalr",
        gradient: "linear-gradient(135deg, #0f0c29 0%, #1a1a3e 40%, #068e8c 100%)",
        tags: ["NestJS", "Next.js", "TypeScript", "PostgreSQL", "Prisma"],
        stat: "Monorepo",
        statLabel: "Architecture",
        previewImg: "/assets/img/featured/goalr.avif"
      },
      {
        category: t("featured.project7Cat") || "",
        title: t("featured.project7Title") || "",
        description: t("featured.project7Desc") || "",
        liveUrl: "https://las-granas.vercel.app",
        wikiUrl: "https://deepwiki.com/Tria-Building-Digital-Solutions/lasgranas",
        gradient: "linear-gradient(135deg, #1a0a2e 0%, #2d1b4e 50%, #068e8c 100%)",
        tags: ["Astro", "Next.js", "TypeScript", "Tailwind", "shadcn/ui"],
        stat: "B2B Trade",
        statLabel: "Platform",
        previewImg: "/assets/img/featured/lasgranas.avif"
      },
      {
        category: t("featured.project5Cat") || "",
        title: t("featured.project5Title") || "",
        description: t("featured.project5Desc") || "",
        liveUrl: "https://proquinal-diagnostico-fallas.vercel.app",
        wikiUrl: "https://deepwiki.com/Tria-Building-Digital-Solutions/fault-diagnosis",
        gradient: "linear-gradient(135deg, #1a0a2e 0%, #2d1b4e 50%, #068e8c 100%)",
        tags: ["TypeScript", "Vite", "Tailwind", "jsPDF"],
        stat: "Root Cause",
        statLabel: "Analysis",
        previewImg: "/assets/img/featured/fault-diagnosis.avif"
      },
    ]}
  />
  <Process 
    suptitle={t("process.suptitle") || ""}
    heading={t("process.title") || ""}
    intro={t("process.intro") || ""}
    steps={[
      {
        number: "01",
        title: t("process.step1Title") || "",
        description: t("process.step1Desc") || "",
        tags: [
          t("process.step1Tag1") || "",
          t("process.step1Tag2") || "",
          t("process.step1Tag3") || ""
        ]
      },
      {
        number: "02",
        title: t("process.step2Title") || "",
        description: t("process.step2Desc") || "",
        tags: [
          t("process.step2Tag1") || "",
          t("process.step2Tag2") || "",
          t("process.step2Tag3") || ""
        ]
      },
      {
        number: "03",
        title: t("process.step3Title") || "",
        description: t("process.step3Desc") || "",
        tags: [
          t("process.step3Tag1") || "",
          t("process.step3Tag2") || "",
          t("process.step3Tag3") || ""
        ]
      },
      {
        number: "04",
        title: t("process.step4Title") || "",
        description: t("process.step4Desc") || "",
        tags: [
          t("process.step4Tag1") || "",
          t("process.step4Tag2") || "",
          t("process.step4Tag3") || ""
        ]
      },
      {
        number: "05",
        title: t("process.step5Title") || "",
        description: t("process.step5Desc") || "",
        tags: [
          t("process.step5Tag1") || "",
          t("process.step5Tag2") || "",
          t("process.step5Tag3") || ""
        ]
      },
      {
        number: "06",
        title: t("process.step6Title") || "",
        description: t("process.step6Desc") || "",
        tags: [
          t("process.step6Tag1") || "",
          t("process.step6Tag2") || "",
          t("process.step6Tag3") || ""
        ]
      }
    ]}
  />
  <Pricing 
    suptitle={t("pricing.suptitle") || ""}
    heading={t("pricing.heading") || ""}
    description={t("pricing.description") || ""}
    suptitleKey="pricing.suptitle"
    headingKey="pricing.heading"
    descriptionKey="pricing.description"
    theme="light"
    padding="tria-p-120-60"
    plans={[
      {
        name: t("pricing.plan1Name") || "Starter",
        price: t("pricing.plan1Price") || "$700",
        amount: t("pricing.plan1Amount") || "$700",
        prefix: t("pricing.fromLabel") || "From",
        suffix: t("pricing.projectSuffix") || "/ project",
        description: t("pricing.plan1Desc") || "",
        featureCategories: ['website', 'seoPerf', 'ecom', 'support'],
        buttonHref: "/contact"
      },
      {
        name: t("pricing.plan2Name") || "Professional",
        price: t("pricing.plan2Price") || "$5,000",
        amount: t("pricing.plan2Amount") || "$5,000",
        prefix: t("pricing.fromLabel") || "From",
        suffix: t("pricing.projectSuffix") || "/ project",
        description: t("pricing.plan2Desc") || "",
        highlighted: true,
        featureCategories: ['website', 'seoPerf', 'ecom', 'webApp', 'mobile', 'backend', 'desktop', 'support'],
        buttonHref: "/contact"
      },
      {
        name: t("pricing.plan3Name") || "Enterprise",
        price: t("pricing.plan3Price") || "$3,000",
        amount: t("pricing.plan3Amount") || "$3,000",
        prefix: t("pricing.fromLabel") || "From",
        suffix: t("pricing.projectSuffix") || "/ project",
        description: t("pricing.plan3Desc") || "",
        featureCategories: ['website', 'seoPerf', 'ecom', 'webApp', 'mobile', 'desktop', 'backend', 'aiAuto', 'devops', 'security', 'support'],
        buttonHref: "/contact"
      },
      {
        name: t("pricing.plan4Name") || "Custom",
        price: t("pricing.plan4Price") || "Contact Us",
        period: t("pricing.plan4Period") || "",
        description: t("pricing.plan4Desc") || "",
        featureCategories: [],
        buttonText: t("pricing.plan4Button") || "Contact Us",
        buttonHref: "/contact"
      }
    ]}
  />
  <Faq
    suptitle={t("faq.suptitle") || ""}
    heading={t("faq.title") || "Frequently Asked <span class=\"tria-thin\">Questions</span>"}
    items={[
      {
        question: t("faq.q1") || "",
        answer: t("faq.a1") || ""
      },
      {
        question: t("faq.q2") || "",
        answer: t("faq.a2") || ""
      },
      {
        question: t("faq.q3") || "",
        answer: t("faq.a3") || ""
      },
      {
        question: t("faq.q4") || "",
        answer: t("faq.a4") || ""
      },
      {
        question: t("faq.q5") || "",
        answer: t("faq.a5") || ""
      },
      {
        question: t("faq.q6") || "",
        answer: t("faq.a6") || ""
      },
      {
        question: t("faq.q7") || "",
        answer: t("faq.a7") || ""
      },
      {
        question: t("faq.q8") || "",
        answer: t("faq.a8") || ""
      },
      {
        question: t("faq.q9") || "",
        answer: t("faq.a9") || ""
      }
    ]}
  />
  <Partners 
    partners={[
      { logo: "/assets/img/partners/partner-01.png", href: "#.", alt: "Partner logo 1" },
      { logo: "/assets/img/partners/partner-02.png", href: "#.", alt: "Partner logo 2" },
      { logo: "/assets/img/partners/partner-03.png", href: "#.", alt: "Partner logo 3" },
      { logo: "/assets/img/partners/partner-04.png", href: "#.", alt: "Partner logo 4" },
      { logo: "/assets/img/partners/partner-05.png", href: "#.", alt: "Partner logo 5" },
      { logo: "/assets/img/partners/partner-06.png", href: "#.", alt: "Partner logo 6" },
      { logo: "/assets/img/partners/partner-07.png", href: "#.", alt: "Partner logo 7" },
      { logo: "/assets/img/partners/partner-08.png", href: "#.", alt: "Partner logo 8" },
      { logo: "/assets/img/partners/partner-09.png", href: "#.", alt: "Partner logo 9" },
    ]}
  />

  <CTA 
    heading={t("cta.heading") || ""}
    description={t("cta.description") || "From concept to deployment, we build software that scales."}
    primaryButtonText={t("cta.startProject") || ""}
    secondaryButtonText={t("cta.seeWork") || ""}
    primaryButtonHref="/contact"
    secondaryButtonHref="/quote"
    theme="dark"
    showIcon={true}
    padding=""
    primaryButtonVariant="primary"
    primaryButtonColor="#0b0d17"
    primaryButtonHoverColor="#1a1f35"
  />
  <SiteFooter />
</Layout>
