---
const locale = Astro.currentLocale;
const aboutPath = locale === "en" ? "/about#team" : `/es/about#team`;
---
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content={`0; url=${aboutPath}`}>
  <script>location.replace("{aboutPath}")</script>
</head>
<body style="margin:0;background:#0b0d17;"></body>
</html>
