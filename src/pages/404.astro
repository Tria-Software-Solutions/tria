---
import ErrorLayout from "../layouts/ErrorLayout.astro";
import ErrorPage from "../components/ErrorPage.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
---

<ErrorLayout title={t("meta.404Title")} description={t("meta.404Desc")}>
  <ErrorPage
    code="404"
    titleKey="error.404title"
    descriptionKey="error.404desc"
  />
</ErrorLayout>
