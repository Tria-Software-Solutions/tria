---
import Layout from "../layouts/Layout.astro";
import ErrorPage from "../components/ErrorPage.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
---

<Layout title={t("meta.403Title")} description={t("meta.403Desc")}>
  <ErrorPage
    code="403"
    titleKey="error.403title"
    descriptionKey="error.403desc"
    searchPlaceholderKey="error.searchPlaceholder"
  />
  <SiteFooter />
</Layout>
