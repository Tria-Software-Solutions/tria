---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import QuoteCalculator from "../components/QuoteCalculator.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
---

<Layout title={t("meta.quoteTitle")} description={t("meta.quoteDesc")}
  structuredData={{
    "@type": "WebPage",
    name: t("meta.quoteTitle"),
    description: t("meta.quoteDesc"),
    url: "https://triacr.com/quote",
    about: {
      "@type": "Organization",
      name: "Tria Software Solutions",
    },
  }}>

  <PageBanner headingKey="quote.pageTitle" descriptionKey="quote.pageDesc" crumbKey="nav.quote" />

  <QuoteCalculator />

  <SiteFooter />
</Layout>
