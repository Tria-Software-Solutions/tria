---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NumberedList from "../components/NumberedList.astro";
import { createT, localePath } from "../i18n/utils";
const t = createT(Astro.currentLocale);
const locale = Astro.currentLocale || "en";
---

<Layout title={t("meta.aboutTitle")} description={t("meta.aboutDesc")}
  structuredData={{
    "@type": "AboutPage",
    name: "About Tria Software Solutions",
    description: t("meta.aboutDesc"),
    mainContentOfPage: {
      "@type": "WebPageElement",
      about: {
        "@type": "Organization",
        name: "Tria Software Solutions",
        foundingDate: "2025",
        foundingLocation: "Atenas, Alajuela, Costa Rica",
      },
    },
  }}>
  <PageBanner headingKey="about.title" descriptionKey="about.heroDesc" crumbKey="nav.about" />

  <!-- ════════════════════════════════════
       STORY — Who we are
       ════════════════════════════════════ -->
  <section class="tria-ab-section" data-section-theme="light">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row justify-content-between align-items-center">
        <div class="col-lg-5">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.storySuptitle">{t("about.storySuptitle")}</span>
          <p class="tria-up tria-ab-text" data-i18n="about.description1">{t("about.description1")}</p>
          <p class="tria-up tria-ab-text" data-i18n="about.description2">{t("about.description2")}</p>

          <!-- Mission — merged into "Who We Are" -->
          <div class="tria-ab-story-mission tria-up">
            <span class="tria-suptitle tria-suptitle-dark" data-i18n="about.missionSuptitle">{t("about.missionSuptitle")}</span>
            <p class="tria-ab-story-mission-text" data-i18n="about.missionDesc">{t("about.missionDesc")}</p>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="tria-ab-visual tria-up">
            <img src="/assets/img/about/about.svg" alt={t("about.storyAlt")} class="tria-ab-illo" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       MISSION + VALUES — What Drives Us (dark)
       ════════════════════════════════════ -->
  <section id="values" class="tria-ab-mission-values" data-section-theme="dark">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-2"></div>
    </div>
    <div class="container tria-p-120-120">
      <!-- What Drives Us -->
      <div class="row tria-ab-values-head tria-up">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-light-soft tria-up" data-i18n="about.valuesSuptitle">{t("about.valuesSuptitle")}</span>
          <h3 class="tria-up tria-ab-values-title" data-i18n-html="about.valuesTitle" set:html={t("about.valuesTitle")} />
        </div>
        <div class="col-lg-5 offset-lg-1 tria-up">
          <p class="tria-ab-values-intro" data-i18n="about.valuesIntro">{t("about.valuesIntro")}</p>
        </div>
      </div>

      <NumberedList items={[
        { number: "01", titleKey: "about.value1Title", title: t("about.value1Title"), descKey: "about.value1Desc", description: t("about.value1Desc") },
        { number: "02", titleKey: "about.value2Title", title: t("about.value2Title"), descKey: "about.value2Desc", description: t("about.value2Desc") },
        { number: "03", titleKey: "about.value3Title", title: t("about.value3Title"), descKey: "about.value3Desc", description: t("about.value3Desc") },
        { number: "04", titleKey: "about.value4Title", title: t("about.value4Title"), descKey: "about.value4Desc", description: t("about.value4Desc") },
        { number: "05", titleKey: "about.value5Title", title: t("about.value5Title"), descKey: "about.value5Desc", description: t("about.value5Desc") },
      ]} />
    </div>
  </section>

  <!-- ════════════════════════════════════
       CULTURE + DIFFERENTIATORS — How We Work & Why Tria
       ════════════════════════════════════ -->
  <section id="culture" class="tria-ab-culture-diff" data-section-theme="light">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <!-- How We Work -->
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="team.cultureSuptitle">{t("team.cultureSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="team.cultureTitle" set:html={t("team.cultureTitle")} />
        </div>
      </div>
      <div class="row tria-ab-culture-grid">
        <div class="col-md-6 col-lg-3 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture1Title">{t("team.culture1Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture1Desc">{t("team.culture1Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture2Title">{t("team.culture2Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture2Desc">{t("team.culture2Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture3Title">{t("team.culture3Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture3Desc">{t("team.culture3Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M7 8l5-5 5 5"/><path d="M7 16l5 5 5-5"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture4Title">{t("team.culture4Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture4Desc">{t("team.culture4Desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       TEAM
       ════════════════════════════════════ -->
  <section id="team" class="tria-ab-team-section" data-section-theme="light">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row justify-content-center tria-mb-80">
        <div class="col-lg-7 text-center">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.teamSuptitle">{t("about.teamSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="about.teamTitle" set:html={t("about.teamTitle")} style="text-align:center;" />
          <p class="tria-up tria-ab-team-desc" data-i18n="about.teamDesc">{t("about.teamDesc")}</p>
        </div>
      </div>
      <!-- Member cards — exact copy of Team.astro pattern with glass overlay -->
      <div class="row justify-content-center tria-ab-members-row">
        <div class="col-md-6 col-lg-5 tria-up tria-mb-30">
          <div class="tria-team-card">
            <picture>
              <source srcset="/assets/img/team/luis-herrera.avif" type="image/avif" />
              <source srcset="/assets/img/team/luis-herrera.webp" type="image/webp" />
              <img src="/assets/img/team/luis-herrera.jpeg" alt="Luis M. Herrera Q." loading="lazy" />
            </picture>
            <div class="tria-description">
              <div class="tria-secrc-text">
                <h5 class="tria-dark tria-mb-5" data-i18n="team.member1Name">{t("team.member1Name")}</h5>
                <p class="tria-link tria-dark-soft tria-mb-10" data-i18n="team.role1">{t("team.role1")}</p>
                <ul class="tria-social-icons tria-dark tria-center">
                  <li>
                    <a href="https://www.facebook.com/luisherreracr" target="_blank" aria-label="Facebook">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  </li>
                  <li>
                    <a href="https://www.instagram.com/luismigue_l" target="_blank" aria-label="Instagram">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-5 tria-up tria-mb-30">
          <div class="tria-team-card">
            <picture>
              <source srcset="/assets/img/team/daniela-miranda.avif" type="image/avif" />
              <source srcset="/assets/img/team/daniela-miranda.webp" type="image/webp" />
              <img src="/assets/img/team/daniela-miranda.jpeg" alt="Daniela Miranda M." loading="lazy" />
            </picture>
            <div class="tria-description">
              <div class="tria-secrc-text">
                <h5 class="tria-dark tria-mb-5" data-i18n="team.member2Name">{t("team.member2Name")}</h5>
                <p class="tria-link tria-dark-soft tria-mb-10" data-i18n="team.role2">{t("team.role2")}</p>
                <ul class="tria-social-icons tria-dark tria-center">
                  <li>
                    <a href="https://facebook.com/danilumix" target="_blank" aria-label="Facebook">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  </li>
                  <li>
                    <a href="https://www.instagram.com/danilumix" target="_blank" aria-label="Instagram">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       TESTIMONIALS
       ════════════════════════════════════ -->
  <Testimonials />

  <!-- ════════════════════════════════════
       CTA
       ════════════════════════════════════ -->
  <CTA
    heading={t("ctaAbout.heading") || ""}
    description={t("ctaAbout.desc") || ""}
    primaryButtonText={t("ctaAbout.button") || ""}
    secondaryButtonText={t("ctaAbout.button2") || ""}
    primaryButtonHref={localePath(locale, "/contact")}
    secondaryButtonHref={localePath(locale, "/services")}
    theme="dark"
    showIcon={true}
    padding=""
    primaryButtonVariant="primary"
    primaryButtonColor="#0b0d17"
    primaryButtonHoverColor="#1a1f35"
  />
  <SiteFooter />
</Layout>

<style>
  /* ═══════════════════════════════════════
     STORY — White frameless
     ═══════════════════════════════════════ */
  .tria-ab-section {
    position: relative;
    overflow: hidden;
    background: #fff;
  }

  .tria-ab-text {
    color: rgba(0, 0, 0, 0.6);
    font-size: 1rem;
    line-height: 1.85;
    margin: 18px 0 24px;
    max-width: 520px;
  }
  .tria-ab-text:last-of-type {
    margin-bottom: 0;
  }

  .tria-ab-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── New About illustration (about.svg) ── */
  .tria-ab-illo {
    display: block;
    width: 100%;
    max-width: 620px;
    filter: drop-shadow(0 24px 48px rgba(11, 13, 23, 0.18));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tria-ab-visual:hover .tria-ab-illo {
    transform: translateY(-6px);
  }

  /* ── Mission — merged into "Who We Are" ── */
  .tria-ab-story-mission {
    position: relative;
    margin-top: 8px;
  }
  .tria-ab-story-mission-text {
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.8;
    margin: 0;
    max-width: 480px;
  }

  /* ═══════════════════════════════════════
     MISSION + VALUES — dark featured
     ═══════════════════════════════════════ */
  .tria-ab-mission-values {
    position: relative;
    overflow: hidden;
    background: #0b0d17;
  }
  .tria-ab-mission-values::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(6, 142, 140, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse at 70% 80%, rgba(6, 142, 140, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }
  .tria-ab-mission-values .container {
    position: relative;
    z-index: 1;
  }
  .tria-ab-mission-values .tria-suptitle::before {
    background: var(--accent);
  }

  /* ── Values block on dark ── */
  .tria-ab-values-head {
    margin-top: 0;
    padding-top: 0;
  }

  .tria-ab-values-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 450;
    letter-spacing: -0.025em;
    color: #fff;
    margin-top: 20px;
    line-height: 1.15;
  }
  .tria-ab-values-title .tria-thin {
    color: rgba(255, 255, 255, 0.3);
    font-weight: 200;
  }

  .tria-ab-values-intro {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.75;
    margin-top: 52px;
  }

  /* ── Culture cards (inside fused section) ── */
  .tria-ab-culture-grid {
    position: relative;
    z-index: 1;
  }

  .tria-ab-culture-card-title {
    font-size: 1.05rem;
    font-weight: 450;
    color: #0b0d17;
    margin-bottom: 12px;
  }
  .tria-ab-culture-card:hover .tria-ab-culture-card-title {
    color: var(--accent);
  }

  .tria-ab-culture-card {
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 20px;
    padding: 40px 32px;
    height: 100%;
    background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
    text-align: center;
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tria-ab-culture-card:hover {
    border-color: rgba(6,142,140,0.15);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.04);
  }

  .tria-ab-culture-card-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    background: rgba(6,142,140,0.08);
    color: var(--accent);
    transition: background 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tria-ab-culture-card:hover .tria-ab-culture-card-icon {
    background: var(--accent);
    color: #fff;
    transform: translateY(-4px) scale(1.05);
  }

  .tria-ab-culture-card-desc {
    font-size: 0.82rem;
    color: #777;
    line-height: 1.75;
    margin: 0;
    transition: color 0.3s ease;
  }
  .tria-ab-culture-card:hover .tria-ab-culture-card-desc {
    color: #555;
  }

  /* ═══════════════════════════════════════
     CULTURE — White bg (distinct from the gray Team section below)
     ═══════════════════════════════════════ */
  .tria-ab-culture-diff {
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }

  /* Cards get a subtle gray tint so they stand out on the white section */
  .tria-ab-culture-diff .tria-ab-culture-card {
    background: linear-gradient(180deg, #f8fafb 0%, #f1f4f6 100%);
  }

  /* ═══════════════════════════════════════
     TEAM — Gray bg
     ═══════════════════════════════════════ */
  .tria-ab-team-section {
    background: #f5f7f9;
    position: relative;
    overflow: hidden;
  }

  .tria-ab-team-desc {
    font-size: 0.95rem;
    color: rgba(0, 0, 0, 0.5);
    line-height: 1.75;
    max-width: 520px;
    margin: 16px auto 0;
  }

  /* ── Member cards — exact copy of Team.astro pattern ── */
  .tria-ab-members-row {
    margin-top: 80px;
    position: relative;
    z-index: 2;
  }

  .tria-team-card {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
