---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Stats from "../components/Stats.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
---

<Layout title={t("meta.aboutTitle")} description={t("meta.aboutDesc")}
  structuredData={{
    "@type": "AboutPage",
    name: "About Tria Software Solutions",
    description: t("meta.aboutDesc"),
    mainContentOfPage: {
      "@type": "WebPageElement",
      about: {
        "@type": "Organization",
        name: "Tria Software Solutions",
        foundingDate: "2018",
        foundingLocation: "Atenas, Alajuela, Costa Rica",
      },
    },
  }}>
  <PageBanner suptitleKey="about.suptitleAlt" headingKey="about.title" descriptionKey="about.heroDesc" />

  <!-- ════════════════════════════════════
       STATS
       ════════════════════════════════════ -->
  <Stats 
    stats={[
      { value: 50, suffix: '+', label: t("stats.projectsLabel") || "" },
      { value: 20, suffix: '+', label: t("stats.clientsLabel") || "" },
      { value: 7, suffix: '+', label: t("stats.yearsLabel") || "" },
      { value: 99, suffix: '%', label: t("stats.satisfactionLabel") || "" }
    ]}
  />

  <!-- ════════════════════════════════════
       ABOUT CONTENT + MISSION
       ════════════════════════════════════ -->
  <section class="tria-ab-section" data-section-theme="light">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row justify-content-between align-items-center">
        <div class="col-lg-5">
          <p class="tria-up tria-ab-text" data-i18n="about.description1">{t("about.description1")}</p>
          <p class="tria-up tria-ab-text" data-i18n="about.description2">{t("about.description2")}</p>
          <div class="tria-ab-tagline tria-up">
            <div class="tria-ab-badge">
              <img src="/assets/img/logo/logo-avatar.svg" alt="tria" class="tria-ab-badge-icon" />
              <span data-i18n-html="about.tagline" set:html={t("about.tagline")} />
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="tria-ab-visual tria-up">
            <img src="/assets/img/about/about.svg" alt="Software engineering illustration" class="tria-ab-image" />
          </div>
        </div>
      </div>

      <!-- Mission -->
      <div class="row justify-content-center tria-mt-120">
        <div class="col-lg-8 text-center">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.missionSuptitle">{t("about.missionSuptitle")}</span>
          <h2 class="tria-up tria-ab-mission-title" data-i18n-html="about.missionTitle" set:html={t("about.missionTitle")} />
          <p class="tria-up tria-ab-mission-text" data-i18n="about.missionDesc">{t("about.missionDesc")}</p>
          <div class="tria-ab-mission-accent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       VALUES — Gray bg with cards
       ════════════════════════════════════ -->
  <section id="values" class="tria-ab-values" data-section-theme="light">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.valuesSuptitle">{t("about.valuesSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="about.valuesTitle" set:html={t("about.valuesTitle")} />
        </div>
        <div class="col-lg-5 offset-lg-1 tria-up">
          <p class="tria-ab-values-intro" data-i18n="about.valuesIntro">{t("about.valuesIntro")}</p>
        </div>
      </div>

      <div class="row tria-ab-values-grid">
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-value-card">
            <div class="tria-ab-value-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 class="tria-ab-value-card-title" data-i18n="about.value1Title">{t("about.value1Title")}</h3>
            <p class="tria-ab-value-card-desc" data-i18n="about.value1Desc">{t("about.value1Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-value-card">
            <div class="tria-ab-value-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h3 class="tria-ab-value-card-title" data-i18n="about.value2Title">{t("about.value2Title")}</h3>
            <p class="tria-ab-value-card-desc" data-i18n="about.value2Desc">{t("about.value2Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-value-card">
            <div class="tria-ab-value-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l-3 3 3 3"/><path d="M9 5l3-3 3 3"/><path d="M15 19l-3 3-3-3"/><path d="M19 9l3 3-3 3"/><path d="M2 12h20"/><path d="M12 2v20"/></svg>
            </div>
            <h3 class="tria-ab-value-card-title" data-i18n="about.value3Title">{t("about.value3Title")}</h3>
            <p class="tria-ab-value-card-desc" data-i18n="about.value3Desc">{t("about.value3Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-value-card">
            <div class="tria-ab-value-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h3 class="tria-ab-value-card-title" data-i18n="about.value4Title">{t("about.value4Title")}</h3>
            <p class="tria-ab-value-card-desc" data-i18n="about.value4Desc">{t("about.value4Desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       HISTORY TIMELINE
       ════════════════════════════════════ -->
  <section id="history" class="tria-ab-history" data-section-theme="light">
    <div class="container tria-p-120-120">
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.historySuptitle">{t("about.historySuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="about.historyTitle" set:html={t("about.historyTitle")} />
        </div>
      </div>

      <div class="tria-timeline">
        <div class="tria-timeline-line"></div>
        
        <div class="tria-timeline-item tria-up">
          <div class="tria-timeline-dot"></div>
          <div class="tria-timeline-content">
            <span class="tria-timeline-year" data-i18n="about.history1Year">{t("about.history1Year")}</span>
            <h3 class="tria-timeline-title" data-i18n="about.history1Title">{t("about.history1Title")}</h3>
            <p class="tria-timeline-desc" data-i18n="about.history1Desc">{t("about.history1Desc")}</p>
          </div>
        </div>

        <div class="tria-timeline-item tria-up">
          <div class="tria-timeline-dot"></div>
          <div class="tria-timeline-content">
            <span class="tria-timeline-year" data-i18n="about.history2Year">{t("about.history2Year")}</span>
            <h3 class="tria-timeline-title" data-i18n="about.history2Title">{t("about.history2Title")}</h3>
            <p class="tria-timeline-desc" data-i18n="about.history2Desc">{t("about.history2Desc")}</p>
          </div>
        </div>

        <div class="tria-timeline-item tria-up">
          <div class="tria-timeline-dot"></div>
          <div class="tria-timeline-content">
            <span class="tria-timeline-year" data-i18n="about.history3Year">{t("about.history3Year")}</span>
            <h3 class="tria-timeline-title" data-i18n="about.history3Title">{t("about.history3Title")}</h3>
            <p class="tria-timeline-desc" data-i18n="about.history3Desc">{t("about.history3Desc")}</p>
          </div>
        </div>

        <div class="tria-timeline-item tria-up">
          <div class="tria-timeline-dot"></div>
          <div class="tria-timeline-content">
            <span class="tria-timeline-year" data-i18n="about.history4Year">{t("about.history4Year")}</span>
            <h3 class="tria-timeline-title" data-i18n="about.history4Title">{t("about.history4Title")}</h3>
            <p class="tria-timeline-desc" data-i18n="about.history4Desc">{t("about.history4Desc")}</p>
          </div>
        </div>

        <div class="tria-timeline-item tria-up">
          <div class="tria-timeline-dot"></div>
          <div class="tria-timeline-content">
            <span class="tria-timeline-year" data-i18n="about.history5Year">{t("about.history5Year")}</span>
            <h3 class="tria-timeline-title" data-i18n="about.history5Title">{t("about.history5Title")}</h3>
            <p class="tria-timeline-desc" data-i18n="about.history5Desc">{t("about.history5Desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       DIFFERENTIATORS — Gray bg with cards
       ════════════════════════════════════ -->
  <section id="differentiators" class="tria-ab-diff" data-section-theme="light">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.diffSuptitle">{t("about.diffSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="about.diffTitle" set:html={t("about.diffTitle")} />
        </div>
      </div>

      <div class="row tria-ab-diff-grid">
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-diff-card">
            <div class="tria-ab-diff-number">01</div>
            <h3 class="tria-ab-diff-title" data-i18n="about.diff1Title">{t("about.diff1Title")}</h3>
            <p class="tria-ab-diff-desc" data-i18n="about.diff1Desc">{t("about.diff1Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-diff-card">
            <div class="tria-ab-diff-number">02</div>
            <h3 class="tria-ab-diff-title" data-i18n="about.diff2Title">{t("about.diff2Title")}</h3>
            <p class="tria-ab-diff-desc" data-i18n="about.diff2Desc">{t("about.diff2Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-diff-card">
            <div class="tria-ab-diff-number">03</div>
            <h3 class="tria-ab-diff-title" data-i18n="about.diff3Title">{t("about.diff3Title")}</h3>
            <p class="tria-ab-diff-desc" data-i18n="about.diff3Desc">{t("about.diff3Desc")}</p>
          </div>
        </div>
        <div class="col-md-6 tria-up tria-mb-30">
          <div class="tria-ab-diff-card">
            <div class="tria-ab-diff-number">04</div>
            <h3 class="tria-ab-diff-title" data-i18n="about.diff4Title">{t("about.diff4Title")}</h3>
            <p class="tria-ab-diff-desc" data-i18n="about.diff4Desc">{t("about.diff4Desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       CULTURE — Gray bg with cards
       ════════════════════════════════════ -->
  <section id="culture" class="tria-ab-culture" data-section-theme="light">
    <div class="tria-dot-pattern"></div>
    <div class="tria-grain-overlay"></div>
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row tria-mb-60">
        <div class="col-lg-6">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="team.cultureSuptitle">{t("team.cultureSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="team.cultureTitle" set:html={t("team.cultureTitle")} />
        </div>
      </div>
      <div class="row tria-ab-culture-grid">
        <div class="col-md-4 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture1Title">{t("team.culture1Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture1Desc">{t("team.culture1Desc")}</p>
          </div>
        </div>
        <div class="col-md-4 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture2Title">{t("team.culture2Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture2Desc">{t("team.culture2Desc")}</p>
          </div>
        </div>
        <div class="col-md-4 tria-up tria-mb-30">
          <div class="tria-ab-culture-card">
            <div class="tria-ab-culture-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="tria-ab-culture-card-title" data-i18n="team.culture3Title">{t("team.culture3Title")}</h3>
            <p class="tria-ab-culture-card-desc" data-i18n="team.culture3Desc">{t("team.culture3Desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════
       TEAM PHOTO + MEMBER CARDS
       ════════════════════════════════════ -->
  <section id="team" class="tria-ab-team-section" data-section-theme="light">
    <div class="container tria-p-120-120">
      <div class="row justify-content-center tria-mb-80">
        <div class="col-lg-7 text-center">
          <span class="tria-suptitle tria-suptitle-dark tria-up" data-i18n="about.teamSuptitle">{t("about.teamSuptitle")}</span>
          <h2 class="tria-up tria-ab-section-title" data-i18n-html="about.teamTitle" set:html={t("about.teamTitle")} style="text-align:center;" />
          <p class="tria-up tria-ab-team-desc" data-i18n="about.teamDesc">{t("about.teamDesc")}</p>
        </div>
      </div>
      <!-- Member cards — exact copy of Team.astro pattern with glass overlay -->
      <div class="row justify-content-center tria-ab-members-row">
        <div class="col-md-6 col-lg-5 tria-up tria-mb-30">
          <div class="tria-team-card">
            <picture>
              <source srcset="/assets/img/team/luis-herrera.avif" type="image/avif" />
              <source srcset="/assets/img/team/luis-herrera.webp" type="image/webp" />
              <img src="/assets/img/team/luis-herrera.jpeg" alt="Luis M. Herrera Q." loading="lazy" />
            </picture>
            <div class="tria-description">
              <div class="tria-secrc-text">
                <h5 class="tria-dark tria-mb-5" data-i18n="team.member1Name">{t("team.member1Name")}</h5>
                <p class="tria-link tria-dark-soft tria-mb-10" data-i18n="team.role1">{t("team.role1")}</p>
                <ul class="tria-social-icons tria-dark tria-center">
                  <li>
                    <a href="https://www.facebook.com/luisherreracr" target="_blank" aria-label="Facebook">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  </li>
                  <li>
                    <a href="https://www.instagram.com/luismigue_l" target="_blank" aria-label="Instagram">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-5 tria-up tria-mb-30">
          <div class="tria-team-card">
            <picture>
              <source srcset="/assets/img/team/daniela-miranda.avif" type="image/avif" />
              <source srcset="/assets/img/team/daniela-miranda.webp" type="image/webp" />
              <img src="/assets/img/team/daniela-miranda.jpeg" alt="Daniela Miranda M." loading="lazy" />
            </picture>
            <div class="tria-description">
              <div class="tria-secrc-text">
                <h5 class="tria-dark tria-mb-5" data-i18n="team.member2Name">{t("team.member2Name")}</h5>
                <p class="tria-link tria-dark-soft tria-mb-10" data-i18n="team.role2">{t("team.role2")}</p>
                <ul class="tria-social-icons tria-dark tria-center">
                  <li>
                    <a href="https://facebook.com/danilumix" target="_blank" aria-label="Facebook">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  </li>
                  <li>
                    <a href="https://www.instagram.com/danilumix" target="_blank" aria-label="Instagram">
