---
import Layout from "../layouts/Layout.astro";
import ErrorPage from "../components/ErrorPage.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
---

<Layout title={t("meta.500Title")} description={t("meta.500Desc")}>
  <ErrorPage
    code="500"
    titleKey="error.500title"
    descriptionKey="error.500desc"
    searchPlaceholderKey="error.searchPlaceholder"
  />
  <SiteFooter />
</Layout>
