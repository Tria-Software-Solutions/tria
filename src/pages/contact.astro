---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Button from "../components/Button.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { createT } from "../i18n/utils";
const t = createT(Astro.currentLocale);
const quotePath = Astro.currentLocale === 'es' ? '/es/quote' : '/quote';
const sendingText = t('contact.form.sending');
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const valRequired = t('contact.form.validation.required');
const valEmail = t('contact.form.validation.email');
const valBudget = t('contact.form.validation.budget');
const valServices = t('contact.form.validation.services');
const valMessage = t('contact.form.validation.message');
const submitText = t('contact.form.submit');

const serviceGroups = [
  {
    categoryKey: 'contact.form.svcCat.digital',
    services: [
      { value: 'website', key: 'contact.form.service.website' },
      { value: 'webapp', key: 'contact.form.service.webapp' },
      { value: 'mobile', key: 'contact.form.service.mobile' },
      { value: 'desktop', key: 'contact.form.service.desktop' },
      { value: 'ecommerce', key: 'contact.form.service.ecommerce' },
      { value: 'uiux', key: 'contact.form.service.uiux' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.backend',
    services: [
      { value: 'api', key: 'contact.form.service.api' },
      { value: 'microservices', key: 'contact.form.service.microservices' },
      { value: 'database', key: 'contact.form.service.database' },
      { value: 'legacy', key: 'contact.form.service.legacy' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.cloud',
    services: [
      { value: 'cloudMigration', key: 'contact.form.service.cloudMigration' },
      { value: 'kubernetes', key: 'contact.form.service.kubernetes' },
      { value: 'cicd', key: 'contact.form.service.cicd' },
      { value: 'iac', key: 'contact.form.service.iac' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.ai',
    services: [
      { value: 'chatbot', key: 'contact.form.service.chatbot' },
      { value: 'llm', key: 'contact.form.service.llm' },
      { value: 'automation', key: 'contact.form.service.automation' },
      { value: 'computerVision', key: 'contact.form.service.computerVision' },
      { value: 'dataPipeline', key: 'contact.form.service.dataPipeline' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.security',
    services: [
      { value: 'securityAudit', key: 'contact.form.service.securityAudit' },
      { value: 'pentest', key: 'contact.form.service.pentest' },
      { value: 'compliance', key: 'contact.form.service.compliance' },
      { value: 'incidentResponse', key: 'contact.form.service.incidentResponse' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.advisory',
    services: [
      { value: 'techStrategy', key: 'contact.form.service.techStrategy' },
      { value: 'architectureReview', key: 'contact.form.service.architectureReview' },
      { value: 'codeAudit', key: 'contact.form.service.codeAudit' },
    ],
  },
  {
    categoryKey: 'contact.form.svcCat.teams',
    services: [
      { value: 'qa', key: 'contact.form.service.qa' },
      { value: 'integration', key: 'contact.form.service.integration' },
      { value: 'staffAugmentation', key: 'contact.form.service.staffAugmentation' },
      { value: 'iot', key: 'contact.form.service.iot' },
      { value: 'dataScience', key: 'contact.form.service.dataScience' },
      { value: 'support', key: 'contact.form.service.support' },
    ],
  },
];
---

<Layout title={t("meta.contactTitle")} description={t("meta.contactDesc")}
  structuredData={{
    "@type": "ContactPage",
    name: "Contact Tria Software Solutions",
    description: t("meta.contactDesc"),
    mainEntity: {
      "@type": "Organization",
      name: "Tria Software Solutions",
      email: "hola@triacr.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Atenas",
        addressRegion: "Alajuela",
        addressCountry: "CR",
      },
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "sales",
          email: "sales@triacr.com",
        },
        {
          "@type": "ContactPoint",
          contactType: "support",
          email: "support@triacr.com",
        },
      ],
    },
  }}>

  <PageBanner headingKey="contact.letsBuild" descriptionKey="contact.heroSub" crumbKey="nav.contact" />

  <!-- contact form - white, frameless -->
  <section id="contact-form" class="tria-cf-section" data-section-theme="light" style="position:relative;">
    <div class="tria-ambient-temp">
      <div class="tria-at-glow-1"></div>
      <div class="tria-at-glow-3"></div>
    </div>
    <div class="container tria-p-120-120">
      <div class="row tria-cf-main-row">
        <div class="col-lg-8">
          <form class="tria-cf-form tria-up" id="triaContactForm">
            <div class="tria-cf-row">
              <div class="tria-cf-group">
                <label class="tria-cf-label" for="cf-name"><span data-i18n="contact.form.label.name">{t("contact.form.label.name")}</span><span class="tria-cf-req" aria-hidden="true">*</span></label>
                <input class="tria-cf-input" type="text" id="cf-name" name="name" data-i18n-placeholder="contact.form.placeholder.name" placeholder={t("contact.form.placeholder.name")} required />
                <span class="tria-cf-error" id="cf-name-error" role="alert"></span>
              </div>
              <div class="tria-cf-group">
                <label class="tria-cf-label" for="cf-email"><span data-i18n="contact.form.label.email">{t("contact.form.label.email")}</span><span class="tria-cf-req" aria-hidden="true">*</span></label>
                <input class="tria-cf-input" type="email" id="cf-email" name="email" data-i18n-placeholder="contact.form.placeholder.email" placeholder={t("contact.form.placeholder.email")} required />
                <span class="tria-cf-error" id="cf-email-error" role="alert"></span>
              </div>
            </div>

            <div class="tria-cf-row">
              <div class="tria-cf-group">
                <label class="tria-cf-label" for="cf-company"><span data-i18n="contact.form.label.company">{t("contact.form.label.company")}</span> <span class="tria-cf-opt" data-i18n="contact.form.optional">({t("contact.form.optional")})</span></label>
                <input class="tria-cf-input" type="text" id="cf-company" name="company" data-i18n-placeholder="contact.form.placeholder.company" placeholder={t("contact.form.placeholder.company")} />
              </div>
              <div class="tria-cf-group">
                <label class="tria-cf-label"><span data-i18n="contact.form.label.budget">{t("contact.form.label.budget")}</span><span class="tria-cf-req" aria-hidden="true">*</span></label>
                <!-- Custom Dropdown -->
                <div class="tria-dd" id="cf-budget-dd">
                  <button class="tria-dd-trigger" type="button" aria-required="true">
                    <span class="tria-dd-label" data-i18n="contact.form.placeholder.budget">{t("contact.form.placeholder.budget")}</span>
                    <svg class="tria-dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <div class="tria-dd-menu">
                    <div class="tria-dd-option" data-value="$500 – $1,000" role="option">
                      <div class="tria-dd-opt-main">
                        <span class="tria-dd-opt-label" data-i18n="contact.form.option.range1">{t("contact.form.option.range1")}</span>
                        <span class="tria-dd-opt-check">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                    <div class="tria-dd-option" data-value="$1,000 – $5,000" role="option">
                      <div class="tria-dd-opt-main">
                        <span class="tria-dd-opt-label" data-i18n="contact.form.option.range2">{t("contact.form.option.range2")}</span>
                        <span class="tria-dd-opt-check">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                    <div class="tria-dd-option" data-value="$5,000 – $10,000" role="option">
                      <div class="tria-dd-opt-main">
                        <span class="tria-dd-opt-label" data-i18n="contact.form.option.range3">{t("contact.form.option.range3")}</span>
                        <span class="tria-dd-opt-check">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                    <div class="tria-dd-option" data-value="$10,000 – $25,000" role="option">
                      <div class="tria-dd-opt-main">
                        <span class="tria-dd-opt-label" data-i18n="contact.form.option.range4">{t("contact.form.option.range4")}</span>
                        <span class="tria-dd-opt-check">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                    <div class="tria-dd-option" data-value="$25,000+" role="option">
                      <div class="tria-dd-opt-main">
                        <span class="tria-dd-opt-label" data-i18n="contact.form.option.range5">{t("contact.form.option.range5")}</span>
                        <span class="tria-dd-opt-check">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
                <input type="hidden" id="cf-budget" name="budget" value="" />
                <span class="tria-cf-error" id="cf-budget-error" role="alert"></span>
              </div>
            </div>

        <div class="tria-cf-group">
          <label class="tria-cf-label"><span data-i18n="contact.form.label.services">{t("contact.form.label.services")}</span><span class="tria-cf-req" aria-hidden="true">*</span></label>
          <!-- Multi-select grouped dropdown for services -->
          <div class="tria-svdd" id="cf-services-dd">
            <button class="tria-svdd-trigger" type="button" aria-required="true">
              <span class="tria-svdd-label" data-i18n="contact.form.servicesPlaceholder">{t("contact.form.servicesPlaceholder")}</span>
              <span class="tria-svdd-count" style="display:none;"></span>
              <svg class="tria-svdd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="tria-svdd-menu">
              {serviceGroups.map((group) => (
                <>
                  <div class="tria-svdd-group-label" data-i18n={group.categoryKey}>{t(group.categoryKey)}</div>
                  {group.services.map((svc) => (
                    <div class="tria-svdd-option" data-value={svc.value} role="option">
                      <div class="tria-svdd-opt-main">
                        <span class="tria-svdd-opt-label" data-i18n={svc.key}>{t(svc.key)}</span>
                        <span class="tria-svdd-opt-check">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                      </div>
                    </div>
                  ))}
                </>
              ))}
            </div>
          </div>
          <input type="hidden" id="cf-services" name="services" value="" />
          <span class="tria-cf-error" id="cf-services-error" role="alert"></span>
        </div>

        <div class="tria-cf-group">
          <label class="tria-cf-label" for="cf-message"><span data-i18n="contact.form.label.message">{t("contact.form.label.message")}</span><span class="tria-cf-req" aria-hidden="true">*</span></label>
          <textarea class="tria-cf-input tria-cf-textarea" id="cf-message" name="message" data-i18n-placeholder="contact.form.placeholder.message" placeholder={t("contact.form.placeholder.message")} rows="10" required></textarea>
          <span class="tria-cf-error" id="cf-message-error" role="alert"></span>
        </div>

        <div class="tria-cf-server-error" id="cf-server-error">
          <h4 data-i18n="contact.form.error.title">{t("contact.form.error.title")}</h4>
          <p data-i18n="contact.form.error.text">{t("contact.form.error.text")}</p>
        </div>

        <Button text={t("contact.form.submit")} showArrow={true} arrowStyle="inline" size="sm" fullWidth={true} id="cf-submit-btn" type="submit" />

        <p class="tria-cf-note" data-i18n="contact.form.note">{t("contact.form.note")}</p>
      </form>
          </div> <!-- /col-lg-8 -->
          <div class="col-lg-4">
            <aside class="tria-cf-sidebar">
              <div class="tria-cfs-card">
                <div class="tria-cfs-card-head">
                  <div class="tria-cfs-card-icon">
                    <i class="ti ti-message-2"></i>
                  </div>
                  <h4 class="tria-cfs-card-title" data-i18n="contact.sidebar.direct">{t("contact.sidebar.direct")}</h4>
                </div>
                <div class="tria-cfs-link-list">
                  <a class="tria-cfs-link" data-mailto="hola@triacr.com" tabindex="0">
                    <i class="ti ti-mail"></i>
                    {t("footer.contactLink")}
                  </a>
                  <a class="tria-cfs-link" data-mailto="support@triacr.com" tabindex="0">
                    <i class="ti ti-headset"></i>
                    {t("footer.supportLink")}
                  </a>
                  <a class="tria-cfs-link" data-mailto="sales@triacr.com" tabindex="0">
                    <i class="ti ti-briefcase"></i>
                    {t("footer.salesLink")}
                  </a>
                  <a href="https://wa.me/50662164040" class="tria-cfs-link" target="_blank" rel="noopener noreferrer">
                    <i class="ti ti-brand-whatsapp"></i>
                    {t("contact.sidebar.whatsapp")}
                  </a>
                </div>
              </div>
              <div class="tria-cfs-card">
                <div class="tria-cfs-card-head">
                  <div class="tria-cfs-card-icon">
                    <i class="ti ti-clock"></i>
                  </div>
                  <h4 class="tria-cfs-card-title" data-i18n="contact.sidebar.response">{t("contact.sidebar.response")}</h4>
                </div>
                <p class="tria-cfs-card-desc" data-i18n="contact.sidebar.responseDesc">{t("contact.sidebar.responseDesc")}</p>
              </div>
              <!-- Budget estimator → interactive quote -->
              <div class="tria-cfs-card tria-cfs-card--quote">
                <div class="tria-cfs-card-head">
                  <div class="tria-cfs-card-icon">
                    <i class="ti ti-calculator"></i>
                  </div>
                  <h4 class="tria-cfs-card-title" data-i18n="contact.sidebar.quoteTitle">{t("contact.sidebar.quoteTitle")}</h4>
                </div>
                <p class="tria-cfs-card-desc" data-i18n="contact.sidebar.quoteDesc">{t("contact.sidebar.quoteDesc")}</p>
                <div class="tria-cfs-card-cta">
                  <a class="tria-cfs-card-link" href={quotePath}>
                    <span data-i18n="pricing.estimatorCta">{t("pricing.estimatorCta")}</span>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              </div>
              <!-- Location -->
              <div class="tria-cfs-card">
                <div class="tria-cfs-card-head">
                  <div class="tria-cfs-card-icon">
                    <i class="ti ti-map-pin"></i>
                  </div>
                  <h4 class="tria-cfs-card-title" data-i18n="contact.info.location">{t("contact.info.location")}</h4>
                </div>
                <p class="tria-cfs-card-desc" set:html={t("contact.info.locationValue")} />
              </div>
            </aside>
          </div> <!-- /col-lg-5 -->
        </div> <!-- /row tria-cf-main-row -->

      <div class="tria-cf-success" id="triaFormSuccess" style="display:none;">
        <div class="tria-cfs-icon"><i class="ti ti-check"></i></div>
        <h4 data-i18n="contact.form.success.title">{t("contact.form.success.title")}</h4>
        <p data-i18n="contact.form.success.text">{t("contact.form.success.text")}</p>
      </div>
    </div>
  </section>





  <SiteFooter />
</Layout>

<style>
  /* ═══════════════════════════════════════
     FORM SECTION — White, frameless
     ═══════════════════════════════════════ */
  .tria-cf-section {
    background: #fff;
    position: relative;
    overflow: hidden;
  }

  /* Dot grid pattern — matches quote wizard look & feel */
  .tria-cf-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.04) 1px, transparent 0);
    background-size: 36px 36px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 15% 0%, black 18%, transparent 62%);
    -webkit-mask-image: radial-gradient(ellipse at 15% 0%, black 18%, transparent 62%);
  }

  .tria-cf-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .tria-cf-main-row {
    position: relative;
  }

  .tria-cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .tria-cf-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tria-cf-label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.45);
    font-weight: 600;
  }

  .tria-cf-req {
    color: #e74c3c;
    font-weight: 700;
    margin-left: 4px;
  }

  .tria-cf-opt {
    color: rgba(0,0,0,0.35);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .tria-cf-input {
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 12px;
    height: 50px;
    padding: 0 16px;
    font-size: 0.9rem;
    font-weight: 400;
    color: #0b0d17;
    background: #ffffff;
    font-family: var(--font-display, 'Outfit', sans-serif);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    outline: none;
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    letter-spacing: 0.01em;
  }
  .tria-cf-input::placeholder {
    color: rgba(0,0,0,0.28);
    font-weight: 380;
  }
  .tria-cf-input::placeholder {
    text-transform: none;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }
  .tria-cf-input::-webkit-input-placeholder {
    text-transform: none;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }
  .tria-cf-input::-moz-placeholder {
    text-transform: none;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }
  .tria-cf-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(6,142,140,0.12);
    background: #fff;
  }
  .tria-cf-input:not(:placeholder-shown) {
    background: #fff;
  }

  .tria-cf-textarea {
    resize: vertical;
    height: auto;
    min-height: 120px;
    line-height: 1.65;
    padding: 14px 16px !important;
    border-radius: 12px !important;
  }

  /* ═══════════════════════════════════════
     CUSTOM DROPDOWN — replaces native select
     ═══════════════════════════════════════ */
  .tria-dd {
    position: relative;
    width: 100%;
  }
  .tria-dd-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 50px;
    padding: 0 16px;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 12px;
    background: #ffffff;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 0.9rem;
    font-weight: 400;
    color: rgba(0,0,0,0.28);
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    text-align: left;
  }
  .tria-dd-trigger:hover {
    border-color: rgba(0,0,0,0.14);
  }
  .tria-dd--open .tria-dd-trigger,
  .tria-dd-trigger:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(6,142,140,0.12);
    background: #fff;
  }
  .tria-dd-chevron {
    flex-shrink: 0;
    color: rgba(0,0,0,0.2);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.3s ease;
  }
  .tria-dd--open .tria-dd-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .tria-dd-label {
    transition: color 0.3s ease;
  }
  .tria-dd-label--filled {
    color: #0b0d17;
    font-weight: 420;
  }

  /* ── Dropdown menu ── */
  .tria-dd-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 50;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 16px;
    padding: 6px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0s 0.3s;
  }
  .tria-dd--open .tria-dd-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tria-dd-option {
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .tria-dd-option:hover {
    background: #f5f7f9;
  }
  .tria-dd-option--selected {
    background: rgba(6,142,140,0.06);
  }
  .tria-dd-option--selected:hover {
