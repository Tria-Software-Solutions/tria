<script is:inline>
  (function () {
    var SENDING_TEXT = "{sendingText}";
    var TURNSTILE_SITE_KEY = "{turnstileSiteKey}";
    var VAL_REQUIRED = "{valRequired}";
    var VAL_EMAIL = "{valEmail}";
    var VAL_BUDGET = "{valBudget}";
    var VAL_SERVICES = "{valServices}";
    var VAL_MESSAGE = "{valMessage}";
    var SUBMIT_TEXT = "{submitText}";

    /* ── Load Cloudflare Turnstile ── */
    function loadTurnstile() {
      if (typeof turnstile !== 'undefined') return;
      var script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    /* ── Get Turnstile token ── */
    function getTurnstileToken() {
      return new Promise(function (resolve) {
        if (typeof turnstile === 'undefined' || !turnstile.execute) {
          resolve('');
          return;
        }
        var container = document.getElementById('cf-turnstile-container');
        if (!container) {
          container = document.createElement('div');
          container.id = 'cf-turnstile-container';
          container.style.display = 'none';
          document.getElementById('triaContactForm').appendChild(container);
        }
        turnstile.render(container, {
          sitekey: TURNSTILE_SITE_KEY,
          callback: function (token) {
            resolve(token);
          },
          'error-callback': function () {
            resolve('');
          },
          'expired-callback': function () {
            resolve('');
          },
        });
      });
    }

    /* ── Custom Dropdown ── */
    function initDropdown() {
      var dd = document.getElementById('cf-budget-dd');
      if (!dd) return;

      var trigger = dd.querySelector('.tria-dd-trigger');
      var menu = dd.querySelector('.tria-dd-menu');
      var options = dd.querySelectorAll('.tria-dd-option');
      var hiddenInput = document.getElementById('cf-budget');
      var label = dd.querySelector('.tria-dd-label');

      function closeAll() {
        document.querySelectorAll('.tria-dd--open').forEach(function (d) {
          d.classList.remove('tria-dd--open');
        });
      }

      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = dd.classList.contains('tria-dd--open');
        closeAll();
        if (!isOpen) {
          dd.classList.add('tria-dd--open');
        }
      });

      options.forEach(function (opt) {
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          var value = opt.getAttribute('data-value');
          var optLabel = opt.querySelector('.tria-dd-opt-label').textContent;
          hiddenInput.value = value;
          label.textContent = optLabel;
          label.classList.add('tria-dd-label--filled');
          dd.classList.remove('tria-dd--open');

          options.forEach(function (o) { o.classList.remove('tria-dd-option--selected'); });
          opt.classList.add('tria-dd-option--selected');
        });
      });

      document.addEventListener('click', closeAll);
    }

    /* ── Multi-select Services Dropdown ── */
    function initServicesDropdown() {
      var dd = document.getElementById('cf-services-dd');
      if (!dd) return;

      var trigger = dd.querySelector('.tria-svdd-trigger');
      var menu = dd.querySelector('.tria-svdd-menu');
      var options = dd.querySelectorAll('.tria-svdd-option');
      var hiddenInput = document.getElementById('cf-services');
      var label = dd.querySelector('.tria-svdd-label');
      var countEl = dd.querySelector('.tria-svdd-count');
      var selected = new Set();

      function updateLabel() {
        var count = selected.size;
        if (count === 0) {
          label.style.display = '';
          countEl.textContent = '';
        } else {
          label.style.display = 'none';
          countEl.textContent = count + ' selected';
          countEl.style.display = '';
        }
        hiddenInput.value = Array.from(selected).join(',');
      }

      function closeAll() {
        document.querySelectorAll('.tria-svdd--open').forEach(function (d) {
          d.classList.remove('tria-svdd--open');
        });
      }

      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = dd.classList.contains('tria-svdd--open');
        closeAll();
        if (!isOpen) {
          dd.classList.add('tria-svdd--open');
        }
      });

      options.forEach(function (opt) {
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          var value = opt.getAttribute('data-value');
          if (selected.has(value)) {
            selected.delete(value);
            opt.classList.remove('tria-svdd-option--selected');
          } else {
            selected.add(value);
            opt.classList.add('tria-svdd-option--selected');
          }
          updateLabel();
        });
      });

      document.addEventListener('click', closeAll);
    }

    /* ═══════════════════════════════════════
       VALIDATION HELPERS
       ═══════════════════════════════════════ */

    function clearFieldError(el) {
      el.classList.remove('tria-cf-input--error');
      var dd = el.closest('.tria-dd');
      if (dd) dd.classList.remove('tria-dd--error');
      var svdd = el.closest('.tria-svdd');
      if (svdd) svdd.classList.remove('tria-svdd--error');
      var errorEl = document.getElementById(el.id + '-error');
      if (errorEl) {
        errorEl.classList.remove('tria-cf-error--visible');
        errorEl.textContent = '';
      }
    }

    function showFieldError(el, message) {
      el.classList.add('tria-cf-input--error');
      var dd = el.closest('.tria-dd');
      if (dd) dd.classList.add('tria-dd--error');
      var svdd = el.closest('.tria-svdd');
      if (svdd) svdd.classList.add('tria-svdd--error');
      var errorEl = document.getElementById(el.id + '-error');
      if (errorEl) {
        errorEl.textContent = message;
        // Force reflow to restart animation
        void errorEl.offsetWidth;
        errorEl.classList.add('tria-cf-error--visible');
      }
    }

    function validateField(el) {
      clearFieldError(el);

      if (el.hasAttribute('required') && !el.value.trim()) {
        showFieldError(el, VAL_REQUIRED);
        return false;
      }

      if (el.type === 'email' && el.value.trim()) {
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(el.value.trim())) {
          showFieldError(el, VAL_EMAIL);
          return false;
        }
      }

      if (el.id === 'cf-message' && el.value.trim()) {
        if (el.value.trim().length < 20) {
          showFieldError(el, VAL_MESSAGE);
          return false;
        }
      }

      return true;
    }

    function validateAllFields() {
      var valid = true;
      var fields = [
        document.getElementById('cf-name'),
        document.getElementById('cf-email'),
        document.getElementById('cf-budget'),
        document.getElementById('cf-services'),
        document.getElementById('cf-message'),
      ];

      fields.forEach(function (el) {
        if (!el) return;
        if (!validateField(el)) {
          valid = false;
        }
      });

      return valid;
    }

    function getServices() {
      var input = document.getElementById('cf-services');
      if (!input || !input.value) return [];
      return input.value.split(',').filter(Boolean);
    }

    function initForm() {
      var form = document.getElementById('triaContactForm');
      var success = document.getElementById('triaFormSuccess');
      var serverError = document.getElementById('cf-server-error');
      if (!form) return;

      /* ── Real-time validation on blur and input ── */
      var validateFields = ['cf-name', 'cf-email', 'cf-message'];
      validateFields.forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('blur', function () {
          validateField(el);
        });
        el.addEventListener('input', function () {
          if (el.classList.contains('tria-cf-input--error')) {
            validateField(el);
          }
        });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        // Clear server error
        if (serverError) serverError.classList.remove('tria-cf-server-error--visible');

        // Validate all fields
        if (!validateAllFields()) {
          // Shake form
          form.classList.remove('tria-cf-form--shake');
          void form.offsetWidth;
          form.classList.add('tria-cf-form--shake');
          // Focus first error field
          var firstError = form.querySelector('.tria-cf-input--error');
          if (firstError) firstError.focus({ preventScroll: true });
          return;
        }

        var btn = document.getElementById('cf-submit-btn');
        if (btn) {
          btn.disabled = true;
          var btnSpan = btn.querySelector('span');
          if (btnSpan) btnSpan.textContent = SENDING_TEXT;
        }

        getTurnstileToken().then(function (turnstileToken) {
          var data = {
            source: 'contact',
            name: document.getElementById('cf-name').value,
            email: document.getElementById('cf-email').value,
            company: document.getElementById('cf-company').value,
            budget: document.getElementById('cf-budget').value,
            services: getServices(),
            message: document.getElementById('cf-message').value,
            turnstileToken: turnstileToken,
          };

          fetch('/api/create-jira-ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          })
          .then(function (res) { return res.json(); })
          .then(function (result) {
            if (result.success) {
              form.style.display = 'none';
              if (success) success.style.display = 'block';
            } else {
              throw new Error(result.error || 'Unknown error');
            }
          })
          .catch(function (err) {
            console.error('Jira ticket creation failed:', err);
            // Show server error feedback so the user knows what happened
            if (serverError) {
              serverError.classList.add('tria-cf-server-error--visible');
            }
            // Re-enable the button
            if (btn) {
              btn.disabled = false;
              var btnSpan = btn.querySelector('span');
              if (btnSpan) btnSpan.textContent = SUBMIT_TEXT;
            }
          });
        });
      });
    }

    function init() {
      loadTurnstile();
      initDropdown();
      initServicesDropdown();
      initForm();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('swup:contentReplaced', init);
  })();
</script>
