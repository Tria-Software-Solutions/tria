# ── Jira Cloud integration ──
# Required for the contact form → ticket creation
JIRA_EMAIL=luis.herrera506@gmail.com
JIRA_TOKEN=your_jira_api_token_here

# Jira project key where contact form tickets will be created
# (change to any of your Jira project keys: TRI, SUP, etc.)
JIRA_PROJECT_KEY=TRI

# ── Slack notifications (optional) ──
# Set this to receive a message in your Slack channel when a new lead comes in
# Create a webhook: https://api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# ── Email notifications (optional) ──
# Send email notifications when a new lead comes in
# Get a free API key at https://resend.com
# IMPORTANT: to send to any address (e.g. sales@triacr.com) you must verify the
# triacr.com domain in Resend — the free tier only delivers to the account owner's
# email otherwise, and failures are silent.
RESEND_API_KEY=

# Email address to receive lead notifications (requires RESEND_API_KEY + verified domain)
# Recommended: sales@triacr.com — quotes & estimates are sales leads
NOTIFICATION_EMAIL=sales@triacr.com

# From address for notification emails (must be a verified domain in Resend)
# e.g. EMAIL_FROM="Tria <hola@triacr.com>"
EMAIL_FROM=

# ── Confluence upload (scripts/upload-confluence.mjs) ──
# Upload the corporate docs in docs/confluence/ to Confluence Cloud.
# Get an API token at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_SITE=triacr
CONFLUENCE_EMAIL=you@triacr.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=TRIA
